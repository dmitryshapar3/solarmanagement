        "defaultValue": "https://eu-apia.coolkit.cc"
      },
      {
        "key": "appId",
        "kind": "secret",
        "label": "eWeLink application ID",
        "required": true,
        "secret": true
      },
      {
        "key": "accessToken",
        "kind": "secret",
        "label": "Authorized user access token",
        "required": true,
        "secret": true
      }
    ],
    "actions": [
      "test",
      "discover"
    ],
    "uiLayout": {
      "version": 1,
      "steps": [
        {
          "id": "socket",
          "title": "Connection settings",
          "instructions": "Enter credentials for your own approved eWeLink developer application and an existing authorized user token. Use the account regional cloud origin. The supported inventory bound is 30 account items. User Profile API access is required to verify the same account when the token is renewed.",
          "groups": [
            {
              "id": "credentials",
              "title": "Cloud account",
              "instructions": "Enter credentials for your own approved eWeLink developer application and an existing authorized user token. Use the account regional cloud origin. The supported inventory bound is 30 account items. User Profile API access is required to verify the same account when the token is renewed.",
              "fieldKeys": [
                "endpoint",
                "appId",
                "accessToken"
              ],
              "actions": [
                "test",
                "discover"
              ]
            }
          ]
        }
      ]
