    "uiContractVersion": 1,
    "configurationVersion": 1,
    "requiredUiFeatures": [
      "text",
      "secret",
      "wizard",
      "groups",
      "instructions",
      "device-selector"
    ],
    "fields": [
      {
        "key": "endpoint",
        "kind": "text",
        "label": "Account region API origin",
