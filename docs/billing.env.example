# Operator configuration only. Never import this section into editable SQL settings.
# Purchasing must stay disabled until real Apple sandbox verification is complete.
Billing__Apple__Enabled=false
Billing__Apple__BundleId=com.dshapar.solar
Billing__Apple__Environment=Sandbox
# The numeric App Store app ID is mandatory in Production; Sandbox may omit/return zero.
Billing__Apple__AppAppleId=
Billing__Apple__IssuerId=
Billing__Apple__KeyId=
# Use absolute paths on the server. Mount the key read-only outside static application content.
Billing__Apple__PrivateKeyPath=/var/lib/solar/apple/SubscriptionKey_CHANGE_ME.p8
Billing__Apple__RootCertificatePaths__0=/var/lib/solar/apple/AppleRootCA-G3.cer
Billing__Apple__ProductIds__0=com.dshapar.solar.monthly
Billing__Apple__ProductIds__1=com.dshapar.solar.yearly
