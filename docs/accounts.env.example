# Production backend only. Copy to /opt/projects/secrets/deye-solar-accounts.env.
# Keep the completed file outside Git, owned by the deployment administrator (0600).
# Existing Compose environment entries take precedence over this file.
# Registration stays closed until provider and migration verification is complete.
Auth__RegistrationEnabled=false
Auth__PublicBaseUrl=https://solar.dshapar.com

# Reuse the existing projects_deye-dataprotection volume and mount.
Auth__DataProtectionKeysPath=/root/.aspnet/DataProtection-Keys

# Also change the existing Compose environment entry from true to false.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false
# Fill only after verifying the actual proxy IP(s); separate multiple IPs with commas.
# Empty means the proxy peer shares a rate-limit bucket, with automatic forwarding off.
Auth__TrustedProxyAddresses=

# Resend: verified sending domain, sending-access key scoped to that domain.
# From must use an actual address on the verified domain; quote values when needed.
Auth__Email__ResendApiKey=
Auth__Email__From=

# Google Web application OAuth client.
# Authorized redirect URI: https://solar.dshapar.com/signin-google
Auth__Google__ClientId=
Auth__Google__ClientSecret=
# Optional Google-only signup override; omitted inherits Auth__RegistrationEnabled.
# Auth__Google__RegistrationEnabled=true

# SMS is intentionally disabled for this deployment. Keep all three values empty.
Auth__Phone__AccountSid=
Auth__Phone__AuthToken=
Auth__Phone__VerifyServiceSid=
