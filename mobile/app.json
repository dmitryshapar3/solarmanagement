{
  "expo": {
    "name": "SmartSolar",
    "slug": "deye-solar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dshapar.solar",
      "buildNumber": "13",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "ru",
          "uk",
          "pl",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "nl",
          "cs",
          "tr",
          "zh",
          "ja",
          "ko"
        ],
        "NSFaceIDUsageDescription": "Allow SmartSolar to use Face ID for secure sign-in.",
        "NSLocationWhenInUseUsageDescription": "Use your location to set the solar site coordinates.",
        "NSMotionUsageDescription": "SmartSolar does not use motion or fitness data. Location access is only used to set your solar site coordinates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12120F"
      }
    },
    "extra": {
      "apiBaseUrl": "https://solar.dshapar.com"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow SmartSolar to use Face ID for secure sign-in."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Onest-Regular.ttf",
            "./assets/fonts/Onest-Medium.ttf",
            "./assets/fonts/Onest-SemiBold.ttf",
            "./assets/fonts/Onest-Bold.ttf",
            "./assets/fonts/Unbounded-Bold.ttf"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to set the solar site coordinates.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "SmartSolar does not use motion or fitness data. Location access is only used to set your solar site coordinates."
        }
      ],
      "react-native-bottom-tabs",
      "expo-sharing",
      "./plugins/withSmartSolarNative.cjs"
    ],
    "scheme": "deyesolar",
    "icon": "./assets/icon.png"
  }
}
