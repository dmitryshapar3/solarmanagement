{
  "expo": {
    "name": "DeyeSolar",
    "slug": "deye-solar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dshapar.solar",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "ru",
          "uk",
          "pl",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "nl",
          "cs",
          "tr",
          "zh",
          "ja",
          "ko"
        ],
        "NSFaceIDUsageDescription": "Allow DeyeSolar to use Face ID for secure sign-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101412"
      }
    },
    "extra": {
      "apiBaseUrl": "https://solar.dshapar.com"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow DeyeSolar to use Face ID for secure sign-in."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "deyesolar",
    "icon": "./assets/icon.png"
  }
}
