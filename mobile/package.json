  "devDependencies": {
    "@types/react": "19.2.17",
    "babel-preset-expo": "~57.0.0",
    "esbuild": "0.28.2",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "query-string": "9.5.1",
