<label class="ui-switch @(Busy ? "sending" : null)" title="@Label"><input type="checkbox" role="switch" checked="@Value" disabled="@(Disabled || Busy)" aria-label="@Label" aria-checked="@Value.ToString().ToLowerInvariant()" @onchange="Changed" /><span class="switch-track" aria-hidden="true"></span></label>
@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "";
    private Task Changed(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value is true);
}
