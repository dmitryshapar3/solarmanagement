<UiCard Title="@T["Where the energy goes"]"><svg class="energy-flow" viewBox="0 0 500 300" role="img" aria-label="@T["Solar, home, battery and grid energy flows"]">
<path class="flow-line @(Data.SolarKw>0?"moving":"unknown")" d="M250 64V122"/><path class="flow-line @(Data.GridKw is {} g&&g!=0?g>0?"moving":"moving reverse":"unknown")" d="M97 160H202"/><path class="flow-line @(Data.BatteryKw is {} b&&b!=0?b>0?"moving reverse":"moving":"unknown")" d="M298 160H403"/><path class="flow-line @(Data.LoadKw>0?"moving":"unknown")" d="M250 198V246"/>
<rect class="flow-home" x="205" y="122" width="90" height="76" rx="20"/><g><text x="250" y="152" text-anchor="middle">@T["Home"]</text><text x="250" y="179" text-anchor="middle" class="flow-power">@UiFormat.Number(Data.LoadKw) kW</text></g>
<circle class="flow-node" cx="250" cy="36" r="30"/><g><text x="250" y="42" text-anchor="middle">☀</text><text x="250" y="86" text-anchor="middle">@T["Solar"] · @UiFormat.Number(Data.SolarKw) kW</text></g>
<circle class="flow-node" cx="67" cy="160" r="30"/><g><text x="67" y="166" text-anchor="middle">↔</text><text x="67" y="212" text-anchor="middle">@T["Grid"]</text><text x="67" y="233" text-anchor="middle">@UiFormat.Number(Data.GridKw) kW</text></g>
<circle class="flow-node" cx="433" cy="160" r="30"/><g><text x="433" y="166" text-anchor="middle">@UiFormat.Number(Data.BatterySoc,"0")%</text><text x="433" y="212" text-anchor="middle">@T["Battery"]</text><text x="433" y="233" text-anchor="middle">@UiFormat.Number(Data.BatteryKw) kW</text></g>
<g><text x="250" y="269" text-anchor="middle">@T["Load"]</text></g></svg>
@if(Data.BatterySoc is {} soc){<div class="flow-rule-gauge"><div class="flow-rule-track" role="meter" aria-label="@T["Battery charge"]" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@soc"><span class="flow-rule-charge" style="width:@ChartGeometry.Number(Math.Clamp(soc,0,100))%"></span>@foreach(var marker in Markers){<span class="flow-rule-marker" style="left:@marker.On%" title="@(marker.Name+" · "+T["Switch on at"]+" "+UiFormat.Number(marker.On)+"%")"></span><span class="flow-rule-marker off" style="left:@marker.Off%" title="@(marker.Name+" · "+T["Switch off at"]+" "+UiFormat.Number(marker.Off)+"%")"></span>}</div>@foreach(var marker in Markers){<a class="caption flow-rule-label" href="@($"/automations/{marker.Id}")"><strong>@marker.Name</strong> · @T.Format("On at {0}% · off at {1}%",marker.On,marker.Off)</a>}</div>}
<dl class="flow-values"><div><dt>@T["Solar generation"]</dt><dd>@UiFormat.Number(Data.SolarKw) kW</dd></div><div><dt>@T["Home load"]</dt><dd>@UiFormat.Number(Data.LoadKw) kW</dd></div><div><dt>@(Data.GridKw is null?T["Grid state unknown"]:Data.GridKw<0?T["Exporting"]:Data.GridKw>0?T["Importing"]:T["Grid idle"])</dt><dd>@UiFormat.Number(Data.GridKw) kW</dd></div><div><dt>@(Data.BatteryKw is null?T["Battery state unknown"]:Data.BatteryKw<0?T["Charging"]:Data.BatteryKw>0?T["Discharging"]:T["Battery idle"])</dt><dd>@UiFormat.Number(Data.BatteryKw) kW</dd></div></dl><p class="caption">@T["Signs come from the inverter. Arrows are shown only for known, nonzero flows; measurements may have different times."]</p>
<a class="text-link" href="/activity/readings">@T["Live readings"] →</a></UiCard>
@code{[Parameter,EditorRequired]public LiveReading Data{get;set;}=default!;[Parameter]public IReadOnlyList<TriggerRule> Rules{get;set;}=[];private IReadOnlyList<EnergyFlowThreshold> Markers=>EnergyFlowPresentation.Thresholds(Rules);}
