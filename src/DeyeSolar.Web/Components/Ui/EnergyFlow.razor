<UiCard Title="@T["Where the energy goes"]">
    <svg class="energy-flow" viewBox="0 0 360 330" role="img" aria-label="@T["Solar, home, battery and grid energy flows"]">
        @foreach (var connection in EnergyFlowPresentation.Connections(Data))
        {
            <g class="flow-route @connection.Key" data-flow="@connection.Key" data-direction="@connection.Direction" transform="@connection.Transform" aria-hidden="true">
                <path class="flow-line @connection.State" d="@($"M0 0H{connection.Length}")" />
                @if (connection.Active)
                {
                    <g class="flow-arrows" transform="@(connection.Reverse ? $"translate({connection.Length} 0) rotate(180)" : null)" style="@($"--flow-distance:{connection.Length}px")">
                        <g class="flow-current"><path class="flow-chevron" d="M-4 -4L0 0L-4 4" /></g>
                        <g class="flow-current delayed"><path class="flow-chevron" d="M-4 -4L0 0L-4 4" /></g>
                    </g>
                }
            </g>
        }
        <circle class="flow-junction" cx="180" cy="148" r="9" />
        <circle class="flow-junction-dot" cx="180" cy="148" r="3" />

        <g data-flow-node="solar" text-anchor="middle">
            <text class="flow-label" x="180" y="16">@T["Solar"]</text>
            <text class="flow-power" x="180" y="36">@Power(SolarPower)</text>
            <circle class="flow-node solar" cx="180" cy="66" r="25" />
            <g class="flow-icon solar" transform="translate(168 54)"><circle cx="12" cy="12" r="4" /><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></g>
        </g>
        <g data-flow-node="battery" text-anchor="middle">
            <circle class="flow-node battery" cx="65" cy="148" r="25" />
            <g class="flow-icon battery" transform="translate(53 136)"><rect x="2" y="5" width="18" height="14" rx="3" /><path d="M23 9v6M6 9v6m4-6v6m4-6v6" /></g>
            <text class="flow-label" x="65" y="195">@T["Battery"]</text>
            <text class="flow-power" x="65" y="219">@Power(BatteryPower)</text>
            <text class="flow-soc" x="65" y="240">@T.Number(Data.BatterySoc, "0")%</text>
        </g>
        <g data-flow-node="grid" text-anchor="middle">
            <circle class="flow-node grid" cx="295" cy="148" r="25" />
            <g class="flow-icon grid" transform="translate(283 136)"><path d="M8 2h8l4 20M8 2 4 22M6 12h12M5 17h14M7 7h10" /></g>
            <text class="flow-label" x="295" y="195">@T["Grid"]</text>
            <text class="flow-power" x="295" y="219">@Power(GridPower)</text>
        </g>
        <g data-flow-node="load" text-anchor="middle">
            <circle class="flow-node load" cx="180" cy="249" r="25" />
            <g class="flow-icon load" transform="translate(168 237)"><path d="m3 10 9-7 9 7v10H3zM9 20v-7h6v7" /></g>
            <text class="flow-label" x="180" y="296">@T["Load"]</text>
            <text class="flow-power" x="180" y="320">@Power(LoadPower)</text>
        </g>
    </svg>
    @if (Markers.Count > 0)
    {
        <div class="flow-rule-links">
            @foreach (var marker in Markers)
            {
                <a class="caption flow-rule-label" href="@($"/automations/{marker.Id}")"><strong>@marker.Name</strong> · @T.Format("On at {0}% · off at {1}%", marker.On, marker.Off)</a>
            }
        </div>
    }
    <dl class="flow-values">
        <div><dt>@T["Solar generation"]</dt><dd>@T.Number(SolarPower) kW</dd></div>
        <div><dt>@T["Home load"]</dt><dd>@T.Number(LoadPower) kW</dd></div>
        <div><dt>@(GridPower is null ? T["Grid state unknown"] : GridPower < 0 ? T["Exporting"] : GridPower > 0 ? T["Importing"] : T["Grid idle"])</dt><dd>@T.Number(GridPower) kW</dd></div>
        <div><dt>@(BatteryPower is null ? T["Battery state unknown"] : BatteryPower < 0 ? T["Charging"] : BatteryPower > 0 ? T["Discharging"] : T["Battery idle"])</dt><dd>@T.Number(BatteryPower) kW</dd></div>
    </dl>
    <a class="text-link" href="/activity/readings">@T["Live readings"] →</a>
</UiCard>

@code {
    [Parameter, EditorRequired] public LiveReading Data { get; set; } = default!;
    [Parameter] public IReadOnlyList<TriggerRule> Rules { get; set; } = [];
    private IReadOnlyList<EnergyFlowThreshold> Markers => EnergyFlowPresentation.Thresholds(Rules);
    private double? SolarPower => EnergyFlowPresentation.NonnegativePower(Data.SolarKw);
    private double? LoadPower => EnergyFlowPresentation.NonnegativePower(Data.LoadKw);
    private double? GridPower => EnergyFlowPresentation.FinitePower(Data.GridKw);
    private double? BatteryPower => EnergyFlowPresentation.FinitePower(Data.BatteryKw);
    private string Power(double? value) => T.Number(value is { } power ? Math.Abs(power) : null) + " kW";
}
