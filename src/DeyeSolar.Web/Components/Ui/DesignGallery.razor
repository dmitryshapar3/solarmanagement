@attribute [AllowAnonymous]
<div class="page-content" style="padding:32px 24px;max-width:1160px">
    <PageHeader Title="SmartSolar components" Subtitle="Development fixtures · Every value below is sample data">
        <select aria-label="Appearance" data-appearance><option value="light">Light</option><option value="dark">Dark</option><option value="system">System</option></select>
    </PageHeader>
    <BrandMark />
    <div class="gallery-grid">
        <UiCard Title="Actions"><div class="gallery-controls"><UiButton Variant="primary">Continue</UiButton><UiButton Variant="strong">Save changes</UiButton><UiButton Variant="outline">Cancel</UiButton><UiButton Disabled="true">Unavailable</UiButton><UiButton Busy="true">Saving</UiButton><UiButton Variant="critical">Delete</UiButton><UiButton Icon="download">Download CSV</UiButton></div></UiCard>
        <UiCard Title="Selection"><div class="gallery-controls"><UiSwitch @bind-Value="@_enabled" Label="Sample switch" /><UiSwitch Value="true" Busy="true" Label="Sending" /><UiSwitch Disabled="true" Label="Disabled switch" /><StatusPill Kind="positive">Connected</StatusPill><StatusPill Kind="warning">Needs attention</StatusPill><StatusPill Kind="critical">Failed</StatusPill></div><div class="segments" style="margin-top:20px"><button class="selected">Day</button><button>7 days</button><button>30 days</button></div></UiCard>
        <UiCard Title="Fields"><div class="form-stack"><UiNumber Label="Capacity" Unit="kWp" Min="0" Max="10000" @bind-Value="@_capacity" /><UiSelect Label="Language" @bind-Value="@_language" Options="_languages" /><UiSelect Label="Search time zones" Value="Europe/Warsaw" Searchable="true" Options="_zones" /><div class="ui-field"><label for="gallery-error">Email</label><input id="gallery-error" value="invalid" aria-invalid="true" aria-describedby="gallery-error-text" /><p id="gallery-error-text" class="field-error">Enter a valid email address.</p></div></div></UiCard>
        <UiCard Title="Range, stepper and dialog"><div class="threshold-controls"><div class="threshold-labels"><span>Switch off at @_off%</span><span>Switch on at @_on%</span></div><input type="range" min="0" max="99" @bind="_off" aria-label="Switch off threshold" /><input type="range" min="1" max="100" @bind="_on" aria-label="Switch on threshold" /></div><div class="stepper"><button @onclick="() => _count = Math.Max(1, _count - 1)" aria-label="Decrease">−</button><output>@_count</output><button @onclick="() => _count++" aria-label="Increase">+</button></div><div style="margin-top:24px"><UiButton OnClick="() => _dialog = true">Open dialog</UiButton></div></UiCard>
        <UiCard Title="Status"><div class="form-stack"><div class="banner positive">Connection works · Nothing was switched</div><div class="banner">Missing prices are never counted as zero.</div><div class="banner critical">The previous command remains unconfirmed.</div><UiState Kind="empty" Title="No readings yet" Message="Connect an inverter to see real production." /></div></UiCard>
        <UiCard Title="Roof preview"><div class="form-stack"><UiNumber Label="Sample roof tilt" Unit="°" Min="0" Max="90" @bind-Value="_roofTilt" /><UiNumber Label="Sample roof azimuth" Unit="°" Min="0" Max="360" @bind-Value="_roofAzimuth" /><UiNumber Label="Sample roof 1 panel count" Min="0" Max="1000" Value="_roof1Count" ValueChanged="v=>_roof1Count=(int)v" /><UiNumber Label="Sample roof 2 panel count" Min="0" Max="1000" Value="_roof2Count" ValueChanged="v=>_roof2Count=(int)v" /><UiNumber Label="Sample panels per row" Min="0" Max="1000" Value="_roofColumns" ValueChanged="v=>_roofColumns=(int)v" /><RoofSunDiagram Roof1PanelCount="_roof1Count" Roof2PanelCount="_roof2Count" Roof1PanelsPerRow="_roofColumns" Roof2PanelsPerRow="_roofColumns" Latitude="50.095278" Longitude="20.070278" TimeZoneId="Europe/Warsaw" Roof1Kwp="4.32" Roof1Tilt="_roofTilt" Roof1Azimuth="_roofAzimuth" Roof2Kwp="3.78" Roof2Tilt="_roofTilt" Roof2Azimuth="@((_roofAzimuth+180)%360)" At="@(new DateTimeOffset(2026,10,10,10,0,0,TimeSpan.Zero))" /></div></UiCard>
        <UiCard Title="Chart and table twin"><div class="chart-readout"><div><small>Sample hour 12:00–13:00</small><strong>3.8 kW</strong></div><StatusPill Kind="positive">In range</StatusPill></div><svg class="chart" viewBox="0 0 440 190" role="img" aria-label="Sample chart with a deliberate gap"><g transform="translate(20 10)"><path d="@ChartGeometry.Band(_lower, _upper, 400, 150, 6)" class="possible-band" /><path d="@ChartGeometry.Line(_actual, 400, 150, 6)" class="actual-line" /></g></svg><div class="table-box"><table class="data-table" style="min-width:0"><caption>Sample data · A dash is unavailable</caption><thead><tr><th>Hour</th><th>Actual · kW</th><th>Expected · kW</th></tr></thead><tbody>@for (var i = 0; i < _actual.Length; i++) { <tr><td>@(8 + i):00</td><td>@(_actual[i]?.ToString("0.0") ?? "—")</td><td>@_lower[i]–@_upper[i]</td></tr> }</tbody></table></div></UiCard>
    </div>
    <div class="save-bar"><div><strong>Unsaved changes</strong><br /><small>Panels · group 2 capacity</small></div><UiButton Variant="outline">Discard</UiButton><UiButton Variant="primary">Save changes</UiButton></div>
</div>
@if (_dialog) { <UiModal Title="Pause automation?" OnClose="() => _dialog = false"><p>Sample confirmation. No device is connected.</p><div class="form-actions"><UiButton Variant="outline" OnClick="() => _dialog = false">Cancel</UiButton><UiButton Variant="primary" OnClick="() => _dialog = false">Pause</UiButton></div></UiModal> }
@code {
    private bool _enabled = true, _dialog;
    private int _roof1Count = 8, _roof2Count = 7, _roofColumns = 4;
    private double _capacity = 4.2, _roofTilt = 25, _roofAzimuth = 230;
    private int _count = 1, _off = 55, _on = 75;
    private string _language = "en";
    private readonly Dictionary<string, string> _languages = new() { ["en"] = "English", ["ru"] = "Русский", ["pl"] = "Polski" };
    private readonly Dictionary<string, string> _zones = TimeZoneInfo.GetSystemTimeZones().ToDictionary(z => z.Id, z => z.DisplayName);
    private readonly double?[] _actual = [0, 1.2, 2.8, null, 3.8, 2.2, 0];
    private readonly double?[] _lower = [0, .6, 1.5, 2.1, 2.3, 1.5, 0];
    private readonly double?[] _upper = [0, 1.8, 3.4, 4.7, 5.1, 3.4, 0];
}
