@inject IJSRuntime JS
@implements IAsyncDisposable
<dialog @ref="_dialog" class="ui-modal" aria-labelledby="@_id"><header><h2 id="@_id">@Title</h2><button type="button" class="icon-button" data-dialog-close disabled="@(!CanClose)" @onclick="Close" aria-label="@T["Close"]"><UiIcon Name="close" /></button></header>@ChildContent</dialog>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CanClose { get; set; } = true;
    private readonly string _id = "dialog-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JS.InvokeVoidAsync("smartSolar.dialog", _dialog, _id); }
    private Task Close() => CanClose ? OnClose.InvokeAsync() : Task.CompletedTask;
    public async ValueTask DisposeAsync() { try { await JS.InvokeVoidAsync("smartSolar.restoreDialog", _id); } catch (JSDisconnectedException) { } }
}
