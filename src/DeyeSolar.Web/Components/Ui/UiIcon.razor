<svg class="ui-icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "home": <path d="m3 10 9-7 9 7v10H3z M9 20v-7h6v7" /> break;
        case "energy": <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" /> break;
        case "devices": <path d="M7 3v6m10-6v6M5 9h14v3a7 7 0 0 1-14 0zM12 19v3" /> break;
        case "automations": <path d="m13 2-8 12h6l-1 8 9-13h-6z" /> break;
        case "activity": <path d="M3 12h4l3-8 4 16 3-8h4" /> break;
        case "settings": <path d="M4 6h16M4 12h16M4 18h16" /><circle cx="8" cy="6" r="2" fill="var(--surface)" /><circle cx="16" cy="12" r="2" fill="var(--surface)" /><circle cx="10" cy="18" r="2" fill="var(--surface)" /> break;
        case "logout": <path d="M10 4H4v16h6m4-12 4 4-4 4m-6-4h10" /> break;
        case "help": <circle cx="12" cy="12" r="9" /><path d="M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4m0 3v.1" /> break;
        case "chevron": <path d="m9 5 7 7-7 7" /> break;
        case "down": <path d="m5 9 7 7 7-7" /> break;
        case "back": <path d="m15 5-7 7 7 7" /> break;
        case "close": <path d="m5 5 14 14M5 19 19 5" /> break;
        case "menu": <path d="M4 6h16M4 12h16M4 18h16" /> break;
        case "plus": <path d="M12 4v16M4 12h16" /> break;
        case "download": <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /> break;
        case "check": <path d="m4 12 5 5L20 6" /> break;
        case "battery": <rect x="3" y="6" width="17" height="12" rx="3" /><path d="M22 10v4M6 9v6m4-6v6m4-6v6" /> break;
        case "grid": <path d="m8 3 8 0 4 18M8 3 4 21M6 12h12M5 17h14M7 7h10" /> break;
        case "copy": <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V4H4v12h4" /> break;
        default: <circle cx="12" cy="12" r="9" /><path d="M12 8v5m0 3v.1" /> break;
    }
</svg>
@code {
    [Parameter] public string Name { get; set; } = "info";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
}
