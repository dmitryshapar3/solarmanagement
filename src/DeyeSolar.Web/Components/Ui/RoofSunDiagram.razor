@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@implements IAsyncDisposable
@inject IServiceProvider Services
<div class="roof-sun-diagram">
    <div class="roof-sun-heading"><strong>@T["Roof and sun"]</strong>@if (Day is { } day) { <span>@T.Format("Sun path · {0}", day.Date.ToString("d MMM yyyy", T.Culture)) · @TimeZoneId</span> }</div>
    <div class="roof-scene" @ref="_sceneRoot">
        <div class="roof-scene-stage">
            <svg class="roof-sun-compass roof-scene-fallback" viewBox="0 0 360 320" role="img" aria-label="@T["Roof layout and calculated sun path"]">
                <polygon class="roof-scene-ground" points="@RoofSceneGeometry.Points(Scene.Ground)" />
                @foreach(var axis in Scene.Axes){<path class="roof-scene-axis" d="@RoofSceneGeometry.Path(axis)" />}
                @foreach(var path in Scene.SunPaths)
                {
                    <path class="roof-scene-sun-path roof-sun-path" d="@RoofSceneGeometry.Path(path)" />
                    @if(path.Length>4){foreach(var fraction in new[]{1d/3,2d/3}){var index=Math.Clamp((int)(path.Length*fraction),0,path.Length-2);var q=RoofSceneGeometry.Project(path[index]);var next=RoofSceneGeometry.Project(path[index+1]);var angle=Math.Atan2(next.Y-q.Y,next.X-q.X)*180/Math.PI;<path class="roof-scene-sun-direction" d="M-5 -4L0 0L-5 4" transform="@($"translate({F(q.X)} {F(q.Y)}) rotate({F(angle)})")" />}}
                }
                @foreach(var face in Scene.Faces.Where(f=>f.Kind!="panel" || !Scene.Faces.Any(r=>(r.Kind=="roof" || r.Kind=="vertical") && r.Roof==f.Roof)).OrderBy(f=>f.Points.Average(p=>RoofSceneGeometry.Project(p).Depth)))
                {
                    <polygon class="roof-scene-face roof-scene-@face.Kind" data-roof="@face.Roof" points="@RoofSceneGeometry.Points(face.Points)" />
                    @if(face.Kind is "roof" or "vertical"){foreach(var panel in Scene.Faces.Where(p=>p.Kind=="panel" && p.Roof==face.Roof)){<polygon class="roof-scene-face roof-scene-panel" data-roof="@panel.Roof" points="@RoofSceneGeometry.Points(panel.Points)" />}}
                }
                @foreach(var line in Scene.Lines){<path class="roof-scene-line roof-scene-@line.Kind" d="@RoofSceneGeometry.Path(line.Points)" />}
                @foreach(var point in Scene.Crossings){var q=RoofSceneGeometry.Project(point);<circle class="roof-scene-crossing" cx="@F(q.X)" cy="@F(q.Y)" r="4" />}
                @if(Scene.SunNow is {} now){var q=RoofSceneGeometry.Project(now);<circle class="roof-scene-sun-current" cx="@F(q.X)" cy="@F(q.Y)" r="10" />}
                @foreach(var label in Scene.Labels){var q=LabelPosition(label);<g><text class="roof-scene-label @(label.Kind=="roof"?"roof-scene-number":"roof-scene-cardinal")" x="@F(q.X)" y="@F(q.Y)">@label.Text</text></g>}
            </svg>
            <svg class="roof-sun-compass roof-scene-interactive" viewBox="0 0 360 320" role="img" tabindex="0" aria-label="@T["Roof layout and calculated sun path"]" aria-describedby="@_hintId"></svg>
        </div>
        <div class="roof-scene-controls" role="group" aria-label="@T["Roof and sun"]">
            <button type="button" class="roof-scene-control" data-roof-action="left" title="@T["Rotate left"]" aria-label="@T["Rotate left"]">↶</button>
            <button type="button" class="roof-scene-control" data-roof-action="right" title="@T["Rotate right"]" aria-label="@T["Rotate right"]">↷</button>
            <button type="button" class="roof-scene-control" data-roof-action="up" title="@T["Tilt view up"]" aria-label="@T["Tilt view up"]">↑</button>
            <button type="button" class="roof-scene-control" data-roof-action="down" title="@T["Tilt view down"]" aria-label="@T["Tilt view down"]">↓</button>
            <button type="button" class="roof-scene-control" data-roof-action="zoom-out" title="@T["Zoom out"]" aria-label="@T["Zoom out"]">−</button>
            <button type="button" class="roof-scene-control" data-roof-action="zoom-in" title="@T["Zoom in"]" aria-label="@T["Zoom in"]">+</button>
            <button type="button" class="roof-scene-control roof-scene-reset" data-roof-action="reset">@T["Reset view"]</button>
        </div>
        @if (OrientationChanged.HasDelegate)
        {
            <div class="roof-scene-direction-controls">
                <button type="button" class="roof-scene-control roof-scene-reset" aria-pressed="@_editingDirection.ToString().ToLowerInvariant()" disabled="@DirectionDisabled" @onclick="ToggleDirection">@T[_editingDirection ? "Done" : "Set house direction"]</button>
                @if (_editingDirection)
                {
                    <button type="button" class="roof-scene-control" data-roof-action="direction-left" disabled="@DirectionDisabled" aria-label="@T["Rotate sun path left"]">↶</button>
                    <button type="button" class="roof-scene-control" data-roof-action="direction-right" disabled="@DirectionDisabled" aria-label="@T["Rotate sun path right"]">↷</button>
                }
            </div>
        }
        <p class="roof-scene-hint" id="@_hintId">@if (_editingDirection) { @T["Rotate the sun path around the house to set its direction. Both roof azimuths change together."] } else { <span class="roof-scene-pointer-hint">@T["Drag to rotate · Scroll to zoom"]</span><span class="roof-scene-touch-hint">@T["Drag to rotate · Pinch to zoom"]</span> }</p>
    </div>
    @if (Day is { } sun)
    {
        <div class="roof-sun-facts">
            @if (sun.State == "polar-day") { <p>@T["Sun stays above the horizon on this date."]</p> }
            else if (sun.State == "polar-night") { <p>@T["Sun stays below the horizon on this date."]</p> }
            else { <span>@T["Sunrise"] <strong>@Time(sun.Sunrise)</strong></span><span>@T["Sunset"] <strong>@Time(sun.Sunset)</strong></span> }
            <span>@T[sun.Now is null ? "Sun below horizon" : "Sun now"] @if(sun.Now is { } currentFact){<strong>@T.Number(currentFact.Elevation,"0")°</strong>}</span>
        </div>
    }
    else { <p class="caption" role="status">@T["Enter valid coordinates and a solar time zone to see the sun path."]</p> }
    <div class="roof-sun-roofs">
        @foreach (var roof in Roofs)
        {
            <div class="roof-sun-roof"><strong>@T[roof.Number == 1 ? "Roof 1" : "Roof 2"] · @T.Number(roof.Capacity, "0.##") kWp</strong>@if(PanelCount(roof.Number) is {} count){<span>@T.Format("{0} panels", count)</span>}<span>@T["Azimuth"] @T.Number(roof.Azimuth, "0.#")° · @T["Tilt"] @T.Number(roof.Tilt, "0.#")°</span></div>
        }
    </div>
    @if(Roofs.Any(r=>r.Tilt==90)){<p class="caption roof-sun-note">@T["Vertical arrays are shown standing on the schematic roof."]</p>}
    @if(Roofs.Any(r=>PanelCount(r.Number) is null)){<p class="caption roof-sun-note">@T["Enter the panel count for each roof to show its panels."]</p>}
    <p class="caption roof-sun-note">@T["Schematic roof; panel count and rows follow your settings. Dimensions and shadows are not modelled."]</p>
</div>
@code {
    [Parameter] public double Latitude { get; set; }
    [Parameter] public double Longitude { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = "";
    [Parameter] public double Roof1Kwp { get; set; }
    [Parameter] public double Roof1Tilt { get; set; }
    [Parameter] public double Roof1Azimuth { get; set; }
    [Parameter] public double Roof2Kwp { get; set; }
    [Parameter] public double Roof2Tilt { get; set; }
    [Parameter] public double Roof2Azimuth { get; set; }
    [Parameter] public int? Roof1PanelCount { get; set; }
    [Parameter] public int? Roof2PanelCount { get; set; }
    [Parameter] public int? Roof1PanelsPerRow { get; set; }
    [Parameter] public int? Roof2PanelsPerRow { get; set; }
    [Parameter] public EventCallback<double> OrientationChanged { get; set; }
    [Parameter] public bool DirectionDisabled { get; set; }
    [Parameter] public DateTimeOffset? At { get; set; }
    private SolarDiagramDay? Day { get; set; }
    private IReadOnlyList<SolarDiagramRoof> Roofs { get; set; } = [];
    private RoofScene Scene { get; set; } = RoofSceneGeometry.Create([], null, 0, 0);
    private ElementReference _sceneRoot;
    private IJSObjectReference? _sceneModule;
    private DotNetObjectReference<RoofSunDiagram>? _directionBridge;
    private bool _editingDirection, _disposed;
    private readonly string _hintId = "roof-scene-hint-" + Guid.NewGuid().ToString("N");
    private int? PanelCount(int roof) => roof == 1 ? Roof1PanelCount : Roof2PanelCount;
    private void ToggleDirection() { if (!DirectionDisabled) _editingDirection = !_editingDirection; }
    [JSInvokable]
    public Task RotateHouse(double delta) => !_disposed && _editingDirection && !DirectionDisabled && double.IsFinite(delta) && Math.Abs(delta) <= 360
        ? OrientationChanged.InvokeAsync(delta) : Task.CompletedTask;
    private RoofSceneProjection LabelPosition(RoofSceneLabel label)
    {
        if(label.Kind=="roof" && int.TryParse(label.Text,out var number)
            && Scene.Faces.FirstOrDefault(f=>f.Roof==number && f.Kind is "roof" or "vertical") is {} face)
        {
            var polygon=face.Points.Select(p=>RoofSceneGeometry.Project(p)).ToArray();
            var corner=polygon.MaxBy(p=>p.Y)!;
            return corner with{X=corner.X+Math.Sign(corner.X-polygon.Average(p=>p.X))*6,Y=corner.Y+14};
        }
        return RoofSceneGeometry.Project(label.Point);
    }
    protected override void OnParametersSet()
    {
        Day = RoofSunGeometry.Day(Latitude, Longitude, TimeZoneId, At ?? DateTimeOffset.UtcNow);
        Roofs = RoofSunGeometry.Roofs(Roof1Kwp, Roof1Tilt, Roof1Azimuth, Roof2Kwp, Roof2Tilt, Roof2Azimuth);
        Scene = RoofSceneGeometry.Create(Roofs, Day, Latitude, Longitude,
            Roof1PanelCount, Roof2PanelCount, Roof1PanelsPerRow, Roof2PanelsPerRow);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Services.GetService(typeof(IJSRuntime)) is not IJSRuntime js) return;
        try
        {
            if (_sceneModule is null)
            {
                var moduleUrl = Services.GetRequiredService<IFileVersionProvider>()
                    .AddFileVersionToPath(Microsoft.AspNetCore.Http.PathString.Empty, "/js/roof-scene.js");
                _sceneModule = await js.InvokeAsync<IJSObjectReference>("import", moduleUrl);
                await _sceneModule.InvokeVoidAsync("mount", _sceneRoot, Scene);
            }
            if (OrientationChanged.HasDelegate)
            {
                _directionBridge ??= DotNetObjectReference.Create(this);
                var bearing = (Roofs.FirstOrDefault(r => r.Tilt < 90) ?? Roofs.FirstOrDefault())?.Azimuth ?? Roof1Azimuth;
                await _sceneModule.InvokeVoidAsync("updateOrientation", _sceneRoot, Scene, _editingDirection, DirectionDisabled, _directionBridge, bearing);
            }
            else if (!firstRender) await _sceneModule.InvokeVoidAsync("update", _sceneRoot, Scene);
        }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_sceneModule is not null) { await _sceneModule.InvokeVoidAsync("dispose", _sceneRoot); await _sceneModule.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        finally { _directionBridge?.Dispose(); }
    }
    private static string F(double value) => RoofSunGeometry.F(value);
    private string Time(DateTimeOffset? instant) => instant.HasValue && Day is { } day ? TimeZoneInfo.ConvertTime(instant.Value, TimeZoneInfo.FindSystemTimeZoneById(day.TimeZoneId)).ToString("t", T.Culture) : "—";
}
