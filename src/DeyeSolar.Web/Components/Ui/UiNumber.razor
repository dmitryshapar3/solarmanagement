@implements IDisposable
<div class="ui-field"><label for="@_id">@Label</label><div class="field-unit"><input id="@_id" type="text" inputmode="@(Integer ? "numeric" : "decimal")" value="@_text" @oninput="Changed" aria-invalid="@((_error is not null).ToString().ToLowerInvariant())" aria-describedby="@(_error is null ? null : _id + "-error")" disabled="@Disabled" />@if (Unit is not null) { <span>@Unit</span> }</div>@if (_error is not null) { <p id="@(_id + "-error")" class="field-error" role="alert">@_error</p> }</div>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; } = double.MinValue;
    [Parameter] public double Max { get; set; } = double.MaxValue;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Integer { get; set; }
    [Parameter] public int DecimalPlaces { get; set; } = 3;
    [CascadingParameter] private UiFormState? Form { get; set; }
    private readonly string _id = "number-" + Guid.NewGuid().ToString("N");
    private string _text = "";
    private string? _error;
    private double? _last;
    protected override void OnParametersSet() { if (_last != Value) { _text = Value.ToString("0." + new string('#', Math.Clamp(DecimalPlaces, 0, 12)), T.Culture); _last = Value; _error = null; Form?.Mark(_id, true); } }
    private async Task Changed(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? "";
        if (!UiInputParser.TryNumber(_text, T.Culture, out var number) || Integer && number != Math.Truncate(number)) { _error = T["Enter a valid number."]; Form?.Mark(_id, false); return; }
        if (number < Min || number > Max) { _error = T.Format("Enter a value between {0} and {1}.", Min, Max); Form?.Mark(_id, false); return; }
        _error = null; _last = number; Form?.Mark(_id, true); await ValueChanged.InvokeAsync(number);
    }
    public void Dispose() => Form?.Remove(_id);
}
