@using DeyeSolar.Web.Services
@inject IJSRuntime JS
<div class="chart-readout" aria-live="polite"><span>@if(Selected is {} row){<time datetime="@row.Start.ToString("O")">@T.Time(row.Start,Data.TimeZoneId,Data.Request.Period==ExportSalesPeriod.Day?"HH:mm zzz":"d MMM yyyy")</time>}else{<span>—</span>}</span><strong>@T.Number(SelectedValue) @(_money?"PLN":"kWh")</strong><span>@T["Completed hours only"]@if(SelectedProgress is {} currentAmount){<br/>@T.Format("In progress: {0} {1}, excluded from totals",T.Number(currentAmount),_money?"PLN":"kWh")}</span></div>
<div class="toolbar"><span class="legend"><i style="background:var(--solar)"></i>@T["Completed export"]<i style="background:transparent;border:1px solid var(--solar)"></i>@T["Current hour · in progress"]</span><div class="segments" aria-label="@T["Chart metric"]"><button class="@(!_money?"selected":null)" aria-pressed="@((!_money).ToString().ToLowerInvariant())" @onclick="()=>_money=false">@T["Energy"]</button><button class="@(_money?"selected":null)" aria-pressed="@(_money.ToString().ToLowerInvariant())" @onclick="()=>_money=true">@T["Value"]</button></div></div>
<p class="sr-only">@T["Use left and right arrow keys to select an interval."]</p>
<svg @ref="_plot" class="data-plot" viewBox="0 0 920 280" role="img" tabindex="0" aria-label="@(_money?T["Exported energy value, PLN"]:T["Energy exported to grid, kWh"])" @onkeydown="Key" @onpointermove="Pointer" @onpointerdown="PointerDown" @onpointerenter="async()=>await Measure()">
@for(var tick=0;tick<=4;tick++){var value=_minimum+(_maximum-_minimum)*tick/4;var y=Y(value);<line class="plot-grid" x1="48" x2="896" y1="@N(y)" y2="@N(y)"/><g><text class="plot-axis" x="40" y="@N(y+4)" text-anchor="end">@value.ToString("0.##",T.Culture)</text></g>}
<line class="plot-grid" x1="48" x2="896" y1="@N(Y(0))" y2="@N(Y(0))"/>
@for(var i=0;i<Data.Buckets.Count;i++){var b=Data.Buckets[i];var x=X(i);var width=Math.Max(2,Step*.65);@if(Value(b) is {} value){var y=Y((double)value);<rect class="export-bar" x="@N(x-width/2)" y="@N(Math.Min(y,Y(0)))" width="@N(width)" height="@N(Math.Max(1,Math.Abs(y-Y(0))))" data-testid="sales-bar" data-start="@b.Start.ToString("O")"/>}@if(Progress(b) is {} progress){var baseValue=(double)(Value(b)??0);var a=Y(baseValue);var z=Y(baseValue+(double)progress);<rect class="export-progress" data-start="@b.Start.ToString("O")" x="@N(x-width/2)" y="@N(Math.Min(a,z))" width="@N(width)" height="@N(Math.Max(1,Math.Abs(a-z)))" data-testid="sales-progress-bar"><title>@T["Current hour · in progress"]</title></rect>}
@if(i%Math.Max(1,Data.Buckets.Count/6)==0||i==Data.Buckets.Count-1){<g><text class="plot-axis" x="@N(x)" y="258" text-anchor="middle">@T.Time(b.Start,Data.TimeZoneId,Data.Request.Period==ExportSalesPeriod.Day?"HH":Data.Request.Period==ExportSalesPeriod.Year?"MMM":"d MMM")</text></g>}}
@if(Selected is not null){<line class="plot-cursor" x1="@N(X(SelectedIndex))" x2="@N(X(SelectedIndex))" y1="28" y2="232"/>}
</svg>
@code{
 [Parameter,EditorRequired]public ExportSalesResult Data{get;set;}=default!;
 [Parameter]public int SelectedIndex{get;set;}
 [Parameter]public EventCallback<int> SelectedIndexChanged{get;set;}
 private bool _money;private ElementReference _plot;private double _left,_width;
 private ExportSaleBucket? Selected=>Data.Buckets.Count==0?null:Data.Buckets[Math.Clamp(SelectedIndex,0,Data.Buckets.Count-1)];
 private decimal? SelectedValue=>Selected is {} b?Value(b):null;private decimal? SelectedProgress=>Selected is {} b?Progress(b):null;
 private decimal? Value(ExportSaleBucket b)=>_money?b.EnergyValuePln:b.ExportKwh;
 private decimal? Progress(ExportSaleBucket b)=>Data.CurrentHour is {} p&&p.Start>=b.Start&&p.Start<b.End?(_money?p.EnergyValuePln:p.ExportKwh):null;
 private ExportChartScale Scale=>ExportChartGeometry.Scale(Data.Buckets.Select(b=>(Value(b),Progress(b))));
 private double _minimum=>Scale.Minimum;private double _maximum=>Scale.Maximum;
 private double Step=>ExportChartGeometry.Step(Data.Buckets.Count);private double X(int index)=>ExportChartGeometry.X(index,Data.Buckets.Count);private double Y(double value)=>Scale.Y(value);
 private static string N(double value)=>ChartGeometry.Number(value);
 protected override async Task OnAfterRenderAsync(bool first){if(first)await Measure();}
 private async Task Measure(){try{var bounds=await JS.InvokeAsync<double[]>("smartSolar.bounds",_plot);if(bounds?.Length==2){_left=bounds[0];_width=bounds[1];}}catch(JSException){} }
 private async Task PointerDown(PointerEventArgs e){await Measure();await Pointer(e);}
 private Task Pointer(PointerEventArgs e)=>_width>0?Select((int)Math.Floor(((e.ClientX-_left)*920/_width-48)/Step)):Task.CompletedTask;
 private Task Key(KeyboardEventArgs e)=>e.Key switch{"ArrowLeft"=>Select(SelectedIndex-1),"ArrowRight"=>Select(SelectedIndex+1),"Home"=>Select(0),"End"=>Select(Data.Buckets.Count-1),_=>Task.CompletedTask};
 private Task Select(int index)=>Data.Buckets.Count==0?Task.CompletedTask:SelectedIndexChanged.InvokeAsync(Math.Clamp(index,0,Data.Buckets.Count-1));
}
