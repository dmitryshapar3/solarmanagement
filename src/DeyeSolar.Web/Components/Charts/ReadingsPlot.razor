@using DeyeSolar.Web.Redesign
<div class="toolbar"><h3>@T["Solar and battery"]</h3><span class="legend"><i style="background:var(--solar)"></i>@T["Solar · kW"]<i style="background:var(--battery)"></i>@T["Battery · %"]</span></div><svg class="data-plot" viewBox="0 0 920 260" role="img" aria-label="@T["Recorded solar power and battery charge; gaps stay empty"]">
@for(var i=0;i<=4;i++){var y=224-i*48;<line class="plot-grid" x1="48" x2="876" y1="@y" y2="@y"/><g><text class="plot-axis" x="40" y="@(y+4)" text-anchor="end">@T.Number(_solarMax*i/4,"0.##")</text><text class="plot-axis" x="884" y="@(y+4)">@(i*25)%</text></g>}
@foreach(var gap in Data.Gaps){var left=X(gap.From);var right=X(gap.To);<rect x="@N(left)" y="32" width="@N(Math.Max(0,right-left))" height="192" fill="var(--fill)" opacity=".8"><title>@T[ActivityPresentation.Reason(gap.ReasonCode)]</title></rect>}
@foreach(var segment in Segments(row=>row.SolarProduction/1000d)){<path d="@Path(segment,_solarMax)" fill="none" stroke="var(--solar)" stroke-width="2.5"/>@if(segment.Count==1){<circle cx="@N(X(segment[0].At))" cy="@N(224-segment[0].Value/_solarMax*192)" r="3" fill="var(--solar)"/>}}@foreach(var segment in Segments(row=>row.BatterySoc)){<path d="@Path(segment,100)" fill="none" stroke="var(--battery)" stroke-width="2.5"/>@if(segment.Count==1){<circle cx="@N(X(segment[0].At))" cy="@N(224-segment[0].Value/100*192)" r="3" fill="var(--battery)"/>}}
@for(var i=0;i<=4;i++){var time=Data.Start.AddSeconds((Data.End-Data.Start).TotalSeconds*i/4);<g><text class="plot-axis" x="@N(X(time))" y="250" text-anchor="middle">@T.Time(time,TimeZoneId,"HH:mm")</text></g>}
</svg>
@code{
 [Parameter,EditorRequired]public ReadingsViewDto Data{get;set;}=default!;[Parameter]public string TimeZoneId{get;set;}="UTC";
 private double _solarMax=>Math.Max(.1,Data.Items.Select(r=>r.SolarProduction/1000d).Where(v=>v.HasValue).Select(v=>v!.Value).DefaultIfEmpty(0).Max()*1.12);
 private double X(DateTimeOffset at)=>48+Math.Clamp((at-Data.Start).TotalSeconds/Math.Max(1,(Data.End-Data.Start).TotalSeconds),0,1)*828;
 private static string N(double n)=>ChartGeometry.Number(n);
 private IEnumerable<List<(DateTimeOffset At,double Value)>> Segments(Func<ReadingRowDto,double?> read){var segment=new List<(DateTimeOffset,double)>();ReadingRowDto? previous=null;foreach(var row in Data.Items.OrderBy(r=>r.Timestamp)){var value=read(row);var same=previous is not null&&previous.InverterId==row.InverterId&&previous.ConfigurationRevision==row.ConfigurationRevision&&previous.RuntimeGeneration==row.RuntimeGeneration&&previous.DataSource==row.DataSource&&row.Timestamp-previous.Timestamp<=TimeSpan.FromMinutes(10);if(!same||value is null||!double.IsFinite(value.Value)){if(segment.Count>0){yield return segment;segment=[];}}if(value is {} number&&double.IsFinite(number))segment.Add((row.Timestamp,number));previous=row;}if(segment.Count>0)yield return segment;}
 private string Path(List<(DateTimeOffset At,double Value)> points,double max){var output=new System.Text.StringBuilder();for(var i=0;i<points.Count;i++){var x=X(points[i].At);var y=224-points[i].Value/max*192;if(i==0)output.Append($"M {N(x)} {N(y)} ");else{var last=points[i-1];var px=X(last.At);var py=224-last.Value/max*192;output.Append($"C {N(px+(x-px)/3)} {N(py)} {N(x-(x-px)/3)} {N(y)} {N(x)} {N(y)} ");}}return output.ToString();}
}
