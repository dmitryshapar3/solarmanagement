@using DeyeSolar.Web.Redesign
<div class="toolbar"><h3>@T["Last 24 hours"]</h3><strong>@T.Format("On for {0}",UiFormat.Duration(Data.OnSeconds))</strong></div><div class="device-timeline" role="img" aria-label="@T["Recorded on, off and unknown intervals"]">@foreach(var interval in Data.Intervals){var left=(interval.From-Data.Start).TotalSeconds/(Data.End-Data.Start).TotalSeconds*100;var width=(interval.To-interval.From).TotalSeconds/(Data.End-Data.Start).TotalSeconds*100;<span class="@(interval.IsOn==true?"on":interval.IsOn==false?"off":"unknown")" style="left:@N(left)%;width:@N(width)%"><title>@UiFormat.Time(interval.From,TimeZoneId)–@UiFormat.Time(interval.To,TimeZoneId) · @(interval.IsOn==true?T["On"]:interval.IsOn==false?T["Off"]:T["Unknown"])</title></span>}</div><div class="toolbar caption"><span>@UiFormat.Time(Data.Start,TimeZoneId,"d MMM HH:mm zzz")</span><span>@UiFormat.Time(Data.End,TimeZoneId,"d MMM HH:mm zzz")</span></div><p class="legend"><i style="background:var(--ink)"></i>@T["On"]<i style="background:var(--fill)"></i>@T["Off"]<i class="unknown-key"></i>@T["Unknown"]</p>@if(Data.Partial){<p class="caption">@T["Only recorded evidence contributes to on-duration. Unknown time stays unknown."]</p>}<details><summary>@T["Timeline data"]</summary><table class="data-table"><thead><tr><th>@T["From"]</th><th>@T["To"]</th><th>@T["State"]</th><th>@T["Evidence"]</th></tr></thead><tbody>@foreach(var i in Data.Intervals){<tr><td>@UiFormat.Time(i.From,TimeZoneId,"HH:mm zzz")</td><td>@UiFormat.Time(i.To,TimeZoneId,"HH:mm zzz")</td><td>@(i.IsOn==true?T["On"]:i.IsOn==false?T["Off"]:T["Unknown"])</td><td>@T[i.Evidence=="provider_acknowledgement"?"Provider acknowledgement":i.IsOn.HasValue?"Device observation":"No recorded evidence"]</td></tr>}</tbody></table></details>
@code{[Parameter,EditorRequired]public DeviceHistoryDto Data{get;set;}=default!;[Parameter]public string TimeZoneId{get;set;}="UTC";private static string N(double n)=>ChartGeometry.Number(n);}
