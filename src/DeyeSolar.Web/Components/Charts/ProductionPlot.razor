@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Services
@using System.Globalization
@inject TimeProvider Clock
@inject IJSRuntime JS
@if(Data is not null) {
@if(!Compact) { <div class="chart-readout" aria-live="polite"><div><small>@SelectedLabel</small><strong>@T.Number(SelectedActual) @(Daily?"kWh":"kW")</strong></div><div><small>@T["Expected"]</small><strong>@T.Number(SelectedExpected) @(Daily?"kWh":"kW")</strong></div><div><small>@T["Expected range"]</small><strong>@T.Number(SelectedLower)–@T.Number(SelectedUpper) @(Daily?"kWh":"kW")</strong></div><StatusPill Kind="@StatusKind">@StatusText</StatusPill></div><div class="chart-legend"><span><i class="chart-key"></i>@T["Actual"]</span><span><i class="chart-key forecast"></i>@T["Forecast"]</span><span><i class="chart-key expected"></i>@T["Expected range"]</span></div> }
<svg @ref="_svg" class="chart chart-scrub" viewBox="0 0 920 280" role="img" tabindex="0" aria-label="@T.Format("Production chart · {0}. Use left and right arrow keys to select an interval.",SelectedLabel)" @onkeydown="KeyDown" @onpointermove="Pointer" @onpointerdown="PointerDown" @onpointerenter="async()=>await Measure()" style="touch-action:pan-y">
@for(var tick=0;tick<=4;tick++) { var y=232-tick*51; <line x1="48" x2="896" y1="@y" y2="@y" class="chart-grid" /><g><text x="38" y="@(y+4)" text-anchor="end">@T.Number(Maximum*tick/4,"0.#")</text></g> }
<g transform="translate(48 28)">
@if(Daily && Count>1) { <path transform="translate(@ChartGeometry.Number(Step/2) 0)" d="@ChartGeometry.Line(Expected,Math.Max(0,848-Step),204,Maximum)" class="forecast-line" data-testid="forecast-series" /> } else if(!Daily) { <path d="@ChartGeometry.Band(Lower,Upper,848,204,Maximum)" class="possible-band" data-testid="possible-band" /><path d="@ChartGeometry.Line(Expected,848,204,Maximum)" class="forecast-line" data-testid="forecast-series" /><path d="@ChartGeometry.Line(Actual,848,204,Maximum)" class="actual-line" data-testid="actual-series" /> }
@for(var i=0;i<Count;i++) { var captured=i;var x=X(i); var actual=Actual[i]; if(i==SelectedPlotIndex && !Compact) { <rect x="@ChartGeometry.Number(x-Step/2)" y="0" width="@ChartGeometry.Number(Step)" height="204" fill="var(--selected-column)" /> } if(Daily) { if(Upper[i] is {} upper && Lower[i] is {} lower) { <rect x="@ChartGeometry.Number(x-Step*.3)" y="@ChartGeometry.Number(Y(upper))" width="@ChartGeometry.Number(Step*.6)" height="@ChartGeometry.Number(Math.Max(1,Y(lower)-Y(upper)))" fill="var(--expected-band)" /> } if(actual is {} amount) { <rect x="@ChartGeometry.Number(x-Step*.2)" y="@ChartGeometry.Number(Y(amount))" width="@ChartGeometry.Number(Step*.4)" height="@ChartGeometry.Number(Math.Max(1,204-Y(amount)))" rx="4" fill="var(--solar)" /> } } else if(actual is {} value) { <circle cx="@ChartGeometry.Number(x)" cy="@ChartGeometry.Number(Y(value))" r="@(i==SelectedPlotIndex&&!Compact?5:2)" fill="@(i==SelectedPlotIndex&&!Compact?"var(--surface)":"var(--solar)")" stroke="var(--solar)" stroke-width="2" /> } if(Expected[i] is {} forecast) { <circle cx="@ChartGeometry.Number(x)" cy="@ChartGeometry.Number(Y(forecast))" r="3" fill="var(--surface)" stroke="var(--solar)" stroke-width="1.5" /> } <rect x="@ChartGeometry.Number(x-Step/2)" y="0" width="@ChartGeometry.Number(Step)" height="204" fill="transparent" @onclick="()=>Select(captured)"><title>@Label(i)</title></rect> }
@if(NowX is {} nowX) { <line x1="@ChartGeometry.Number(nowX)" x2="@ChartGeometry.Number(nowX)" y1="0" y2="204" class="chart-cursor" /><g><text x="@ChartGeometry.Number(nowX)" y="-10" text-anchor="middle">@T["Now"]</text></g> }
</g>
@foreach(var i in Ticks) { <g><text x="@ChartGeometry.Number(48+X(i))" y="258" text-anchor="middle">@(Daily?Data.Days[i].Date.ToString("d MMM",T.Culture):T.Time(Hours[i].Timestamp,Data.TimeZoneId,"HH:mm"))</text></g> }
</svg>
@if(Compact) { <div class="toolbar caption">@if(Data.Sunrise is {} rise) { <span>@T["Sunrise"] @T.Time(rise,Data.TimeZoneId,"HH:mm")</span> } @if(Data.Sunset is {} set) { <span>@T["Sunset"] @T.Time(set,Data.TimeZoneId,"HH:mm")</span> }</div> }
}
@code {
 [Parameter] public ProductionViewDto? Data {get;set;}
 [Parameter] public SolarHistoryPeriod Period {get;set;}
 [Parameter] public bool Compact {get;set;}
 [Parameter] public int SelectedIndex {get;set;}
 [Parameter] public EventCallback<int> SelectedIndexChanged {get;set;}
 private ElementReference _svg;
 private double _left,_width=920;
 private bool Daily=>Period!=SolarHistoryPeriod.Today;
 private IReadOnlyList<ProductionHourDto> Hours=>Data?.Hours.Where(h=>TimeZoneInfo.ConvertTime(h.Timestamp,TimeZoneInfo.FindSystemTimeZoneById(Data.TimeZoneId)).Hour is >=5 and <=20).ToArray()??[];
 private double?[] Actual=>Daily?Data!.Days.Select(d=>d.ObservedEnergyKwh).ToArray():Hours.Select(h=>h.ActualKw).ToArray();
 private double?[] Expected=>Daily?Data!.Days.Select(d=>d.ExpectedEnergyKwh).ToArray():Hours.Select(h=>h.ExpectedKw).ToArray();
 private double?[] Lower=>Daily?Data!.Days.Select(d=>d.LowerEnergyKwh).ToArray():Hours.Select(h=>h.LowerKw).ToArray();
 private double?[] Upper=>Daily?Data!.Days.Select(d=>d.UpperEnergyKwh).ToArray():Hours.Select(h=>h.UpperKw).ToArray();
 private int Count=>Actual.Length;
 private double Maximum=>Math.Max(1,Math.Ceiling(Actual.Concat(Upper).Where(v=>v.HasValue).Select(v=>v!.Value).DefaultIfEmpty(1).Max()*1.05));
 private double Step=>848d/Math.Max(1,Count);
 private double X(int i)=>Daily?Step*(i+.5):ChartGeometry.X(i,Count,848);
 private double Y(double v)=>ChartGeometry.Y(v,0,Maximum,204);
 private int SelectedPlotIndex=>Count==0?-1:Daily?Math.Clamp(SelectedIndex,0,Math.Max(0,Count-1)):Hours.ToList().FindIndex(h=>h.Timestamp==Data!.Hours[Math.Clamp(SelectedIndex,0,Data.Hours.Count-1)].Timestamp);
 private ProductionHourDto? SelectedHour=>Data?.Hours.Count>0?Data.Hours[Math.Clamp(SelectedIndex,0,Data.Hours.Count-1)]:null;
 private ProductionDayDto? SelectedDay=>Data?.Days.Count>0?Data.Days[Math.Clamp(SelectedIndex,0,Data.Days.Count-1)]:null;
 private bool SelectedProgress=>!Daily&&Data?.CurrentHour?.Timestamp==SelectedHour?.Timestamp&&SelectedHour is not null;
 private double? SelectedActual=>Daily?SelectedDay?.ObservedEnergyKwh:SelectedProgress&&Data!.CurrentHour is {CoveredSeconds:>0,ObservedEnergyKwh:{} energy} hour?energy*3600/hour.CoveredSeconds:SelectedHour?.ActualKw;
 private double? SelectedExpected=>Daily?SelectedDay?.ExpectedEnergyKwh:SelectedHour?.ExpectedKw;
 private double? SelectedLower=>Daily?SelectedDay?.LowerEnergyKwh:SelectedHour?.LowerKw;
 private double? SelectedUpper=>Daily?SelectedDay?.UpperEnergyKwh:SelectedHour?.UpperKw;
 private string SelectedLabel=>Data is null?"":Daily?SelectedDay?.Date.ToString("d MMM yyyy",T.Culture)??"—":SelectedHour is {} hour?T.Time(hour.Timestamp,Data.TimeZoneId,"d MMM · HH:mm")+"–"+T.Time(hour.Timestamp.AddHours(1),Data.TimeZoneId,"HH:mm zzz"):"—";
 private bool SelectedFuture=>Daily?SelectedDay?.Date>Data?.Today:SelectedHour?.Timestamp>=Clock.GetUtcNow();
 private string StatusText=>SelectedProgress?T["In progress"]:SelectedActual is null?SelectedFuture?(SelectedExpected.HasValue?T["Forecast"]:T["Forecast unavailable"]):T["Unavailable"]:SelectedLower is null||SelectedUpper is null?T["Expected range unavailable"]:SelectedActual<SelectedLower?T["Below"]:SelectedActual>SelectedUpper?T["Above"]:T["In range"];
 private string StatusKind=>SelectedActual is null?"neutral":SelectedLower.HasValue&&SelectedUpper.HasValue&&SelectedActual>=SelectedLower&&SelectedActual<=SelectedUpper?"positive":"warning";
 private IEnumerable<int> Ticks=>Enumerable.Range(0,Math.Min(6,Count)).Select(i=>(int)Math.Round(i*(Count-1d)/Math.Max(1,Math.Min(6,Count)-1))).Distinct();
 private double? NowX=>Daily||Data?.Date!=Data?.Today||Hours.Count<2||Clock.GetUtcNow()<Hours[0].Timestamp||Clock.GetUtcNow()>Hours[^1].Timestamp.AddHours(1)?null:Math.Clamp((Clock.GetUtcNow()-Hours[0].Timestamp).TotalSeconds/(Hours[^1].Timestamp-Hours[0].Timestamp).TotalSeconds*848,0,848);
 private string Label(int i)=>Daily?Data!.Days[i].Date.ToString("d MMM",T.Culture):T.Time(Hours[i].Timestamp,Data!.TimeZoneId,"HH:mm zzz");
 private Task Select(int plot)=>SelectedIndexChanged.InvokeAsync(Daily?plot:Data!.Hours.ToList().FindIndex(h=>h.Timestamp==Hours[plot].Timestamp));
 private async Task PointerDown(PointerEventArgs e){await Measure();await Pointer(e);}
 private Task Pointer(PointerEventArgs e)=>Count==0?Task.CompletedTask:Select(Daily?Math.Clamp((int)Math.Floor(((e.ClientX-_left)/_width*920-48)/Step),0,Count-1):ChartGeometry.Select((e.ClientX-_left)/_width*920-48,848,Count));
 private Task KeyDown(KeyboardEventArgs e)=>Count>0&&e.Key is "ArrowLeft" or "ArrowRight"?Select(Math.Clamp(SelectedPlotIndex+(e.Key=="ArrowLeft"?-1:1),0,Math.Max(0,Count-1))):Task.CompletedTask;
 protected override async Task OnAfterRenderAsync(bool first){if(first)await Measure();}
 private async Task Measure(){try{var bounds=await JS.InvokeAsync<double[]>("smartSolar.bounds",_svg);if(bounds?.Length==2&&bounds[1]>0){_left=bounds[0];_width=bounds[1];}}catch(JSException){} }
}
