@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@using SolarManagement.Integrations.Contracts
@inject IIntegrationProviderCatalog Catalog
@inject IntegrationSetupService Setup
@inject IServiceProvider Services
@inject AuthenticationStateProvider Authentication
@inject IntegrationChangeNotifier Changes
@inject DeyeSolar.Web.Data.CurrentInstallation Installation
@implements IDisposable
@if(!_flowOpen&&!string.IsNullOrWhiteSpace(_notice)){<div class="banner" role="status">@T.Translate(_notice)</div>}@if(!_flowOpen&&!string.IsNullOrWhiteSpace(_error)){<div class="banner critical" role="alert">@T.Translate(_error)</div>}
<div class="two-columns"><UiCard Title="@T["Add a connection"]"><p class="caption">@T["Connect an account, verify access, save its settings and choose devices. Connection checks never switch a device."]</p><UiButton Variant="primary" OnClick="OpenFlow" Disabled="_busy">@T["Connect a service"]</UiButton></UiCard><UiCard Title="@T["Saved connections"]"><div class="form-stack">@foreach(var instance in _instances){<UiButton Variant="@(instance.Id==_selected?"strong":"outline")" OnClick="()=>Select(instance.Id)" Disabled="_busy">@instance.Name · @T[instance.Status=="enabled"?"Enabled":"Not connected"]</UiButton>@if(instance.Status=="enabled"&&(!_forms.TryGetValue(instance.Id,out var savedForm)||!Supported(savedForm.Provider))){<UiButton Variant="critical" OnClick="()=>DisableInstance(instance)" Disabled="_busy">@T.Format("Disconnect {0}",instance.Name)</UiButton>}}</div></UiCard></div>
@if(_flowOpen){<UiModal Title="@T["Connect a service"]" OnClose="RequestCloseFlow" CanClose="@(!_busy)"><div class="form-stack"><p class="caption">@T.Format("Step {0} of 3",!_flowCreated?1:Current?.Discovery is not null?3:2) · @T[!_flowCreated?"Choose a manufacturer":Current?.Discovery is not null?"Choose devices":"Connection settings"]</p>@if(_notice is not null){<p class="banner" role="status">@T.Translate(_notice)</p>}@if(_error is not null){<p class="banner critical" role="alert">@T.Translate(_error)</p>}
@if(!_flowCreated){@foreach(var kind in new[]{"inverter","socket","other"}){var providers=_providers.Where(provider=>kind=="other"?!IntegrationProviderKinds.Supports(provider,"inverter")&&!IntegrationProviderKinds.Supports(provider,"socket"):IntegrationProviderKinds.Supports(provider,kind)).ToArray();if(providers.Length>0){<section class="form-stack"><h3>@T[kind=="inverter"?"Inverter manufacturer":kind=="socket"?"Smart plug manufacturer":"Other provider"]</h3><div class="provider-grid">@foreach(var provider in providers){<UiButton Variant="@(provider.ProviderId==_newProvider?"strong":"outline")" Class="provider-choice" OnClick="()=>ChooseProvider(provider.ProviderId,kind)" Disabled="@(_busy||!Supported(provider))" aria-pressed="@((provider.ProviderId==_newProvider).ToString().ToLowerInvariant())"><span class="provider-monogram" aria-hidden="true">@Monogram(provider.DisplayName)</span><span>@provider.DisplayName</span></UiButton>}</div></section>}}@if(_providers.Count==0){<p class="caption">@T["No provider packages are installed. Ask the platform operator to install a supported provider."]</p>}<div class="ui-field"><label for="connection-name">@T["Connection name"]</label><input id="connection-name" @bind="_newName" disabled="@_busy" maxlength="100"/></div><div class="form-actions"><UiButton Variant="outline" OnClick="RequestCloseFlow" Disabled="_busy">@T["Cancel"]</UiButton><UiButton Variant="primary" OnClick="Create" Disabled="@(_busy||string.IsNullOrWhiteSpace(_newProvider)||string.IsNullOrWhiteSpace(_newName))">@T["Add connection"]</UiButton></div>}
else{@Editor}<div class="form-actions">@if(_flowCreated){<UiButton Variant="outline" OnClick="RequestCloseFlow" Disabled="_busy">@T["Close"]</UiButton>}</div></div></UiModal>}else{@Editor}
@if(_confirmFlowClose){<UiModal Title="@T["Discard changes?"]" OnClose="()=>_confirmFlowClose=false"><p>@T["Your unsaved changes will be discarded."]</p><div class="form-actions"><UiButton Variant="outline" OnClick="()=>_confirmFlowClose=false">@T["Keep editing"]</UiButton><UiButton Variant="critical" OnClick="DiscardAndCloseFlow" Disabled="_busy">@T["Discard changes"]</UiButton></div></UiModal>}


<UnsavedChangesGuard Dirty="@(!_busy&&_forms.Values.Any(f=>f.Dirty))"/>
@code {
    private RenderFragment Editor => @<text>@if(Current is {} form){<UiCard Title="@form.Configuration.Instance.Name"><div class="form-stack"><p class="caption">@form.Provider.DisplayName</p>@if(form.Provider.ProviderId.Contains("shelly",StringComparison.OrdinalIgnoreCase)){<p class="field-hint">@T["In Shelly Cloud, open User settings → Authorization cloud key."]</p>}
@if(_actor.IsInRole("PlatformOperator")){<details><summary>@T["Platform provider version"]</summary><div class="form-stack"><div class="ui-field"><label>@T["Installed provider version"]</label><select value="@form.TargetPackageVersion" @onchange="e=>form.TargetPackageVersion=e.Value?.ToString()??string.Empty" disabled="@_busy">@foreach(var version in form.Versions){<option value="@version.PackageVersion" disabled="@(!Supported(version))">@version.PackageVersion</option>}</select></div><p class="caption">@T["Switching verifies saved settings. A successful switch discards the current draft."]</p><UiButton Variant="outline" OnClick="SwitchVersion" Disabled="@(_busy||form.TargetPackageVersion==form.Configuration.Instance.PackageVersion||!form.Versions.Any(v=>v.PackageVersion==form.TargetPackageVersion&&Supported(v)))">@T["Use selected version (discard draft)"]</UiButton></div></details>}
@if(!Supported(form.Provider)){<div class="banner">@T["This provider requires a newer settings interface."]</div>@if(form.Configuration.Instance.Status=="enabled"){<UiButton Variant="critical" OnClick="ToggleEnabled" Disabled="_busy">@T["Disconnect"]</UiButton>}}
else{var step=Steps(form)[form.StepIndex];var publicValues=PublicValues(form);@if(form.Provider.UiLayout is not null){<h3>@T.Format("Step {0} of {1}",form.StepIndex+1,Steps(form).Count) · @T.Translate(step.Title)</h3>@if(step.Instructions is not null){<p class="caption" style="white-space:pre-wrap">@T.Translate(step.Instructions)</p>}}
@foreach(var group in step.Groups.Where(g=>IntegrationUiConditions.IsActive(g.ActiveWhen,publicValues))){@if(group.Id.StartsWith("advanced",StringComparison.OrdinalIgnoreCase)||group.Title=="Advanced"){<details><summary>@T["Advanced"]</summary>@GroupContent(form,group)</details>}else{@GroupContent(form,group)}}
<div class="form-actions">@if(form.StepIndex>0){<UiButton Variant="outline" OnClick="PreviousStep" Disabled="_busy">@T["Previous step"]</UiButton>}@if(form.StepIndex+1<Steps(form).Count){<UiButton Variant="primary" OnClick="NextStep" Disabled="_busy">@T["Next step"]</UiButton>}else{<UiButton Variant="primary" OnClick="Save" Disabled="_busy">@T["Save connection"]</UiButton>}</div><div class="form-actions"><UiButton Variant="quiet" OnClick="ReloadSaved" Disabled="_busy">@T["Discard draft"]</UiButton><UiButton Variant="@(form.Configuration.Instance.Status=="enabled"?"critical":"outline")" OnClick="ToggleEnabled" Disabled="@(_busy||(form.Configuration.Instance.Status!="enabled"&&form.Dirty))">@T[form.Configuration.Instance.Status=="enabled"?"Disconnect":"Enable connection"]</UiButton></div>
@foreach(var binding in form.Bindings){<div class="selection-card"><h3>@(binding.DisplayName??binding.Name)</h3><StatusPill Dot="false">@T[binding.IsDefault?"Primary inverter":"Selected device"]</StatusPill>@if(binding.Kind=="socket"){<p class="caption">@T["Battery source and circuit are managed on the device page."]</p><UiButton Href="@("/devices/"+Uri.EscapeDataString(binding.Id.ToString()))">@T["Open device"]</UiButton>}</div>}
}</div></UiCard>}else{<UiCard><UiState Title="@T["Choose a saved connection"]" Message="@T["Or add a connection using an installed manufacturer."]"/></UiCard>}</text>;
    private RenderFragment GroupContent(FormState form,IntegrationUiGroup group)=>@<text><section class="form-stack">@if(form.Provider.UiLayout is not null){<h3>@T.Translate(group.Title)</h3>@if(group.Instructions is not null){<p class="caption" style="white-space:pre-wrap">@T.Translate(group.Instructions)</p>}}
@foreach(var field in form.Provider.Fields.Where(f=>group.FieldKeys.Contains(f.Key)&&IntegrationUiConditions.IsFieldActive(form.Provider,f,PublicValues(form)))){<IntegrationFieldInput @key="field.Key" Field="field" Value="@TextValue(field.Key)" ValueChanged="v=>SetText(field.Key,v)" SecretAction="@SecretAction(field.Key)" SecretActionChanged="v=>SetSecretAction(field.Key,v)" SecretValue="@SecretValue(field.Key)" SecretValueChanged="v=>SetSecretValue(field.Key,v)" SecretPresent="@(form.Configuration.SecretPresent.GetValueOrDefault(field.Key)||form.OAuthSecretPresent.GetValueOrDefault(field.Key))" Busy="_busy"/>}
<div class="form-actions">@if(group.Actions.Contains("test")){<UiButton Variant="outline" OnClick="Test" Disabled="_busy">@T["Check connection"]</UiButton>}@if(group.Actions.Contains("discover")){<UiButton Variant="outline" OnClick="Discover" Disabled="_busy">@T["Find devices"]</UiButton>}@if(group.Actions.Contains("oauth")){<UiButton Variant="outline" OnClick="StartAuthorization" Disabled="_busy">@T["Authorize provider account"]</UiButton>}</div>
@if(group.Actions.Contains("oauth")&&form.Authorization is {} authorization){@if(form.AuthorizationStale){<div class="banner">@T["The draft changed. Start authorization again before using its result."]</div>}else if(form.AuthorizationStatus=="pending"&&SafeAuthorizationUrl(authorization.AuthorizationUrl)){<a class="ui-button strong" href="@authorization.AuthorizationUrl" target="_blank" rel="noopener noreferrer">@T["Open provider authorization"]</a>}<p class="caption">@T["Authorization status:"] @T.Translate(form.AuthorizationStatus)</p><div class="form-actions"><UiButton Variant="outline" OnClick="CheckAuthorization" Disabled="@(_busy||form.AuthorizationStale)">@T["Check authorization"]</UiButton><UiButton Variant="quiet" OnClick="CancelAuthorization" Disabled="_busy">@T["Cancel authorization"]</UiButton></div>}
@if(group.Actions.Contains("discover")){<p class="caption">@T["Save before choosing a discovered device. Unsaved changes remain a draft."]</p>@if(_billingAccess is {SocketLimit:1}){<div class="banner">@T["Your free month includes 1 smart plug. Additional plugs require Premium."] · @T["Selected plugs"]: @_billingAccess.SocketUsage</div>}@if(_billingUnavailable){<p class="banner critical" role="alert">@T["Account access"]: @T["Unavailable"]</p>}@foreach(var device in form.Discovery?.Devices??[]){var nameId="discovered-device-name-"+(form.Discovery!.Devices.ToList().IndexOf(device));var canSwitch=IntegrationDiscoveryPresentation.CanSwitch(device);<div class="selection-card"><h3>@device.Name</h3><p class="caption">@T[device.Kind=="inverter"?"Inverter":"Smart plug"] @(device.Channel.Length>0?"· "+device.Channel:"")</p><div class="gallery-controls"><StatusPill Kind="neutral">@T["Availability"]: @T["Unknown"]</StatusPill>@if(device.Kind=="socket"&&canSwitch==false){<StatusPill Kind="warning">@T["This device does not support switching."]</StatusPill>}@if(IntegrationDiscoveryPresentation.AlreadySelected(device,form.Bindings)){<StatusPill Kind="positive">@T["Selected"]</StatusPill>}@if(RequiresPremium(form,device)){<StatusPill Kind="warning">@T["Premium"]</StatusPill>}</div><div class="ui-field"><label for="@nameId">@T["Name in SmartSolar"]</label><input id="@nameId" value="@_deviceNames.GetValueOrDefault(device.SelectionToken)" placeholder="@device.Name" maxlength="80" @oninput="change=>DeviceName(device.SelectionToken,change)" disabled="@_busy"/><p class="field-hint">@T.Format("Provider name: {0}. Renaming changes only its display name; rules stay connected.",device.Name)</p></div><UiButton Variant="outline" OnClick="()=>ChooseDevice(device.SelectionToken)" Disabled="@SelectionBlocked(form,device)">@T["Use device"]</UiButton></div>}}</section></text>;
    private bool _flowOpen,_flowCreated,_confirmFlowClose;
    private Guid? _flowPreviousSelection;
    private DeyeSolar.Domain.Billing.BillingAccess? _billingAccess;
    private bool _billingUnavailable;
    private readonly Dictionary<string,string> _deviceNames=new(StringComparer.Ordinal);
    private void OpenFlow(){if(_busy)return;_flowPreviousSelection=_selected;_flowOpen=true;_flowCreated=false;_newProvider=_newName="";_notice=_error=null;}
    private void RequestCloseFlow(){if(_busy)return;if(_flowCreated&&Current?.Dirty==true)_confirmFlowClose=true;else FinishFlow();}
    private void FinishFlow(){_flowOpen=_flowCreated=_confirmFlowClose=false;if(_flowPreviousSelection.HasValue)_selected=_flowPreviousSelection;_flowPreviousSelection=null;}
    private Task DiscardAndCloseFlow()=>Run(async()=>{if(_flowCreated&&_selected is {} id){_forms.Remove(id);await SelectCore(id);}FinishFlow();});
    private static string Monogram(string name)=>string.IsNullOrWhiteSpace(name)?"?":StringInfo.GetNextTextElement(name.Trim()).ToUpperInvariant();
    private void DeviceName(string token,ChangeEventArgs change){if(!_busy)_deviceNames[token]=change.Value?.ToString()??"";}
    private bool RequiresPremium(FormState form,IntegrationDiscoveryDevice device)=>IntegrationDiscoveryPresentation.RequiresPremium(_billingAccess,device,form.Bindings);
    private bool SelectionBlocked(FormState form,IntegrationDiscoveryDevice device)=>_busy||form.Dirty||_billingUnavailable||_billingAccess is {HasAccess:false}||RequiresPremium(form,device)||!DeyeSolar.Web.Services.DeviceNameService.TryName(_deviceNames.GetValueOrDefault(device.SelectionToken),out _);
    private async Task LoadBilling(){var billing=Services.GetService<DeyeSolar.Web.Billing.IBillingAccessReader>();if(billing is null)return;try{var result=await billing.ReadAsync(_actor.FindFirstValue(ClaimTypes.NameIdentifier)??"",_lifetime.Token);if(!_disposed){_billingAccess=result;_billingUnavailable=false;}}catch(Exception)when(!_disposed){_billingUnavailable=true;}}

    private IReadOnlyList<IntegrationProviderDescriptor> _providers = [];
    private IReadOnlyList<IntegrationInstanceDto> _instances = [];
    private readonly Dictionary<Guid, FormState> _forms = [];
    private string _newProvider = "";
    private string _newInverterProvider = "";
    private string _newSocketProvider = "";
    private string _newName = "";
    private IReadOnlyList<IntegrationSourceInverterDto> _sourceInverters = [];
    private readonly Dictionary<Guid, Guid?> _sourceDrafts = [];
    private readonly Dictionary<Guid, int> _phaseDrafts = [];
    private Guid? _selected;
    private bool _busy;
    private bool _disposed;
    private bool _catalogUnavailable = true;
    private readonly CancellationTokenSource _lifetime = new();
    private string? _error;
    private string? _notice;
    private ClaimsPrincipal _actor = new();
    private FormState? Current => _selected.HasValue ? _forms.GetValueOrDefault(_selected.Value) : null;
    private static bool Supported(IntegrationProviderDescriptor provider)
    {
        try { IntegrationDescriptorValidator.Validate(provider); return true; }
        catch (InvalidDataException) { return false; }
    }
    protected override async Task OnInitializedAsync()
    {
        _actor = (await Authentication.GetAuthenticationStateAsync()).User;
        Changes.Changed += OnChanged;
        await Run(async () => { await LoadCatalog(); await LoadBilling(); if (_instances.Count > 0) await SelectCore(_instances[0].Id); });
    }
    private void OnChanged(string installation, Guid instance)
    {
        if (_disposed || installation.Length > 0 && installation != Installation.Id) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            try
            {
                await LoadCatalog();
                if (Current?.Dirty == true) _notice = T["The integration catalog changed. Your draft is preserved; save may require reloading the settings."];
            }
            catch (Exception) { _error = T["The provider catalog could not be refreshed. Your draft is preserved."]; }
            StateHasChanged();
        });
    }
    private async Task LoadCatalog()
    {
        _instances = await Setup.ListAsync(_lifetime.Token);
        _sourceInverters = await Setup.SocketSourceOptionsAsync(_lifetime.Token);
        _catalogUnavailable = true;
        _providers = await Catalog.GetProvidersAsync(_lifetime.Token);
        _catalogUnavailable = false;
        var forms = _forms.Values.ToArray();
        var versions = await Task.WhenAll(forms.Select(form => Catalog.GetVersionsAsync(form.Configuration.Instance.ProviderId, _lifetime.Token)));
        for (var index = 0; index < forms.Length; index++) forms[index].Versions = versions[index];
    }
    private void ChooseInverter(ChangeEventArgs e)=>ChooseProvider(e.Value?.ToString()??"","inverter");
    private void ChooseSocket(ChangeEventArgs e)=>ChooseProvider(e.Value?.ToString()??"","socket");
    private void ChooseOther(ChangeEventArgs e)=>ChooseProvider(e.Value?.ToString()??"","other");
    private void ChooseProvider(string value, string kind)
    {
        _newProvider = value;
        _newInverterProvider = kind == "inverter" ? value : "";
        _newSocketProvider = kind == "socket" ? value : "";
        _newName = _providers.FirstOrDefault(provider => provider.ProviderId == value)?.DisplayName ?? "";
    }
    private Guid? SourceDraft(IntegrationBindingDto binding) => _sourceDrafts.TryGetValue(binding.Id, out var value) ? value : binding.SourceInverterId;
    private int PhaseDraft(IntegrationBindingDto binding) => _phaseDrafts.GetValueOrDefault(binding.Id, binding.PhaseCount);
    private Task SaveSocketSource(IntegrationBindingDto binding) => Run(async () =>
    {
        var form = Current!;
        var instance = form.Configuration.Instance;
        var result = await Setup.SetSocketSourceAsync(instance.Id, binding.Id, new(new(instance.Revision, instance.PackageVersion,
            instance.PackageDigest, instance.DescriptorDigest), SourceDraft(binding), PhaseDraft(binding), binding.SourceInverterId, binding.PhaseCount), _actor, _lifetime.Token);
        form.Bindings = form.Bindings.Select(device => device.Id == result.Id ? result : device).ToArray();
        _sourceDrafts.Remove(binding.Id);
        _phaseDrafts.Remove(binding.Id);
        form.Configuration = form.Configuration with { Instance = (await Setup.ReadAsync(instance.Id, _lifetime.Token)).Instance };
        await LoadCatalog();
        _notice = T["Socket inverter link saved."];
    });
    private Task RefreshCatalog() => Run(async () => { await LoadCatalog(); _notice = T["Provider catalog refreshed. Existing drafts are preserved."]; });
    private Task Create() => Run(async () =>
    {
        var instance = await Setup.CreateAsync(new(_newProvider, _newName), _actor, _lifetime.Token);
        await LoadCatalog();
        await SelectCore(instance.Id);
        _newName = "";
        if(_flowOpen)_flowCreated=true;
        _notice = T["Integration added. Enter its connection settings."];
    });
    private Task Select(Guid id) => Run(async () => { await SelectCore(id); _notice = null; });
    public async Task OpenSavedAsync(Guid id, string action = "settings")
    {
        if (_busy || _flowOpen || _disposed) return;
        await Run(async () =>
        {
            var previous = _selected;
            await SelectCore(id);
            _flowPreviousSelection = previous;
            _flowOpen = _flowCreated = true;
            _notice = null;
            StateHasChanged();
            if (action == "test")
                _notice = (await Setup.TestAsync(id, Draft(), _actor, _lifetime.Token)).Message;
            else if (action == "discover")
            {
                _deviceNames.Clear();
                Current!.Discovery = await Setup.DiscoverAsync(id, Draft(), _actor, _lifetime.Token);
                _notice = T["Choose a device explicitly after saving its connection settings."];
            }
        });
        if (!_disposed) StateHasChanged();
    }
    private async Task SelectCore(Guid id)
    {
        if (!_forms.ContainsKey(id))
        {
            var configuration = await Setup.ReadAsync(id, _lifetime.Token);
            var provider = await Catalog.GetAsync(configuration.Instance.ProviderId, configuration.Instance.PackageVersion, _lifetime.Token);
            _forms[id] = new(configuration, provider) { Bindings = await Setup.DevicesAsync(id, _lifetime.Token),
                Versions = await Catalog.GetVersionsAsync(configuration.Instance.ProviderId, _lifetime.Token) };
        }
        _selected = id;
    }
    private string TextValue(string key) => Current?.Values.GetValueOrDefault(key) ?? "";
    private void SetText(string key, string value) { if (Current is { } f) { f.Values[key] = value; f.EditedFields.Add(key); f.Dirty = true; InvalidateAuthorization(f); } }
    private string SecretAction(string key) => Current?.Secrets.GetValueOrDefault(key)?.Operation ?? "keep";
    private string SecretValue(string key) => Current?.Secrets.GetValueOrDefault(key)?.Value ?? "";
    private void SetSecretAction(string key, string operation) { if (Current is { } f) { f.Secrets[key] = new(operation); f.Dirty = true; InvalidateAuthorization(f); } }
    private void SetSecretValue(string key, string value) { if (Current is { } f) { f.Secrets[key] = new("replace", value); f.Dirty = true; InvalidateAuthorization(f); } }
    private static void InvalidateAuthorization(FormState form)
    {
        if (form.Authorization is null) return;
        form.AuthorizationStale = true;
        form.OAuthFlowId = null;
        form.OAuthSecretPresent.Clear();
    }
    private IReadOnlyList<IntegrationUiStep> Steps(FormState form) => form.Provider.UiLayout?.Steps
        ?? [new("settings", T["Connection settings"], null, [new("settings", T["Connection settings"], null, form.Provider.Fields.Select(field => field.Key).ToArray(), form.Provider.Actions)])];
    private static JsonElement PublicValues(FormState form)
    {
        var values = new Dictionary<string, JsonElement>(StringComparer.Ordinal);
        foreach (var field in form.Provider.Fields.Where(field => !IntegrationUiConditions.IsSecret(field)))
        {
            if (!form.Values.TryGetValue(field.Key, out var text)) continue;
            if (!form.EditedFields.Contains(field.Key) && form.Configuration.Values.TryGetValue(field.Key, out var saved))
            { values[field.Key] = saved.Clone(); continue; }
            if (field.Kind is "number" or "integer")
                values[field.Key] = decimal.TryParse(text, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var number)
                    ? IntegrationJson.Element(number) : IntegrationJson.Element<string?>(null);
            else if (field.Kind == "boolean") values[field.Key] = text is "true" or "false" ? IntegrationJson.Element(text == "true") : IntegrationJson.Element<string?>(null);
            else values[field.Key] = field.Kind == "select" && text.Length == 0 ? IntegrationJson.Element<string?>(null) : IntegrationJson.Element(text);
        }
        return IntegrationUiConditions.EffectiveValues(form.Provider, IntegrationJson.Element(values));
    }
    private Task PreviousStep() => Run(() => { Current!.StepIndex--; return Task.CompletedTask; });
    private Task NextStep() => Run(() =>
    {
        var form = Current!;
        var values = PublicValues(form);
        var keys = Steps(form)[form.StepIndex].Groups.SelectMany(group => group.FieldKeys).ToHashSet(StringComparer.Ordinal);
        foreach (var field in form.Provider.Fields.Where(field => keys.Contains(field.Key) && IntegrationUiConditions.IsFieldActive(form.Provider, field, values)))
        {
            if (IntegrationUiConditions.IsSecret(field))
            {
                var operation = form.Secrets.GetValueOrDefault(field.Key);
                var present = operation?.Operation == "replace" ? !string.IsNullOrWhiteSpace(operation.Value)
                    : operation?.Operation != "clear" && (form.Configuration.SecretPresent.GetValueOrDefault(field.Key) || form.OAuthSecretPresent.GetValueOrDefault(field.Key));
                if (field.Required && !present) throw new IntegrationRequestException("validation", T.Format("Enter or authorize {0}.", T.Translate(field.Label)));
            }
            else
            {
                var present = values.TryGetProperty(field.Key, out var value) && value.ValueKind is not (JsonValueKind.Null or JsonValueKind.Undefined)
                    && (value.ValueKind != JsonValueKind.String || !string.IsNullOrWhiteSpace(value.GetString()));
                if (field.Required && !present) throw new IntegrationRequestException("validation", T.Format("Enter {0}.", T.Translate(field.Label)));
                if (present)
                    try { IntegrationDescriptorValidator.ValidateValue(field, value); }
                    catch (InvalidDataException) { throw new IntegrationRequestException("validation", T.Format("Check {0}.", T.Translate(field.Label))); }
            }
        }
        form.StepIndex++;
        return Task.CompletedTask;
    });
    private IntegrationConfigurationChange Draft()
    {
        var form = Current ?? throw new InvalidOperationException();
        var values = new Dictionary<string, JsonElement>(StringComparer.Ordinal);
        foreach (var field in form.Provider.Fields.Where(f => !f.Secret && f.Kind != "secret"))
        {
            var required = field.Required && IntegrationUiConditions.IsFieldActive(form.Provider, field, PublicValues(form));
            if (!required && !form.Values.ContainsKey(field.Key)) continue;
            if (!form.EditedFields.Contains(field.Key) && form.Configuration.Values.TryGetValue(field.Key, out var saved))
            { values[field.Key] = saved.Clone(); continue; }
            var text = form.Values.GetValueOrDefault(field.Key) ?? "";
            if (field.Kind == "select" && text.Length == 0)
            { values[field.Key] = IntegrationJson.Element<string?>(null); continue; }
            if (field.Kind is "number" or "integer")
            {
                if (text.Length == 0) { values[field.Key] = IntegrationJson.Element<string?>(null); continue; }
                if (!decimal.TryParse(text, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var number))
                    throw new IntegrationRequestException("validation", T.Format("Enter a number for {0}.", T.Translate(field.Label)));
                values[field.Key] = IntegrationJson.Element(number);
            }
            else values[field.Key] = field.Kind == "boolean"
                ? text is "true" or "false" ? IntegrationJson.Element(text == "true") : IntegrationJson.Element<string?>(null)
                : IntegrationJson.Element(text);
        }
        var instance = form.Configuration.Instance;
        return new(instance.Revision, instance.PackageVersion, instance.PackageDigest, instance.DescriptorDigest, values, new(form.Secrets, StringComparer.Ordinal), form.OAuthFlowId);
    }
    private static bool SafeAuthorizationUrl(string value) => Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && uri.Scheme == Uri.UriSchemeHttps && string.IsNullOrEmpty(uri.UserInfo);
    private Task StartAuthorization() => Run(async () =>
    {
        var form = Current!;
        if (form.Authorization is { } previous)
            await Setup.CancelAuthorizationAsync(form.Configuration.Instance.Id, previous.FlowId, _actor, _lifetime.Token);
        form.Authorization = null;
        form.OAuthFlowId = null;
        form.OAuthSecretPresent.Clear();
        form.Authorization = await Setup.StartAuthorizationAsync(form.Configuration.Instance.Id, new(Draft(), "web"), _actor, _lifetime.Token);
        form.AuthorizationStale = false;
        form.AuthorizationStatus = "pending";
        _notice = T["Open provider authorization in a new tab, then return here and check its result. Settings are saved only when you choose Save."];
    });
    private Task CheckAuthorization() => Run(async () =>
    {
        var form = Current!;
        if (form.Authorization is not { } authorization || form.AuthorizationStale) return;
        var result = await Setup.AuthorizationStatusAsync(form.Configuration.Instance.Id, authorization.FlowId, _actor, _lifetime.Token);
        form.AuthorizationStatus = result.Status;
        if (result.Status == "ready")
        {
            foreach (var (key, value) in result.Values) { form.Values[key] = DisplayValue(value); form.EditedFields.Add(key); }
            form.OAuthSecretPresent = new(result.SecretPresent, StringComparer.Ordinal);
            foreach (var key in form.Provider.OAuthDefinition!.SecretFieldKeys) form.Secrets[key] = new("keep");
            form.OAuthFlowId = result.FlowId;
            form.Dirty = true;
            form.Discovery = null;
            _notice = T["Authorization is ready in this draft. Test the connection and save explicitly to use it."];
        }
        else { form.OAuthFlowId = null; form.OAuthSecretPresent.Clear(); _notice = T.Format("Authorization status: {0}.", T.Translate(result.Status)); }
    });
    private Task CancelAuthorization() => Run(async () =>
    {
        var form = Current!;
        if (form.Authorization is not { } authorization) return;
        await Setup.CancelAuthorizationAsync(form.Configuration.Instance.Id, authorization.FlowId, _actor, _lifetime.Token);
        form.Authorization = null;
        form.OAuthFlowId = null;
        form.OAuthSecretPresent.Clear();
        _notice = T["Authorization cancelled. Saved credentials were not changed."];
    });
    private static string DisplayValue(JsonElement value) => value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined ? ""
        : value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText();
    private Task Save() => Run(async () =>
    {
        var current = Current!;
        var result = await Setup.SaveAsync(current.Configuration.Instance.Id, Draft(), _actor, _lifetime.Token);
        _forms[result.Instance.Id] = new(result, current.Provider) { Bindings = current.Bindings, Versions = current.Versions };
        _notice = T["Settings saved. Credentials remain on the server."];
        await LoadCatalog();
    });
    private Task Test() => Run(async () => { var result = await Setup.TestAsync(Current!.Configuration.Instance.Id, Draft(), _actor, _lifetime.Token); _notice = result.Message; });
    private Task Discover() => Run(async () => { _deviceNames.Clear();Current!.Discovery = await Setup.DiscoverAsync(Current.Configuration.Instance.Id, Draft(), _actor, _lifetime.Token); _notice = T["Choose a device explicitly after saving its connection settings."]; });
    private Task ChooseDevice(string token)
    {
        var form = Current;
        var device = form?.Discovery?.Devices.FirstOrDefault(device => device.SelectionToken == token);
        if (form is null || device is null || SelectionBlocked(form, device)) return Task.CompletedTask;
        return Run(async () =>
        {
        await Setup.SelectDeviceAsync(form.Configuration.Instance.Id, new(Draft(), token,_deviceNames.GetValueOrDefault(token)), _actor, _lifetime.Token);
        if(_flowCreated&&form.Configuration.Instance.Status!="enabled"){var instance=form.Configuration.Instance;await Setup.SetEnabledAsync(instance.Id,true,new(instance.Revision,instance.PackageVersion,instance.PackageDigest,instance.DescriptorDigest),_actor,_lifetime.Token);form.Configuration=await Setup.ReadAsync(instance.Id,_lifetime.Token);}
        form.Bindings = await Setup.DevicesAsync(form.Configuration.Instance.Id, _lifetime.Token);
        await LoadBilling();
        _notice = form.Configuration.Instance.Status=="enabled"?T["Device connected."]:T["Selected"];
        });
    }
    private Task ToggleEnabled() => Run(async () =>
    {
        var form = Current!;
        var instance = form.Configuration.Instance;
        await Setup.SetEnabledAsync(instance.Id, instance.Status != "enabled", new(instance.Revision, instance.PackageVersion, instance.PackageDigest, instance.DescriptorDigest), _actor, _lifetime.Token);
        form.Configuration = await Setup.ReadAsync(instance.Id, _lifetime.Token);
        await LoadCatalog();
        _notice = form.Configuration.Instance.Status == "enabled" ? T["Integration enabled."] : T["Integration disabled."];
    });
    private Task DisableInstance(IntegrationInstanceDto instance) => Run(async () =>
    {
        var result = await Setup.SetEnabledAsync(instance.Id, false,
            new(instance.Revision, instance.PackageVersion, instance.PackageDigest, instance.DescriptorDigest), _actor, _lifetime.Token);
        if (_forms.TryGetValue(instance.Id, out var form)) form.Configuration = form.Configuration with { Instance = result };
        _notice = T["Integration disabled. Your draft is preserved."];
        await LoadCatalog();
    });
    private Task ReloadSaved() => Run(async () =>
    {
        if (_selected is not { } id) return;
        _forms.Remove(id);
        await SelectCore(id);
        _notice = T["Saved settings loaded."];
    });
    private Task SwitchVersion() => Run(async () =>
    {
        var form = Current!;
        var instance = form.Configuration.Instance;
        await Setup.SwitchPackageAsync(instance.Id, new(new(instance.Revision, instance.PackageVersion,
            instance.PackageDigest, instance.DescriptorDigest), form.TargetPackageVersion), _actor, _lifetime.Token);
        _forms.Remove(instance.Id);
        await LoadCatalog();
        await SelectCore(instance.Id);
        _notice = T["Provider version changed. Saved settings loaded and the draft discarded."];
    });
    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try { await action(); }
        catch (IntegrationRequestException ex) { _error = ex.Message; }
        catch (Exception) { _error = T["Integration settings are temporarily unavailable. Please try again."]; }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; Changes.Changed -= OnChanged; _lifetime.Cancel(); }
    private sealed class FormState(IntegrationConfigurationDto configuration, IntegrationProviderDescriptor provider)
    {
        public IntegrationConfigurationDto Configuration { get; set; } = configuration;
        public IntegrationProviderDescriptor Provider { get; } = provider;
        public string TargetPackageVersion { get; set; } = configuration.Instance.PackageVersion;
        public IReadOnlyList<IntegrationProviderDescriptor> Versions { get; set; } = [];
        public Dictionary<string, string> Values { get; } = IntegrationUiConditions.EffectiveValues(provider, IntegrationJson.Element(configuration.Values))
            .EnumerateObject().ToDictionary(p => p.Name, p => DisplayValue(p.Value), StringComparer.Ordinal);
        public Dictionary<string, IntegrationSecretOperation> Secrets { get; } = new(StringComparer.Ordinal);
        public HashSet<string> EditedFields { get; } = new(StringComparer.Ordinal);
        public int StepIndex { get; set; }
        public IntegrationOAuthStartDto? Authorization { get; set; }
        public string AuthorizationStatus { get; set; } = "pending";
        public bool AuthorizationStale { get; set; }
        public Guid? OAuthFlowId { get; set; }
        public Dictionary<string, bool> OAuthSecretPresent { get; set; } = new(StringComparer.Ordinal);
        public bool Dirty { get; set; }
        public IntegrationDiscoveryResponse? Discovery { get; set; }
        public IReadOnlyList<IntegrationBindingDto> Bindings { get; set; } = [];
    }
}
