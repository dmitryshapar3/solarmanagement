@using System.Globalization

<section class="inverter-readings" aria-label="Deye inverter readings">
    <h2>Energy flows</h2>
    <dl class="inverter-metrics">
        <div><dt>Solar generation</dt><dd data-testid="inverter-pv">@(Data is { SolarObservedAt: { } observed, SolarProduction: >= 0 } && observed <= (Now ?? DateTimeOffset.UtcNow) ? Number(Data.SolarProduction / 1000d) : "—") kW</dd></div>
        <div><dt>Load</dt><dd>@Watts(Data?.LoadPower) W</dd></div>
        <div><dt>Grid</dt><dd>@Watts(Data?.GridConsumption) W</dd><span>@(Data is null ? "Awaiting reading" : Data.GridConsumption < 0 ? "Exporting" : Data.GridConsumption > 0 ? "Importing" : "Idle")</span></div>
        <div><dt>@(Data is null ? "Battery power" : Data.BatteryPower < 0 ? "Battery charging" : Data.BatteryPower > 0 ? "Battery discharging" : "Battery idle")</dt><dd data-testid="inverter-battery-power">@Watts(Data?.BatteryPower) W</dd></div>
    </dl>
    <h2>Battery details</h2>
    <dl class="inverter-metrics">
        <div><dt>Battery SOC</dt><dd>@(Data?.BatterySoc.ToString(CultureInfo.InvariantCulture) ?? "—") %</dd></div>
        <div><dt>Voltage</dt><dd>@OptionalNumber(Data?.BatteryVoltage) V</dd></div>
        <div><dt>Current</dt><dd>@OptionalNumber(Data?.BatteryCurrent) A</dd></div>
        <div><dt>Temperature</dt><dd>@OptionalNumber(Data?.BatteryTemperature) °C</dd></div>
    </dl>
    <h2>Reading times</h2>
    <dl class="inverter-metrics">
        <div><dt>Deye solar measurement</dt><dd>@(Data?.SolarObservedAt is { } measuredAt ? Time(measuredAt) : "Unavailable")</dd></div>
        <div><dt>Deye grid measurement</dt><dd>@(Data?.GridObservedAt is { } gridAt ? Time(gridAt) : "Unavailable")</dd></div>
        <div><dt>Last poll</dt><dd>@(Data is not null ? Time(Data.Timestamp) : "Unavailable")</dd></div>
        <div><dt>Display time zone</dt><dd>@TimeZoneId</dd></div>
    </dl>
    <p>Polling time can be later than the inverter measurement time. Solar power is unavailable when a valid measurement time is missing. Other fields may report zero when a reading is unavailable.</p>
    <p>Battery charging and discharging follow the reported battery power. Battery current keeps its signed value.</p>
</section>

@code {
    [Parameter] public InverterData? Data { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = "Europe/Warsaw";
    [Parameter] public DateTimeOffset? Now { get; set; }
    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");
    private static string Number(double value) => value.ToString("N2", English);
    private static string OptionalNumber(double? value) => value.HasValue && double.IsFinite(value.Value) ? Number(value.Value) : "—";
    private static string Watts(int? value) => value.HasValue ? Math.Abs((long)value.Value).ToString("N0", English) : "—";
    private string Time(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", English);
}
