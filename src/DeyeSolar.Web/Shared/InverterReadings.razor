@using System.Globalization

<section class="inverter-readings" aria-label="@T["Inverter readings"]">
    <h2>@T["Energy flows"]</h2>
    <dl class="inverter-metrics">
        <div><dt>@T["Solar generation"]</dt><dd data-testid="inverter-pv">@(Data is { SolarObservedAt: { } observed, SolarProduction: >= 0 } && Data.SolarPowerValid == true && observed <= (Now ?? DateTimeOffset.UtcNow) ? Number(Data.SolarProduction / 1000d) : "—") kW</dd></div>
        <div><dt>@T["Load"]</dt><dd data-testid="inverter-load">@Watts(Data?.LoadPowerValid != true ? null : Data?.LoadPower) W</dd></div>
        <div><dt>@T["Grid"]</dt><dd data-testid="inverter-grid">@Watts(GridPower) W</dd><span>@(Data is null ? T["Awaiting reading"] : GridPower is null ? T["Grid measurement unavailable"] : GridPower < 0 ? T["Exporting"] : GridPower > 0 ? T["Importing"] : T["Idle"])</span></div>
        <div><dt>@PowerBalance.BatteryLabel(Data?.BatteryPowerValid != true ? null : Data?.BatteryPower)</dt><dd data-testid="inverter-battery-power">@Watts(Data?.BatteryPowerValid != true ? null : Data?.BatteryPower) W</dd></div>
    </dl>
    <h2>@T["Power balance"]</h2>
    @{ var balance = Balance; }
    <dl class="inverter-metrics">
        <div><dt>@T["Balance difference"]</dt><dd data-testid="inverter-balance">@SignedWatts(balance.Watts)</dd><span>@T.Translate(balance.Watts is { } difference ? PowerBalance.Direction(difference) : balance.UnavailableReason)</span></div>
    </dl>
    <p>@T["Solar + signed grid + signed battery − load. Grid import and battery discharge are positive; export and charging are negative."]</p>
    <p>@T["This is an approximate balance of reported values. Measurements may be taken at different times. Conversion and measurement differences also contribute; this is not a measurement of inverter losses."]</p>
    <h2>@T["Battery details"]</h2>
    <dl class="inverter-metrics">
        <div><dt>@T["Battery SOC"]</dt><dd data-testid="inverter-soc">@(Data?.BatterySocValid != true ? "—" : Data?.BatterySoc.ToString(CultureInfo.InvariantCulture) ?? "—") %</dd></div>
        <div><dt>@T["Voltage"]</dt><dd data-testid="inverter-voltage">@OptionalNumber(Data?.BatteryVoltageValid != true ? null : Data?.BatteryVoltage) V</dd></div>
        <div><dt>@T["Current"]</dt><dd data-testid="inverter-current">@OptionalNumber(Data?.BatteryCurrentValid != true ? null : Data?.BatteryCurrent) A</dd></div>
        <div><dt>@T["Temperature"]</dt><dd data-testid="inverter-temperature">@OptionalNumber(Data?.BatteryTemperatureValid != true ? null : Data?.BatteryTemperature) @T["°C"]</dd></div>
    </dl>
    <h2>@T["Reading times"]</h2>
    <dl class="inverter-metrics">
        <div><dt>@T["Solar measurement"]</dt><dd>@(Data?.SolarPowerValid == true && Data?.SolarObservedAt is { } measuredAt ? Time(measuredAt) : T["Unavailable"])</dd></div>
        <div><dt>@T["Grid measurement"]</dt><dd>@(Data?.GridPowerValid == true && Data?.GridObservedAt is { } gridAt ? Time(gridAt) : T["Unavailable"])</dd></div>
        <div><dt>@T["Last poll"]</dt><dd>@(Data is not null ? Time(Data.Timestamp) : T["Unavailable"])</dd></div>
        <div><dt>@T["Display time zone"]</dt><dd>@TimeZoneId</dd></div>
    </dl>
    <p>@T["Polling time can be later than the inverter measurement time. Unavailable measurements are shown with a dash. Solar power is unavailable when a valid measurement time is missing."]</p>
    <p>@T["Battery charging and discharging follow the reported battery power. Battery current keeps its signed value."]</p>
</section>

@code {
    [Parameter] public InverterData? Data { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = "Europe/Warsaw";
    [Parameter] public DateTimeOffset? Now { get; set; }
    [Parameter] public int AlignmentToleranceSeconds { get; set; } = 120;
    [Parameter] public int MaximumAgeMinutes { get; set; } = 10;
    [Parameter] public string? ExpectedDeviceSn { get; set; }
    private int? GridPower => Data?.GridPowerValid != true ? null : Data?.GridConsumption;
    private PowerBalanceReading Balance => PowerBalance.FromReading(Data, Now ?? DateTimeOffset.UtcNow, AlignmentToleranceSeconds, MaximumAgeMinutes, ExpectedDeviceSn);
    private static CultureInfo English => CultureInfo.CurrentCulture;
    private static string Number(double value) => value.ToString("N2", English);
    private static string OptionalNumber(double? value) => value.HasValue && double.IsFinite(value.Value) ? Number(value.Value) : "—";
    private static string Watts(int? value) => value.HasValue ? Math.Abs((long)value.Value).ToString("N0", English) : "—";
    private static string SignedWatts(double? value) => value.HasValue ? $"{(value > 0 ? "+" : "")}{value.Value.ToString("N0", English)} W" : "—";
    private string Time(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", English);
}
