@using System.Globalization
@using System.Text
@using DeyeSolar.Web.Services
@inject ISolarHistoryService HistoryService
@inject TimeProvider Clock
@implements IAsyncDisposable

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
<MudPaper Class="@(Embedded ? "history-embedded-paper" : Overview ? "pa-4 history-overview-paper" : "pa-4")" Elevation="@(Embedded ? 0 : 2)">
    <section class="solar-history @(Overview ? "history-overview" : null)" aria-labelledby="@(Embedded ? null : "solar-history-title")" aria-label="@(Embedded ? T["Hourly solar power history"] : null)" aria-busy="@_loading.ToString().ToLowerInvariant()">
        @if (!Embedded)
        {
        <div class="history-heading">
            <div>
                <h2 id="solar-history-title">@T["Solar generation"]</h2>
                <p class="history-subtitle">@(Overview ? T.Format("{0} · hourly average power · kW", OverviewDateCaption) : T["Hourly average power · kW"])</p>
            </div>
            <div class="history-controls">
                @if (Overview)
                {
                    <a class="history-details-link" href="/generation">@T["View details"]</a>
                }
                else
                {
                    <div class="history-periods" role="group" aria-label="@T["Chart period"]">
                        @foreach (var period in Enum.GetValues<SolarHistoryPeriod>())
                        {
                            <button type="button" class="@(_period == period ? "selected" : null)" aria-pressed="@((_period == period).ToString().ToLowerInvariant())"
                                    @onclick="() => ChangePeriod(period)">@PeriodLabel(period)</button>
                        }
                    </div>
                }
                <button type="button" class="history-refresh" disabled="@_loading" @onclick="LoadAsync" title="@T["Refresh chart"]" aria-label="@T["Refresh chart"]">↻</button>
            </div>
        </div>
        }
        @if (!Overview)
        {
            <div class="history-date-navigation" role="group" aria-label="@T["Day navigation"]">
                <button type="button" @onclick="() => ChangeDay(-1)" disabled="@(!CanPreviousDay)" aria-label="@T["Previous day"]" title="@T["Previous day"]">‹</button>
                <span class="history-date" aria-live="polite" data-testid="history-date">@DateCaption</span>
                <button type="button" @onclick="() => ChangeDay(1)" disabled="@(!CanNextDay)" aria-label="@T["Next day"]" title="@T["Next day"]">›</button>
                @if (SelectedDate.HasValue && Today.HasValue && SelectedDate < Today)
                {
                    <button type="button" class="history-today" @onclick="GoToToday">@T["Today"]</button>
                }
            </div>
        }
        <div class="history-legend">
            <span><i class="possible-key"></i>@T["Possible · range"]</span>
            <span><i class="actual-key"></i>@T["Actual"]</span>
            @if (_loading) { <span class="history-loading" role="status">@T["Loading…"]</span> }
        </div>
        @if (_error is not null)
        {
            <p class="history-message" role="alert">@T.Translate(_error)</p>
        }
        else if (Result is { } result)
        {
            @if (result.WeatherError is not null) { <p class="history-message" role="status">@T.Translate(result.WeatherError)</p> }
            @if (result.ActualError is not null) { <p class="history-message" role="status">@T.Translate(result.ActualError)</p> }
            @if (result.Points.Count == 0)
            {
                <div class="history-empty">@(SelectedDate == Today ? T["The chart will appear after the first completed hour of the day."] : T["No data is available for this day yet."])</div>
            }
            else if (!result.Points.Any(p => p.Possible is not null || p.ActualKw.HasValue))
            {
                <div class="history-empty">@T["No data is available for this period yet."]</div>
            }
            else
            {
                <div class="history-plot">
                    <svg viewBox="@($"0 0 {ChartWidth} 280")" role="img" aria-label="@T["Hourly possible solar power range and actual power"]">
                        @for (var tick = 0; tick <= 4; tick++)
                        {
                            var y = 232 - tick * 51;
                            <line x1="48" x2="@(ChartWidth - 24)" y1="@y" y2="@y" class="history-grid" />
                            <g><text x="38" y="@(y + 4)" text-anchor="end" class="history-axis">@Number(MaxPower * tick / 4, "0.#")</text></g>
                        }
                        @foreach (var index in TickIndices)
                        {
                            <g><text x="@Coordinate(X(index))" y="258" text-anchor="middle" class="history-axis">@AxisLabel(index)</text></g>
                        }
                        <path d="@RangeBandPath()" class="possible-band" data-testid="possible-band" />
                        <path d="@ActualPath()" class="history-line actual-line" data-testid="actual-series" />
                        @for (var index = 0; index < result.Points.Count; index++)
                        {
                            var point = result.Points[index];
                            if (point.ActualKw.HasValue) { <circle cx="@Coordinate(X(index))" cy="@Coordinate(Y(point.ActualKw.Value))" r="2" class="actual-dot" /> }
                        }
                        @if (Selected is { } selected)
                        {
                            <line x1="@Coordinate(X(SelectedIndex))" x2="@Coordinate(X(SelectedIndex))" y1="28" y2="232" class="history-cursor" />
                        }
                        @for (var index = 0; index < result.Points.Count; index++)
                        {
                            var captured = index;
                            <rect x="@Coordinate(X(index) - Step / 2)" y="20" width="@Coordinate(Step)" height="220" fill="transparent"
                                  @onpointerenter="() => _selected = captured" @onclick="() => _selected = captured">
                                <title>@PointLabel(pointIndex: index)</title>
                            </rect>
                        }
                    </svg>
                </div>
                @if (Selected is { } selectedPoint)
                {
                    <div class="history-inspector" aria-live="polite">
                        <div class="history-inspector-time">
                            <button type="button" @onclick="() => MoveSelection(-1)" disabled="@(SelectedIndex == 0)" aria-label="@T["Previous hour"]">‹</button>
                            <time datetime="@selectedPoint.Timestamp.ToString("O")">@TimeLabel(selectedPoint.Timestamp)</time>
                            <button type="button" @onclick="() => MoveSelection(1)" disabled="@(SelectedIndex == result.Points.Count - 1)" aria-label="@T["Next hour"]">›</button>
                        </div>
                        <span class="possible-value">@T["Possible"] <strong>@RangePower(selectedPoint.Possible)</strong></span>
                        <span class="actual-value">@T["Actual"] <strong>@Power(selectedPoint.ActualKw)</strong></span>
                    </div>
                }
                @if (result.Points.Any(p => !p.ActualKw.HasValue) && result.ActualError is null)
                {
                    <p class="history-footnote">@T["Gaps indicate insufficient saved readings for the hour."]</p>
                }
            }
            @if (!Overview)
            {
                <details class="history-about">
                    <summary>@T["About this chart"]</summary>
                    <p>@T["Possible power is calculated from past weather and the current panel configuration. It is a model estimate, not a forecast saved at the time. Missing temperature or wind uses assumptions of 20 °C and 1 m/s. Actual power is averaged from Deye readings; inverter limits may reduce generation."]</p>
                    <p>@T["The orange band shows an approximate range allowing for weather, panel configuration, temperature and losses. It is an engineering estimate, not a statistical confidence interval."]</p>
                    <p>@T["Completed hours are shown in"] @result.TimeZoneId@T[". Hours with less than 90% measurement coverage remain empty. Readings are retained for 31 days; previously deleted readings are unavailable."]</p>
                    <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">@T["Weather data by Open-Meteo.com"]</a>
                </details>
            }
            else
            {
                <a class="history-source" href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">@T["Weather by Open-Meteo"]</a>
            }
        }
        @if (ShowTable && Result is { } tableResult)
        {
            <div class="history-table-container" tabindex="0" aria-label="@T["Hourly generation data table"]">
                <table class="history-data-table">
                    <caption>@T["Hourly generation data ·"] @tableResult.TimeZoneId</caption>
                    <thead><tr><th scope="col">@T["Hour"]</th><th scope="col">@T["Possible lower · kW"]</th><th scope="col">@T["Possible upper · kW"]</th><th scope="col">@T["Actual average · kW"]</th></tr></thead>
                    <tbody>
                        @foreach (var point in TablePoints)
                        {
                            <tr><th scope="row"><time datetime="@point.Timestamp.ToString("O")">@TimeLabel(point.Timestamp)</time></th><td>@TablePower(point.Possible?.LowerKw)</td><td>@TablePower(point.Possible?.UpperKw)</td><td>@TablePower(point.ActualKw)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="history-table-pager">
                <button type="button" @onclick="() => _tablePage = TablePage - 1" disabled="@(TablePage == 0)" aria-label="@T["Previous table page"]">@T["Previous rows"]</button>
                <span>@T.Format("Page {0} of {1} · {2} hourly intervals", TablePage + 1, TablePages, tableResult.Points.Count)</span>
                <button type="button" @onclick="() => _tablePage = TablePage + 1" disabled="@(TablePage == TablePages - 1)" aria-label="@T["Next table page"]">@T["Next rows"]</button>
            </div>
            <p class="history-footnote">@T["A dash means unavailable; measured zero remains 0.00. Each row is one hour of average power, not energy. Times include the UTC offset to distinguish repeated daylight-saving hours."]</p>
        }
    </section>
</MudPaper>

@code {
    [Parameter] public SolarHistoryResult? Data { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public bool ShowTable { get; set; }
    public Task RefreshDataAsync() => _loading ? Task.CompletedTask : LoadAsync();
    private int _tablePage;
    private (DateTimeOffset Start, DateTimeOffset End)? _tableWindow;
    private int TablePages => Math.Max(1, (int)Math.Ceiling((Result?.Points.Count ?? 0) / 24d));
    private int TablePage => Math.Clamp(_tablePage, 0, TablePages - 1);
    private IEnumerable<SolarHistoryPoint> TablePoints => Result?.Points.Skip(TablePage * 24).Take(24) ?? [];
    private static string TablePower(double? value) => value.HasValue && double.IsFinite(value.Value) ? value.Value.ToString("N2", English) : "—";
    private SolarHistoryResult? _data;
    private SolarHistoryResult? Result => Data ?? _data;
    private SolarHistoryPeriod _period = SolarHistoryPeriod.Today;
    // Null follows today's calendar date across midnight; a historical selection stays fixed.
    private DateOnly? _endDate;
    private TimeZoneInfo? _timeZone;
    private readonly AsyncQueryScope _queries = new();
    private bool _loading => _queries.IsLoading;
    private bool _disposed => _queries.IsDisposed;
    private string? _error;
    private int? _selected;
    private bool _compact;
    private static CultureInfo English => CultureInfo.CurrentCulture;
    private DateOnly? Today => Data is { } data ? data.Today == default ? null : data.Today
        : _timeZone is null ? null : DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), _timeZone).DateTime);
    private DateOnly? SelectedDate => Result is { SelectedDate: var date } && date != default ? date : _endDate ?? Today;
    private bool CanPreviousDay => SelectedDate.HasValue && Today.HasValue && SelectedDate > Today.Value.AddDays(-29);
    private bool CanNextDay => SelectedDate.HasValue && Today.HasValue && SelectedDate < Today;
    private string OverviewDateCaption => SelectedDate is { } date && Today is { } today && date != today
        ? date.ToString("d MMM yyyy", English) : T["Today"];
    private string DateCaption => SelectedDate is not { } date ? "—" : _period == SolarHistoryPeriod.Today
        ? date.ToString("d MMMM yyyy", English)
        : date.AddDays(_period == SolarHistoryPeriod.Week ? -6 : -29).ToString("d MMM yyyy", English)
            + " – " + date.ToString("d MMM yyyy", English);
    private int SelectedIndex => Math.Clamp(_selected ?? (Result?.Points.Count ?? 1) - 1, 0, Math.Max(0, (Result?.Points.Count ?? 1) - 1));
    private SolarHistoryPoint? Selected => Result?.Points.Count > 0 ? Result.Points[SelectedIndex] : null;
    private double MaxPower { get; set; } = 1;
    private int ChartWidth => _compact ? 480 : Overview ? 600 : 960;
    private double Step => (ChartWidth - 72d) / Math.Max(1, Result?.Points.Count ?? 1);
    private double X(int index) => 48 + Step * (index + .5);
    private double Y(double value) => 232 - value / MaxPower * 204;
    private IEnumerable<int> TickIndices => Enumerable.Range(0, Math.Min(6, Result?.Points.Count ?? 0))
        .Select(i => (int)Math.Round(i * ((Result?.Points.Count ?? 1) - 1d) / Math.Max(1, Math.Min(6, Result?.Points.Count ?? 0) - 1))).Distinct();
    private static string Coordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Number(double value, string format = "0.0") => value.ToString(format, English);
    private static string Power(double? value) => value.HasValue ? Number(value.Value) + " kW" : "—";
    private static string RangePower(SolarHistoryPowerRange? range) => range is null ? "—" : Number(range.LowerKw) + "–" + Number(range.UpperKw) + " kW";
    private string PeriodLabel(SolarHistoryPeriod period) => period switch { SolarHistoryPeriod.Today => T["Day"], SolarHistoryPeriod.Week => T["7 days"], _ => T["30 days"] };
    private DateTimeOffset Local(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById(Result!.TimeZoneId));
    private string AxisLabel(int index) => Local(Result!.Points[index].Timestamp).ToString(_period == SolarHistoryPeriod.Today ? "HH:mm" : "d MMM", English);
    private string TimeLabel(DateTimeOffset time) => Local(time).ToString("d MMM · HH:mm", English) + "–" + Local(time.AddHours(1)).ToString("HH:mm", English) + " (UTC" + Local(time).ToString("zzz") + ")";
    private string PointLabel(int pointIndex) => T.Format("{0}: possible {1}, actual {2}", TimeLabel(Result!.Points[pointIndex].Timestamp), RangePower(Result.Points[pointIndex].Possible), Power(Result.Points[pointIndex].ActualKw));

    protected override void OnParametersSet()
    {
        if (Overview)
        {
            _period = SolarHistoryPeriod.Today;
            _endDate = null;
        }
        UpdateScale();
    }
    private void OnBreakpointChanged(Breakpoint breakpoint) => _compact = breakpoint is Breakpoint.Xs or Breakpoint.Sm;

    private void UpdateScale()
    {
        MaxPower = Math.Max(1, Math.Ceiling((Result?.Points
            .Select(p => Math.Max(p.Possible?.UpperKw ?? 0, p.ActualKw ?? 0)).DefaultIfEmpty(0).Max() ?? 0) / 2) * 2);
        if (Result is { } result && _tableWindow != (result.Start, result.End))
        {
            _tableWindow = (result.Start, result.End);
            _tablePage = 0;
        }
    }

    private string RangeBandPath()
    {
        var path = new StringBuilder();
        var points = Result?.Points;
        if (points is null) return string.Empty;
        void Vertex(string command, double x, double power) => path.Append(command)
            .Append(Coordinate(x)).Append(' ').Append(Coordinate(Y(power)));
        for (var start = 0; start < points.Count; start++)
        {
            if (points[start].Possible is null) continue;
            var end = start;
            while (end + 1 < points.Count && points[end + 1].Possible is not null) end++;
            // Hour-edge caps keep an isolated sample visible without bridging missing hours.
            Vertex(" M ", X(start) - Step / 2, points[start].Possible!.UpperKw);
            for (var i = start; i <= end; i++) Vertex(" L ", X(i), points[i].Possible!.UpperKw);
            Vertex(" L ", X(end) + Step / 2, points[end].Possible!.UpperKw);
            Vertex(" L ", X(end) + Step / 2, points[end].Possible!.LowerKw);
            for (var i = end; i >= start; i--) Vertex(" L ", X(i), points[i].Possible!.LowerKw);
            Vertex(" L ", X(start) - Step / 2, points[start].Possible!.LowerKw);
            path.Append(" Z");
            start = end;
        }
        return path.ToString();
    }

    private string ActualPath()
    {
        var path = new StringBuilder();
        var connected = false;
        for (var i = 0; i < (Result?.Points.Count ?? 0); i++)
        {
            var value = Result!.Points[i].ActualKw;
            if (!value.HasValue) { connected = false; continue; }
            path.Append(connected ? " L " : " M ").Append(Coordinate(X(i))).Append(' ').Append(Coordinate(Y(value.Value)));
            connected = true;
        }
        return path.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Data is not null) return;
        await LoadAsync();
        _queries.StartRefresh(Clock, TimeSpan.FromMinutes(5), () => InvokeAsync(LoadAsync));
    }

    private async Task ChangePeriod(SolarHistoryPeriod period)
    {
        if (_period == period) return;
        _period = period;
        _selected = null;
        _data = null;
        await LoadAsync();
    }

    private async Task ChangeDay(int direction)
    {
        if (direction < 0 ? !CanPreviousDay : !CanNextDay) return;
        var date = SelectedDate!.Value.AddDays(direction);
        _endDate = date == Today ? null : date;
        _selected = null;
        _data = null;
        await LoadAsync();
    }

    private async Task GoToToday()
    {
        _endDate = null;
        _selected = null;
        _data = null;
        await LoadAsync();
    }

    private void MoveSelection(int delta) => _selected = Math.Clamp(SelectedIndex + delta, 0, Result!.Points.Count - 1);

    private async Task LoadAsync()
    {
        if (_disposed || Data is not null) return;
        if (Today is { } today && _endDate is { } selectedDate)
        {
            if (selectedDate >= today) _endDate = null;
            else if (selectedDate < today.AddDays(-29)) _endDate = today.AddDays(-29);
        }
        if (_data is { } loaded && (_endDate ?? Today) is { } requestedDate && loaded.SelectedDate != requestedDate)
        {
            _data = null;
            _selected = null;
        }
        await _queries.RunAsync(ct => HistoryService.ReadAsync(_period, ct, _endDate),
            started: () => { _error = null; StateHasChanged(); },
            received: result => {
                _data = result;
                _timeZone = TimeZoneInfo.FindSystemTimeZoneById(result.TimeZoneId);
                UpdateScale();
            },
            failed: _ => _error = T["The chart could not be loaded. Select Refresh to try again."],
            finished: StateHasChanged);
    }

    public ValueTask DisposeAsync() => _queries.DisposeAsync();
}
