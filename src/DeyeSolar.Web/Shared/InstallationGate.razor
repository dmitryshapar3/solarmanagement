@using DeyeSolar.Web.Data
@using DeyeSolar.Web.Tenancy
@using DeyeSolar.Web.Billing
@using System.Security.Claims
@implements IAsyncDisposable
@inject AuthenticationStateProvider Authentication
@inject InstallationMembershipService Memberships
@inject CurrentInstallation Current
@inject TenantRuntimeRegistry Runtimes
@inject DeyeSolar.Web.Billing.IBillingAccessReader Billing
@inject CurrentBillingAccount BillingAccount
@inject TimeProvider Clock
@inject DeyeSolar.Web.Auth.InteractiveSecurityContext Security

@if (_subscriptionRequired)
{
    <p role="alert">@T["Your trial has ended. Subscribe to read or control your sockets."]</p>
    <a href="/billing">@T["Subscription"]</a>
    <a href="/account">@T["Account"]</a>
}
else if (_ready)
{
    @ChildContent
}
else if (_error)
{
    <p role="alert">@T["Your installation could not be opened. Please sign in again or contact support."]</p>
    <a href="/login">@T["Sign in"]</a>
}
else
{
    <p role="status">@T["Opening your installation…"]</p>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _ready;
    private bool _error;
    private bool _subscriptionRequired;
    private readonly CancellationTokenSource _stopping = new();
    private Task? _accessMonitor;
    private CancellationTokenSource? _deadlineCancellation;
    private Task? _deadlineMonitor;
    private long _accessVersion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Authentication.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true) { _ready = true; return; }
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
            BillingAccount.BindOnce(userId);
            if (!(await Billing.ReadAsync(userId, _stopping.Token)).HasAccess) { _subscriptionRequired = true; return; }
            var membership = await Memberships.ResolveAsync(state.User);
            if (membership is null) { _error = true; return; }
            Current.BindOnce(membership.InstallationId);
            Security.BindOnce(state.User);
            await Security.EnsureAsync(DeyeSolar.Web.Auth.InstallationPermission.Read, _stopping.Token);
            await Runtimes.GetAsync(membership.InstallationId, _stopping.Token);
            var access = await Billing.ReadAsync(userId, _stopping.Token);
            if (!access.HasAccess) { _subscriptionRequired = true; return; }
            _ready = true;
            await ArmDeadlineAsync(access);
            _accessMonitor = MonitorAsync(userId);
        }
        catch { _error = true; }
    }

    private async Task MonitorAsync(string userId)
    {
        try
        {
            while (!_stopping.IsCancellationRequested && !_subscriptionRequired)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), Clock, _stopping.Token);
                await Security.EnsureAsync(DeyeSolar.Web.Auth.InstallationPermission.Read, _stopping.Token);
                var access = await Billing.ReadAsync(userId, _stopping.Token);
                if (_subscriptionRequired) return;
                if (!access.HasAccess)
                {
                    await InvokeAsync(() => { _subscriptionRequired = true; _ready = false; StateHasChanged(); });
                    return;
                }
                await ArmDeadlineAsync(access);
            }
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
        catch
        {
            if (!_stopping.IsCancellationRequested)
                await InvokeAsync(() => { _error = true; _ready = false; StateHasChanged(); });
        }
    }

    private async Task ArmDeadlineAsync(BillingAccess access)
    {
        var version = ++_accessVersion;
        _deadlineCancellation?.Cancel();
        if (_deadlineMonitor is not null) await _deadlineMonitor;
        _deadlineCancellation?.Dispose();
        _deadlineCancellation = CancellationTokenSource.CreateLinkedTokenSource(_stopping.Token);
        var now = Clock.GetUtcNow();
        var remaining = (access.AccessValidUntil ?? now) - now;
        _deadlineMonitor = CloseAtDeadlineAsync(version, remaining, _deadlineCancellation.Token);
    }

    private async Task CloseAtDeadlineAsync(long version, TimeSpan remaining, CancellationToken ct)
    {
        try
        {
            // Refreshes may be blocked by a database outage; cached content still closes on its known deadline.
            var started = Clock.GetTimestamp();
            while (remaining > TimeSpan.Zero)
            {
                await Task.Delay(remaining < TimeSpan.FromDays(1) ? remaining : TimeSpan.FromDays(1), Clock, ct);
                remaining -= Clock.GetElapsedTime(started);
                started = Clock.GetTimestamp();
            }
            if (ct.IsCancellationRequested) return;
            await InvokeAsync(() =>
            {
                if (ct.IsCancellationRequested || version != _accessVersion) return;
                _subscriptionRequired = true; _ready = false; StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _stopping.Cancel();
        if (_accessMonitor is not null) await _accessMonitor;
        if (_deadlineMonitor is not null) await _deadlineMonitor;
        _deadlineCancellation?.Dispose();
        _stopping.Dispose();
    }
}
