@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="ml-3">DeyeSolar</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-4 d-none d-sm-block">Solar Energy Management</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                       Href="/logout" title="Sign out" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="px-4 pb-4" Style="padding-top: calc(var(--mud-appbar-height) + 16px);">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
