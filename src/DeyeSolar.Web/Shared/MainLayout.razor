@inherits LayoutComponentBase
@using System.Security.Claims
@using DeyeSolar.Web.Billing
@inject DeyeSolar.Web.Data.IAppSettingsReader Settings
@inject IBillingAccessReader Billing
@inject DeyeSolar.Web.Auth.AccountManagementService Account
<div class="app-shell @(_drawerOpen ? "drawer-open" : null)">
    <button class="mobile-drawer-backdrop" @onclick="() => _drawerOpen = false" aria-label="@T["Close navigation"]"></button>
    <aside class="sidebar" aria-label="@T["Main navigation"]"><div class="sidebar-brand"><BrandMark />@if (!string.IsNullOrWhiteSpace(_site)) { <span class="site-caption">@_site</span> }</div><NavMenu OnNavigate="()=>_drawerOpen=false" /><div class="sidebar-user"><a href="/settings/account" target="_top"><span class="avatar">@Initials</span><span style="min-width:0"><span class="user-name">@_name</span><br /><span class="user-plan">@PlanLabel</span></span></a></div></aside>
    <div style="flex:1;min-width:0"><header class="app-topbar"><button class="icon-button" @onclick="() => _drawerOpen = !_drawerOpen" aria-expanded="@_drawerOpen.ToString().ToLowerInvariant()" aria-label="@T["Open navigation"]"><UiIcon Name="menu" /></button><BrandMark /><a class="avatar" href="/settings/account" target="_top" aria-label="@T["Account"]">@Initials</a></header><main class="app-content" id="main-content"><div class="page-content"><CascadingValue Name="DisplayTimeZone" Value="_displayZone">@Body</CascadingValue></div></main></div>
</div>
@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private bool _drawerOpen;
    private string _name = "", _site = "", _displayZone="UTC";
    private DeyeSolar.Domain.Billing.BillingAccess? _access;
    private string Initials => string.Join("", _name.Split(new[] { ' ', '@', '.', '_' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));
    private string PlanLabel => _access is null ? "" : _access.Status == "trial" ? T.Format("Trial · {0} days left", _access.TrialDaysRemaining) : _access.HasAccess ? T["Premium"] : T["Ended"];
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            _name = user.FindFirst("solar:display-name")?.Value ?? user.Identity?.Name ?? "";
            if (user.FindFirstValue(ClaimTypes.NameIdentifier) is { } id) { _access = await Billing.ReadAsync(id, CancellationToken.None); var profile=await Account.ProfileAsync(id,CancellationToken.None);_name=profile.DisplayName??_name;var preference=await Account.PreferencesAsync(id,CancellationToken.None);_displayZone=preference.DisplayTimeZoneId??(await Settings.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display")).TimeZoneId; }
        }
        try { _site = (await Settings.LoadSectionAsync<DeyeSolar.Domain.Options.SolarEstimateOptions>("SolarEstimate")).LocationLabel; } catch { }
    }
}
