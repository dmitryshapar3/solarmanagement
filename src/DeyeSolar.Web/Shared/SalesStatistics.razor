@using System.Globalization
@using DeyeSolar.Web.Services
@inject IExportSalesService SalesService
@inject TimeProvider Clock
@implements IAsyncDisposable

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
<section class="@(Overview ? "sales sales-overview" : "sales")" aria-labelledby="sales-title" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <MudPaper Class="pa-4 sales-paper" Elevation="2">
        <div class="sales-heading">
            <div>
                @if (Overview) { <h2 id="sales-title">@T["Electricity sales"]</h2> }
                else { <h1 id="sales-title">@(Detailed ? T["Sales details"] : T["Electricity sales"])</h1> }
                <span class="sales-source" title="@T["Deye readings estimated under the contract terms. The supplier settles using the OSD billing meter."]">@T["Deye estimate"]</span>
            </div>
            <div class="sales-heading-actions">
                <button class="sales-refresh" type="button" @onclick="RefreshAsync" disabled="@_loading" aria-label="@T["Refresh sales"]" title="@T["Refresh"]">@T["Refresh"]</button>
                @if (!Detailed) { <a href="@DetailsUrl" class="sales-details-link" aria-label="@T["Electricity sales details"]">@T["Details"]</a> }
            </div>
        </div>
        @if (!Overview)
        {
            <div class="sales-filters">
                <div class="sales-switch" role="group" aria-label="@T["Sales period"]">
                    @foreach (var period in Enum.GetValues<ExportSalesPeriod>())
                    {
                        <button type="button" class="@(_selection.Period == period ? "selected" : null)" aria-pressed="@((_selection.Period == period).ToString().ToLowerInvariant())"
                                @onclick="() => ChangePeriod(period)">@PeriodLabel(period)</button>
                    }
                </div>
                <div class="sales-date-navigation">
                    @if (_selection.Period != ExportSalesPeriod.Custom)
                    {
                        <button type="button" @onclick="() => MovePeriod(-1)" disabled="@(!CanPrevious)" aria-label="@T["Previous period"]">‹</button>
                        @if (_selection.Period == ExportSalesPeriod.Day)
                        {
                            <label><span class="sr-only">@T["Date"]</span><input type="date" aria-label="@T["Date"]" value="@Iso(_selection.Date)" min="2000-01-01" max="@Iso(Today)" @onchange="ChangeDate" /></label>
                        }
                        else if (_selection.Period == ExportSalesPeriod.Month)
                        {
                            <label><span class="sr-only">@T["Month"]</span><input type="month" aria-label="@T["Month"]" value="@_selection.Date.ToString("yyyy-MM", CultureInfo.InvariantCulture)" min="2000-01" max="@Today.ToString("yyyy-MM", CultureInfo.InvariantCulture)" @onchange="ChangeDate" /></label>
                        }
                        else
                        {
                            <label><span class="sr-only">@T["Year"]</span><input type="number" aria-label="@T["Year"]" value="@_selection.Date.Year" min="2000" max="@Today.Year" @onchange="ChangeDate" /></label>
                        }
                        <button type="button" @onclick="() => MovePeriod(1)" disabled="@(!CanNext)" aria-label="@T["Next period"]">›</button>
                    }
                    <button type="button" class="sales-today" @onclick="GoToToday">@T["Today"]</button>
                </div>
            </div>
            @if (_selection.Period == ExportSalesPeriod.Custom)
            {
                <div class="sales-custom">
                    <label>@T["From"] <input type="date" aria-label="@T["Start date"]" value="@_fromInput" min="2000-01-01" max="@Iso(Today)" @onchange="ChangeFrom" /></label>
                    <label>@T["To"] <input type="date" aria-label="@T["End date, inclusive"]" value="@_throughInput" min="2000-01-01" max="@Iso(Today)" @onchange="ChangeThrough" /></label>
                    <button type="button" @onclick="ApplyCustom" disabled="@(_validation is not null)">@T["Apply"]</button>
                    <span>@T["Inclusive · up to 366 days"]</span>
                </div>
            }
            @if (_validation is not null)
            {
                <p class="sales-message" role="alert">@_validation</p>
            }
        }
        <div class="sales-period-caption">
            <span data-testid="sales-period" aria-live="polite">@PeriodCaption(Result?.Request ?? _selection)</span>
            <span>@TimeZoneId</span>
        </div>
        @if (!Detailed)
        {
        <div class="sales-totals">
            <div class="sales-total">
                <span class="sales-total-label">@(Overview ? OverviewExportLabel : T["Exported to grid"])</span>
                <strong data-testid="sales-export">@Number(HasElapsedHours ? Result?.ExportKwh : null)<small>kWh</small></strong>
            </div>
            <div class="sales-total">
                <span class="sales-total-label">@T["Energy value"]</span>
                <strong data-testid="sales-value">@Number(HasElapsedHours ? Result?.EnergyValuePln : null)<small>PLN</small></strong>
            </div>
            @if (!Overview)
            {
                <div class="sales-total">
                    <span class="sales-total-label" title="@T["Estimated monthly deposit credit with the 1.23 multiplier. This is not a payout or the current balance."]">@T["Estimated deposit"] <span aria-hidden="true">ⓘ</span></span>
                    <strong data-testid="sales-deposit">@Number(HasElapsedHours ? Result?.EstimatedDepositPln : null)<small>PLN</small></strong>
                </div>
            }
        </div>
        }
        @if (_loading)
        {
            <p class="sales-status" role="status">@(Result is null ? T["Loading…"] : T["Refreshing…"])</p>
        }
        @if (_error is not null)
        {
            <p class="sales-message" role="alert">@T.Translate(_error)</p>
            <button class="sales-retry" type="button" @onclick="RefreshAsync">@T["Retry"]</button>
        }
        @if (Result is { } result)
        {
            <div class="sales-freshness">
                <span>@T["Totals cover completed hours. Current hour is provisional."]</span>
                @if (result.UpdatedAt is { } updatedAt)
                {
                    <span>@T["Updated"] <time datetime="@updatedAt.ToString("O")">@Local(updatedAt).ToString("d MMMM HH:mm (zzz)", English)</time> @T["· refreshes every 5 minutes"]</span>
                }
            </div>
            @if (result.DataError is not null) { <p class="sales-message" role="status">@T.Translate(result.DataError)</p> }
            @if (result.PriceError is not null) { <p class="sales-message" role="status">@T.Translate(result.PriceError)</p> }
            @if (HasElapsedHours && (!Overview || result.IsPartial))
            {
                <div class="sales-coverage">
                    <span>@(result.IsPartial ? T["Partial data · totals for available hours"] : T["Completed hours only"])</span>
                    @if (!Overview) { <span>@T["Readings"] @result.ObservedHours @T["of"] @result.ExpectedHours @T["h · value"] @result.ValuedHours @T["of"] @result.ExpectedHours @T["h"]</span> }
                </div>
            }
            <div class="sales-chart-heading">
                @if (Overview) { <h3>@(result.Request.Date == Today ? T["Today by hour"] : T["By hour"])</h3> }
                else { <h2>@(result.Request.Period == ExportSalesPeriod.Day ? T["Hourly"] : result.Request.Period == ExportSalesPeriod.Year ? T["Monthly"] : T["Daily"])</h2> }
                <div class="sales-switch" role="group" aria-label="@T["Chart metric"]">
                    <button type="button" class="@(_showMoney ? null : "selected")" aria-pressed="@((!_showMoney).ToString().ToLowerInvariant())" @onclick="() => _showMoney = false">@T["Energy"]</button>
                    <button type="button" class="@(_showMoney ? "selected" : null)" aria-pressed="@_showMoney.ToString().ToLowerInvariant()" @onclick="() => _showMoney = true">@T["Value"]</button>
                </div>
            </div>
            @if (!HasElapsedHours && result.CurrentHour is null)
            {
                <div class="sales-empty" role="status">@(result.DataError is not null ? T["Data for this period is unavailable."]
                    : BeforeContract ? T.Format("This period is before the contract start date — {0}.", result.ContractStartDate.ToString("d MMMM yyyy", English)) : T["There are no completed hours in this period yet."])</div>
            }
            else if (!result.Buckets.Any(bucket => Value(bucket).HasValue || ProgressValue(bucket).HasValue))
            {
                <div class="sales-empty" role="status">@(result.CurrentHour is not null ? _showMoney ? T["Awaiting current-hour prices or readings."] : T["Awaiting current-hour readings."]
                    : _showMoney ? T["Energy value is not available yet. You can view energy readings separately."] : T["No export readings for this period."])</div>
            }
            else
            {
                <div class="sales-plot">
                    <svg viewBox="@($"0 0 {ChartWidth} 280")" role="img" aria-label="@(_showMoney ? T["Exported energy value, PLN"] : T["Energy exported to grid, kWh"])">
                        @for (var tick = 0; tick <= 4; tick++)
                        {
                            var y = 232 - tick * 51;
                            <line x1="52" x2="@(ChartWidth - 20)" y1="@y" y2="@y" class="sales-grid" />
                            <g><text x="43" y="@(y + 4)" text-anchor="end" class="sales-axis">@AxisNumber(ScaleMin + (ScaleMax - ScaleMin) * tick / 4)</text></g>
                        }
                        <g><text x="52" y="16" class="sales-axis">@Unit</text></g>
                        <line x1="52" x2="@(ChartWidth - 20)" y1="@Coordinate(Y(0))" y2="@Coordinate(Y(0))" class="sales-baseline" />
                        @for (var index = 0; index < result.Buckets.Count; index++)
                        {
                            var bucket = result.Buckets[index];
                            var captured = index;
                            @if (Value(bucket) is { } value)
                            {
                                var y = Y((double)value);
                                <rect x="@Coordinate(X(index) - BarWidth / 2)" y="@Coordinate(Math.Min(y, Y(0)))" width="@Coordinate(BarWidth)" height="@Coordinate(Math.Max(1.5, Math.Abs(y - Y(0))))"
                                      class="@(_showMoney ? "sales-bar money" : "sales-bar")" data-testid="sales-bar" data-start="@bucket.Start.ToString("O")" />
                            }
                            @if (ProgressValue(bucket) is { } progressValue)
                            {
                                var baseline = Y((double)(Value(bucket) ?? 0));
                                var progressY = Y((double)((Value(bucket) ?? 0) + progressValue));
                                <rect x="@Coordinate(X(index) - BarWidth / 2)" y="@Coordinate(Math.Min(progressY, baseline))" width="@Coordinate(BarWidth)" height="@Coordinate(Math.Max(1.5, Math.Abs(progressY - baseline)))"
                                      class="@(_showMoney ? "sales-progress-bar money" : "sales-progress-bar")" data-testid="sales-progress-bar" data-start="@result.CurrentHour!.Start.ToString("O")">
                                    <title>@ProgressDescription(result.CurrentHour)</title>
                                </rect>
                            }
                            <rect x="@Coordinate(X(index) - Step / 2)" y="24" width="@Coordinate(Step)" height="212" fill="transparent"
                                  @onpointerenter="() => _selected = captured" @onclick="() => _selected = captured"><title>@BucketDescription(bucket)</title></rect>
                        }
                        @foreach (var index in TickIndices)
                        {
                            <g><text x="@Coordinate(X(index))" y="258" text-anchor="middle" class="sales-axis">@AxisLabel(result.Buckets[index])</text></g>
                        }
                        @if (Selected is not null)
                        {
                            <line x1="@Coordinate(X(SelectedIndex))" x2="@Coordinate(X(SelectedIndex))" y1="28" y2="232" class="sales-cursor" />
                        }
                    </svg>
                </div>
            }
            @if ((HasElapsedHours || result.CurrentHour is not null) && Selected is { } selected)
            {
                <div class="sales-inspector" aria-live="polite">
                    <div class="sales-inspector-time">
                        <button type="button" @onclick="() => MoveBucket(-1)" disabled="@(SelectedIndex == 0)" aria-label="@T["Previous interval"]">‹</button>
                        <time datetime="@selected.Start.ToString("O")">@BucketTime(selected)</time>
                        <button type="button" @onclick="() => MoveBucket(1)" disabled="@(SelectedIndex == result.Buckets.Count - 1)" aria-label="@T["Next interval"]">›</button>
                    </div>
                    @if (selected.ExpectedHours > 0)
                    {
                        <span>@T["Completed export"] <strong>@Number(selected.ExportKwh) kWh</strong></span>
                        <span>@T["Completed value"] <strong>@Number(selected.EnergyValuePln) PLN</strong></span>
                    }
                    @if (selected.ObservedHours < selected.ExpectedHours || selected.ValuedHours < selected.ObservedHours)
                    {
                        <span class="sales-incomplete">@T["Partial interval"]</span>
                    }
                    @if (ProgressFor(selected) is { } progress)
                    {
                        <div class="sales-progress-inspector" data-testid="sales-current-hour">
                            <strong>@T["Current hour · in progress"]</strong>
                            <span>@ProgressTime(progress)</span>
                            <span>@T["Exported so far"] <strong>@Number(progress.ExportKwh) kWh</strong></span>
                            <span>@T["Provisional value"] <strong>@Number(progress.EnergyValuePln) PLN</strong></span>
                            @if (progress.ExportKwh is null) { <span>@T["Awaiting current-hour readings."]</span> }
                            else if (progress.EnergyValuePln is null) { <span>@T["Awaiting current-hour prices."]</span> }
                            <span>@T["Measured intervals only; no projection to the end of the hour."]</span>
                        </div>
                    }
                </div>
            }
            @if (Detailed)
            {
        <div class="sales-totals">
            <div class="sales-total">
                <span class="sales-total-label">@(Overview ? OverviewExportLabel : T["Exported to grid"])</span>
                <strong data-testid="sales-export">@Number(HasElapsedHours ? Result?.ExportKwh : null)<small>kWh</small></strong>
            </div>
            <div class="sales-total">
                <span class="sales-total-label">@T["Energy value"]</span>
                <strong data-testid="sales-value">@Number(HasElapsedHours ? Result?.EnergyValuePln : null)<small>PLN</small></strong>
            </div>
            @if (!Overview)
            {
                <div class="sales-total">
                    <span class="sales-total-label" title="@T["Estimated monthly deposit credit with the 1.23 multiplier. This is not a payout or the current balance."]">@T["Estimated deposit"] <span aria-hidden="true">ⓘ</span></span>
                    <strong data-testid="sales-deposit">@Number(HasElapsedHours ? Result?.EstimatedDepositPln : null)<small>PLN</small></strong>
                </div>
            }
        </div>
            }
            @if (!Overview)
            {
                <details class="sales-about">
                    <summary>@T["How the estimate is calculated"]</summary>
                    <p>@T["Under the TAURON contract effective from"] @result.ContractStartDate.ToString("d MMMM yyyy", English)@T[". Exported to grid means all measured exports. After hourly netting of imports and exports:"] <strong>@Number(HasElapsedHours ? result.CreditedExportKwh : null) kWh</strong>@T[". This net amount is used to calculate the energy value."]</p>
                    <p>@T["Energy value uses RCE prices under the contract terms. The estimated monthly deposit credit includes the 1.23 multiplier; it is not a bank payout or the deposit balance."]</p>
                    <p>@T["Energy readings come from Deye. Final supplier settlement uses the OSD billing meter. Missing readings or prices are not treated as zero. Settlement time zone:"] @result.TimeZoneId.</p>
                </details>
            }
            @if (Detailed)
            {
                <section class="sales-detail-section" aria-labelledby="sales-coverage-title">
                    <h2 id="sales-coverage-title">@T["Data coverage"]</h2>
                    <dl class="sales-metadata">
                        <div><dt>@T["Expected completed hours"]</dt><dd>@result.ExpectedHours</dd></div>
                        <div><dt>@T["Hours with Deye readings"]</dt><dd>@result.ObservedHours</dd></div>
                        <div><dt>@T["Hours with calculated energy value"]</dt><dd>@result.ValuedHours</dd></div>
                        <div><dt>@T["Credited export after hourly netting"]</dt><dd>@Number(HasElapsedHours ? result.CreditedExportKwh : null) kWh</dd></div>
                        <div><dt>@T["Period starts"]</dt><dd><time datetime="@result.Start.ToString("O")">@Local(result.Start).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", English)</time></dd></div>
                        <div><dt>@T["Period ends · exclusive"]</dt><dd><time datetime="@result.End.ToString("O")">@Local(result.End).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", English)</time></dd></div>
                        <div><dt>@T["Settlement time zone"]</dt><dd>@result.TimeZoneId</dd></div>
                        <div><dt>@T["Last updated"]</dt><dd>@(result.UpdatedAt is { } updated ? Local(updated).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", English) : T["Unavailable"])</dd></div>
                    </dl>
                    <p>@T["Totals cover the available completed hours. Missing readings or prices remain unavailable."]</p>
                </section>
                @if (result.CurrentHour is { } current)
                {
                    <section class="sales-detail-section" aria-labelledby="sales-current-details-title">
                        <h2 id="sales-current-details-title">@T["Current hour · in progress"]</h2>
                        <dl class="sales-metadata">
                            <div><dt>@T["Measured through"]</dt><dd>@(current.ObservedThrough is { } through ? Local(through).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", English) : T["Awaiting readings"])</dd></div>
                            <div><dt>@T["Observed duration"]</dt><dd>@((current.ObservedSeconds / 60d).ToString("N1", English)) @T["min"]</dd></div>
                            <div><dt>@T["Provisional export"]</dt><dd>@Number(current.ExportKwh) kWh</dd></div>
                            <div><dt>@T["Provisional credited export"]</dt><dd>@Number(current.CreditedExportKwh) kWh</dd></div>
                            <div><dt>@T["Provisional value"]</dt><dd>@Number(current.EnergyValuePln) PLN</dd></div>
                            <div><dt>@T["Provisional deposit credit"]</dt><dd>@Number(current.EstimatedDepositPln) PLN</dd></div>
                        </dl>
                        <p>@T["Measured intervals only; no projection to the end of the hour. This amount is separate from completed-hour totals."]</p>
                    </section>
                }
                <section class="sales-detail-section" aria-labelledby="sales-contract-title">
                    <h2 id="sales-contract-title">@T["Contract calculation"]</h2>
                    <p>@T["TAURON contract from"] @result.ContractStartDate.ToString("d MMMM yyyy", English)@T[". Energy value uses RCE prices for credited export after hourly netting. Estimated deposit credit includes the 1.23 multiplier."]</p>
                    <p>@T["The estimate is not a bank payout or deposit balance. Final settlement uses the OSD billing meter."]</p>
                </section>
                <div class="sales-table-container" tabindex="0" aria-label="@T["Completed sales interval data table"]">
                    <table class="sales-data-table">
                        <caption>@T["Completed interval breakdown ·"] @result.TimeZoneId</caption>
                        <thead><tr><th scope="col">@T["Interval"]</th><th scope="col">@T["Export · kWh"]</th><th scope="col">@T["Credited · kWh"]</th><th scope="col">@T["Value · PLN"]</th><th scope="col">@T["Deposit · PLN"]</th><th scope="col">@T["Observed / expected h"]</th><th scope="col">@T["Valued h"]</th></tr></thead>
                        <tbody>
                            @foreach (var bucket in result.Buckets)
                            {
                                <tr><th scope="row">@BucketTime(bucket)</th><td>@Number(bucket.ExpectedHours > 0 ? bucket.ExportKwh : null)</td><td>@Number(bucket.ExpectedHours > 0 ? bucket.CreditedExportKwh : null)</td><td>@Number(bucket.ExpectedHours > 0 ? bucket.EnergyValuePln : null)</td><td>@Number(bucket.ExpectedHours > 0 ? bucket.EstimatedDepositPln : null)</td><td>@bucket.ObservedHours / @bucket.ExpectedHours</td><td>@bucket.ValuedHours</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </MudPaper>
</section>

@code {
    [Parameter] public ExportSalesResult? Data { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Detailed { get; set; }
    [Parameter] public string ReturnTo { get; set; } = "/sales";
    [Parameter] public ExportSalesRequest? InitialRequest { get; set; }
    private ExportSalesRequest? _appliedInitialRequest;
    private string DetailsUrl => EnergyDetailsNavigation.SalesUrl("/sales-details", Result?.Request ?? _selection, ReturnTo);
    private ExportSalesResult? _data;
    private ExportSalesResult? Result => Data ?? _data;
    private ExportSalesRequest _selection = new(ExportSalesPeriod.Day, default);
    private DateOnly _from;
    private DateOnly _through;
    private string _fromInput = "";
    private string _throughInput = "";
    private bool _followToday = true;
    private bool _showMoney;
    private bool _loading;
    private bool _disposed;
    private bool _compact;
    private int? _selected;
    private long _version;
    private CancellationTokenSource? _active;
    private string? _error;
    private string? _validation;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _refreshTask;
    private static CultureInfo English => CultureInfo.CurrentCulture;
    private string TimeZoneId => Result?.TimeZoneId ?? "Europe/Warsaw";
    private DateOnly Today => Data?.Today ?? DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)).DateTime);
    private bool HasElapsedHours => Result?.ExpectedHours > 0;
    private bool BeforeContract => Result is { } result && PeriodBounds(result.Request).Through < result.ContractStartDate;
    private bool CanPrevious => PeriodBounds(_selection).From > new DateOnly(2000, 1, 1);
    private bool CanNext => PeriodBounds(_selection).Through < Today;
    private string OverviewExportLabel => Result?.Request.Date is { } date && date != Today ? T.Format("Exported on {0}", date.ToString("d MMM", English)) : T["Exported today"];
    private string Unit => _showMoney ? "PLN" : "kWh";
    private int ChartWidth => _compact ? 480 : Overview ? 600 : 960;
    private double Step => (ChartWidth - 72d) / Math.Max(1, Result?.Buckets.Count ?? 1);
    private double BarWidth => Math.Max(.5, Step * .66);
    private int SelectedIndex => Math.Clamp(_selected ?? LastElapsedIndex, 0, Math.Max(0, (Result?.Buckets.Count ?? 1) - 1));
    private int LastElapsedIndex => Result is { } result ? Math.Max(0, result.Buckets.ToList().FindLastIndex(bucket => bucket.ExpectedHours > 0 || ProgressFor(bucket) is not null)) : 0;
    private ExportSaleBucket? Selected => Result?.Buckets.Count > 0 ? Result.Buckets[SelectedIndex] : null;
    private decimal? Value(ExportSaleBucket bucket) => bucket.ExpectedHours <= 0 ? null : _showMoney ? bucket.EnergyValuePln : bucket.ExportKwh;
    private ExportSaleProgress? ProgressFor(ExportSaleBucket bucket) => Result?.CurrentHour is { } progress && progress.Start >= bucket.Start && progress.Start < bucket.End ? progress : null;
    private decimal? ProgressValue(ExportSaleBucket bucket) => ProgressFor(bucket) is { } progress ? _showMoney ? progress.EnergyValuePln : progress.ExportKwh : null;
    private IEnumerable<double> Values => Result?.Buckets.SelectMany(bucket => new[] { Value(bucket), ProgressValue(bucket) is { } progress ? (Value(bucket) ?? 0) + progress : (decimal?)null })
        .Where(value => value.HasValue).Select(value => (double)value!.Value) ?? [];
    private double ScaleMin => Math.Min(0, Math.Floor(Values.DefaultIfEmpty(0).Min()));
    private double ScaleMax => Math.Max(1, Math.Ceiling(Values.DefaultIfEmpty(0).Max()));
    private double X(int index) => 52 + Step * (index + .5);
    private double Y(double value) => 232 - (value - ScaleMin) / (ScaleMax - ScaleMin) * 204;
    private IEnumerable<int> TickIndices => Enumerable.Range(0, Math.Min(6, Result?.Buckets.Count ?? 0))
        .Select(index => (int)Math.Round(index * ((Result?.Buckets.Count ?? 1) - 1d) / Math.Max(1, Math.Min(6, Result?.Buckets.Count ?? 0) - 1))).Distinct();
    private static string Iso(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private static string Number(decimal? value) => value.HasValue ? value.Value.ToString("N2", English) : "—";
    private static string Coordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string AxisNumber(double value) => value.ToString("0.##", English);
    private string PeriodLabel(ExportSalesPeriod period) => period switch { ExportSalesPeriod.Day => T["Day"], ExportSalesPeriod.Month => T["Month"], ExportSalesPeriod.Year => T["Year"], _ => T["Custom"] };
    private DateTimeOffset Local(DateTimeOffset time) => TimeZoneInfo.ConvertTime(time, TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId));
    private string AxisLabel(ExportSaleBucket bucket) => Local(bucket.Start).ToString(Result!.Request.Period == ExportSalesPeriod.Day ? "HH:mm" : Result.Request.Period == ExportSalesPeriod.Year ? "MMM" : "d MMM", English);
    private string BucketTime(ExportSaleBucket bucket) => Result!.Request.Period == ExportSalesPeriod.Day
        ? Local(bucket.Start).ToString("d MMM HH:mm (zzz)", English) + " – " + Local(bucket.End).ToString("HH:mm (zzz)", English)
        : Result.Request.Period == ExportSalesPeriod.Year ? Local(bucket.Start).ToString("MMMM yyyy", English) : Local(bucket.Start).ToString("dd MMMM yyyy", English);
    private string BucketDescription(ExportSaleBucket bucket) => BucketTime(bucket)
        + " · " + Local(bucket.Start).ToString("d MMMM yyyy HH:mm (zzz)", English) + " – " + Local(bucket.End).ToString("d MMMM yyyy HH:mm (zzz)", English)
        + T.Format(": exported {0} kWh, after hourly netting {1} kWh, value {2} PLN. Readings {3} of {4} h.", Number(bucket.ExpectedHours > 0 ? bucket.ExportKwh : null), Number(bucket.ExpectedHours > 0 ? bucket.CreditedExportKwh : null), Number(bucket.ExpectedHours > 0 ? bucket.EnergyValuePln : null), bucket.ObservedHours, bucket.ExpectedHours)
        + (ProgressFor(bucket) is { } progress ? " " + T["Completed hours only."] + " " + ProgressDescription(progress) : "");
    private string ProgressTime(ExportSaleProgress progress) => progress.ObservedThrough is { } through
        ? T.Format("Measured through {0}", Local(through).ToString("d MMMM HH:mm (zzz)", English)) : T["Awaiting current-hour readings."];
    private string ProgressDescription(ExportSaleProgress progress) => T.Format("Current hour · in progress. {0} Exported so far {1} kWh, after hourly netting {2} kWh, provisional value {3} PLN. Measured intervals only; no projection to the end of the hour.", ProgressTime(progress), Number(progress.ExportKwh), Number(progress.CreditedExportKwh), Number(progress.EnergyValuePln));

    protected override void OnInitialized()
    {
        _selection = new(ExportSalesPeriod.Day, Today);
        _from = _through = Today;
        SetCustomInputs();
    }
    protected override void OnParametersSet()
    {
        if (Data is { } data)
        {
            _selection = data.Request;
            _from = data.Request.From ?? data.Request.Date;
            _through = data.Request.Through ?? data.Request.Date;
            SetCustomInputs();
        }
        else if (InitialRequest is { } initial && initial != _appliedInitialRequest)
        {
            _appliedInitialRequest = initial;
            _selection = initial;
            _from = initial.From ?? initial.Date;
            _through = initial.Through ?? initial.Date;
            _followToday = initial.Period == ExportSalesPeriod.Day && initial.Date == Today;
            SetCustomInputs();
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Data is not null) return;
        _refreshTask = RefreshLoopAsync(_lifetime.Token);
        await LoadAsync();
    }
    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(5), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(() => !_disposed && !_loading && Data is null ? RefreshAsync() : Task.CompletedTask).WaitAsync(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    private void OnBreakpointChanged(Breakpoint breakpoint) => _compact = breakpoint is Breakpoint.Xs or Breakpoint.Sm;

    private static (DateOnly From, DateOnly Through) PeriodBounds(ExportSalesRequest request) => request.Period switch
    {
        ExportSalesPeriod.Day => (request.Date, request.Date),
        ExportSalesPeriod.Month => (new(request.Date.Year, request.Date.Month, 1), new(request.Date.Year, request.Date.Month, DateTime.DaysInMonth(request.Date.Year, request.Date.Month))),
        ExportSalesPeriod.Year => (new(request.Date.Year, 1, 1), new(request.Date.Year, 12, 31)),
        _ => (request.From ?? request.Date, request.Through ?? request.Date)
    };
    private static string PeriodCaption(ExportSalesRequest request)
    {
        var bounds = PeriodBounds(request);
        return request.Period switch
        {
            ExportSalesPeriod.Day => request.Date.ToString("d MMMM yyyy", English),
            ExportSalesPeriod.Month => request.Date.ToString("MMMM yyyy", English),
            ExportSalesPeriod.Year => request.Date.Year.ToString(CultureInfo.InvariantCulture),
            _ => bounds.From.ToString("d MMMM yyyy", English) + " – " + bounds.Through.ToString("d MMMM yyyy", English)
        };
    }
    private async Task ChangePeriod(ExportSalesPeriod period)
    {
        if (_selection.Period == period) return;
        _selection = new(period, _selection.Date);
        _validation = null;
        if (period == ExportSalesPeriod.Custom)
        {
            _from = _through = _selection.Date;
            SetCustomInputs();
            _selection = _selection with { From = _from, Through = _through };
            _followToday = false;
        }
        await LoadAsync();
    }
    private async Task MovePeriod(int direction)
    {
        if (direction < 0 ? !CanPrevious : !CanNext) return;
        var date = _selection.Period switch
        {
            ExportSalesPeriod.Month => new DateOnly(_selection.Date.Year, _selection.Date.Month, 1).AddMonths(direction),
            ExportSalesPeriod.Year => new DateOnly(_selection.Date.Year, 1, 1).AddYears(direction),
            _ => _selection.Date.AddDays(direction)
        };
        _selection = _selection with { Date = date };
        _followToday = false;
        _validation = null;
        await LoadAsync();
    }
    private async Task GoToToday()
    {
        _selection = new(ExportSalesPeriod.Day, Today);
        _from = _through = Today;
        SetCustomInputs();
        _followToday = true;
        _validation = null;
        await LoadAsync();
    }
    private async Task ChangeDate(ChangeEventArgs args)
    {
        var text = args.Value?.ToString() ?? "";
        DateOnly date;
        var valid = _selection.Period switch
        {
            ExportSalesPeriod.Year => DateOnly.TryParseExact(text + "-01-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out date),
            ExportSalesPeriod.Month => DateOnly.TryParseExact(text + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out date),
            _ => DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out date)
        };
        if (!valid || date.Year < 2000 || date > Today) { _validation = T["Choose a date from 2000 onwards and no later than today."]; return; }
        _selection = _selection with { Date = date };
        _followToday = false;
        _validation = null;
        await LoadAsync();
    }
    private void ChangeFrom(ChangeEventArgs args) => ChangeCustomDate(args, true);
    private void ChangeThrough(ChangeEventArgs args) => ChangeCustomDate(args, false);
    private void SetCustomInputs() { _fromInput = Iso(_from); _throughInput = Iso(_through); }
    private void ChangeCustomDate(ChangeEventArgs args, bool from)
    {
        if (from) _fromInput = args.Value?.ToString() ?? ""; else _throughInput = args.Value?.ToString() ?? "";
        if (!DateOnly.TryParseExact(_fromInput, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)
            || !DateOnly.TryParseExact(_throughInput, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end))
        { _validation = T["Enter both dates."]; return; }
        _from = start;
        _through = end;
        _validation = _from.Year < 2000 ? T["The start date must be in 2000 or later."]
            : _through < _from ? T["The end date must not be before the start date."]
            : _through > Today ? T["The end date cannot be in the future."]
            : _through.DayNumber - _from.DayNumber > 365 ? T["Choose no more than 366 days, inclusive."] : null;
    }
    private async Task ApplyCustom()
    {
        if (_validation is not null) return;
        _selection = new(ExportSalesPeriod.Custom, _through, _from, _through);
        _followToday = false;
        await LoadAsync();
    }
    private void MoveBucket(int delta) => _selected = Math.Clamp(SelectedIndex + delta, 0, Math.Max(0, (Result?.Buckets.Count ?? 1) - 1));

    private Task LoadAsync() => LoadAsync(false);
    private Task RefreshAsync() => LoadAsync(true);
    private async Task LoadAsync(bool preserveData)
    {
        if (_disposed || Data is not null) return;
        if (_followToday) _selection = _selection with { Date = Today };
        _active?.Cancel();
        using var request = new CancellationTokenSource();
        _active = request;
        var version = ++_version;
        var selection = _selection;
        var previous = _data;
        if (!preserveData)
        {
            _data = null;
            _selected = null;
        }
        _loading = true;
        if (!preserveData) _error = null;
        StateHasChanged();
        try
        {
            var result = await SalesService.ReadAsync(selection, request.Token);
            if (!_disposed && !request.IsCancellationRequested && version == _version)
            {
                // The selected interval belongs to the displayed window, never to its replacement day.
                var selectedStart = preserveData && _selected.HasValue ? Selected?.Start : null;
                _selected = null;
                if (selectedStart.HasValue && previous is not null && previous.Request == result.Request
                    && previous.Start == result.Start && previous.End == result.End)
                {
                    var index = result.Buckets.ToList().FindIndex(bucket => bucket.Start == selectedStart.Value);
                    if (index >= 0) _selected = index;
                }
                _data = result;
                _error = null;
            }
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!_disposed && version == _version) _error = preserveData && _data is not null
                ? T["Refresh failed. Showing previous data; values may be out of date. Please retry."]
                : T["Sales could not be loaded. Please try again."];
        }
        finally
        {
            if (version == _version)
            {
                _active = null;
                _loading = false;
                if (!_disposed) StateHasChanged();
            }
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _version++;
        _active?.Cancel();
        _lifetime.Cancel();
        if (_refreshTask is not null) await _refreshTask;
        _lifetime.Dispose();
    }
}
