@using System.Globalization
@using DeyeSolar.Domain.Options
@using DeyeSolar.Web.Services
@using Microsoft.Extensions.Options
@inject SolarEstimateService EstimateService
@inject InverterDataSnapshot InverterSnapshot
@inject IOptionsMonitor<SolarEstimateOptions> EstimateOptions
@inject IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject IInverterRefreshService InverterRefresh
@inject TimeProvider Clock
@implements IAsyncDisposable

@if (Detailed)
{
    <div class="solar-detail-chart"><SolarHistoryChart @ref="_history" Data="HistoryData" ShowTable="true" /></div>
}
<MudPaper Class="pa-4" Elevation="2">
    <section class="solar-card" aria-labelledby="solar-card-title">
        <div class="solar-heading">
            <MudIcon Icon="@Icons.Material.Filled.WbSunny" Color="Color.Warning" Size="Size.Small" />
            <h2 id="solar-card-title">@(Overview ? T["Possible generation"] : T["Latest solar snapshot"])</h2>
            <details class="solar-info @(HasWarning ? "solar-info-warning" : "")">
                <summary aria-label="@T["Data sources and timestamps"]" title="@T["Data sources and timestamps"]">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                </summary>
                <div class="solar-info-panel">
                    <strong>@CurrentOptions.LocationLabel</strong>
                    <p>@EstimateInfo</p>
                    @if (IsWeatherModel && SourceTimestamp is { } sourceAt)
                    {
                        <p>@T["Weather retrieved at"] @FormatTime(sourceAt).</p>
                    }
                    @if (EstimateNotice is { } estimateNotice)
                    {
                        <p class="solar-info-notice">@estimateNotice</p>
                    }
                    <p>@ActualInfo</p>
                    @if (!PvDcConfirmed)
                    {
                        <p class="solar-info-notice">@T["The inverter power type is unconfirmed. Values are not compared."]</p>
                    }
                    <div class="solar-attribution">
                        <a href="@(IsWeatherModel ? "https://open-meteo.com/en/docs" : "https://open-meteo.com/en/docs/satellite-radiation-api")"
                           target="_blank" rel="noopener noreferrer">@(IsWeatherModel ? "Open-Meteo" : "Open-Meteo · DWD / EUMETSAT")</a>
                        · <a href="https://open-meteo.com/en/licence" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>
                    </div>
                </div>
            </details>
        </div>
        <div class="solar-actions">
            <button type="button" @onclick="RefreshSourcesAsync" disabled="@(_refreshing || Refreshing)" aria-label="@T["Refresh possible generation"]">@(_refreshing || Refreshing ? T["Refreshing…"] : T["Refresh"])</button>
            @if (!Detailed)
            {
                <a href="@DetailsUrl" aria-label="@T["Possible generation details"]">@T["Details"]</a>
            }
        </div>
        @if (_refreshError is not null) { <p class="solar-notice" role="alert">@T.Translate(_refreshError)</p> }
        <div class="solar-readings">
            <div class="solar-reading solar-reading-actual">
                <span class="solar-label" id="solar-actual-label">@T["Latest inverter generation"]</span>
                <output class="solar-value" aria-labelledby="solar-actual-label" data-testid="solar-actual">
                    @if (HasUsableActual && CurrentActual is { } actual)
                    {
                        @Number(actual.SolarProduction / 1000d)<span class="solar-unit">kW</span>
                    }
                    else
                    {
                        <span class="solar-unavailable" aria-label="@T["The inverter reading is unavailable"]">—</span>
                    }
                </output>
            </div>
            <div class="solar-reading solar-reading-possible">
                <span class="solar-label" id="solar-possible-label">@T["Possible"]</span>
                <output class="solar-value" aria-labelledby="solar-possible-label" data-testid="solar-possible">
                    @if (HasUsableEstimate && Estimate is { } estimate)
                    {
                        @Number(estimate.CentralKw)<span class="solar-unit">kW</span>
                    }
                    else
                    {
                        <span class="solar-unavailable" aria-label="@T["Estimate unavailable"]">—</span>
                    }
                </output>
            </div>
        </div>
        <p class="solar-timestamps">@ActualInfo</p>
        <p class="solar-timestamps">@EstimateInfo</p>
        @if (EstimateNotice is { } notice) { <p class="solar-notice" role="status">@notice</p> }
        @if (Overview)
        {
            <p class="solar-timestamps">@T["The chart shows hourly average power. The latest inverter reading is separate; missing hours remain gaps."]</p>
            <SolarHistoryChart @ref="_history" Data="HistoryData" Overview="true" Embedded="true" />
        }
        @if (Detailed)
        {
            <section class="solar-detail-section" aria-labelledby="solar-calculation-title">
                <h2 id="solar-calculation-title">@T["Weather calculation"]</h2>
                @if (Estimate is { } detailedEstimate)
                {
                    <dl class="solar-metadata">
                        <div><dt>@T["Central estimate"]</dt><dd>@Number(detailedEstimate.CentralKw) kW</dd></div>
                        <div><dt>@T["Calculated range"]</dt><dd>@Number(detailedEstimate.LowerKw) – @Number(detailedEstimate.UpperKw) kW</dd></div>
                        <div><dt>@T["Power basis"]</dt><dd>@BasisLabel(detailedEstimate.Basis)</dd></div>
                        <div><dt>@T["Installed solar capacity"]</dt><dd>@Number(detailedEstimate.TotalKwp) kWp</dd></div>
                        <div><dt>@T["Estimate time"]</dt><dd><time datetime="@detailedEstimate.Timestamp.ToString("O")">@FormatTime(detailedEstimate.Timestamp)</time></dd></div>
                        <div><dt>@T["Calculated at"]</dt><dd><time datetime="@detailedEstimate.CalculatedAt.ToString("O")">@FormatTime(detailedEstimate.CalculatedAt)</time></dd></div>
                        <div><dt>@(IsWeatherModel ? T["Model radiation time"] : T["Radiation observation"])</dt><dd>@FormatTime(detailedEstimate.Observation.Timestamp)</dd></div>
                        <div><dt>@(IsWeatherModel ? T["Model weather time"] : T["Weather observation"])</dt><dd>@(detailedEstimate.Observation.WeatherTimestamp is { } weatherAt ? FormatTime(weatherAt) : T["Unavailable"])</dd></div>
                        <div><dt>@T["Weather retrieved"]</dt><dd>@(detailedEstimate.Observation.RetrievedAt is { } retrievedAt ? FormatTime(retrievedAt) : T["Unavailable"])</dd></div>
                    </dl>
                    @if (detailedEstimate.WeatherMissing) { <p class="solar-notice">@T["Some weather inputs are missing; the calculated uncertainty range includes weather assumptions."]</p> }
                    <p class="solar-timestamps">@T["The range is an engineering estimate, not a statistical confidence interval. Refresh reloads the latest server results; timestamps identify the weather data used."]</p>
                }
                else { <p class="solar-timestamps">@T["No weather estimate is available."]</p> }
            </section>
            <section class="solar-detail-section" aria-labelledby="solar-comparison-title">
                <h2 id="solar-comparison-title">@T["Time-aligned comparison"]</h2>
                <p class="solar-timestamps">@ComparisonLabel</p>
                @if (CurrentState.Comparison.Actual is { } historical)
                {
                    <dl class="solar-metadata">
                        <div><dt>@T["Historical inverter power"]</dt><dd>@Number(historical.PowerKw) kW</dd></div>
                        <div><dt>@T["Inverter measurement time"]</dt><dd><time datetime="@historical.Timestamp.ToString("O")">@FormatTime(historical.Timestamp)</time></dd></div>
                        <div><dt>@T["Inverter power basis"]</dt><dd>@BasisLabel(historical.Basis)</dd></div>
                        @if (ComparisonEstimate is { } comparisonEstimate)
                        {
                            <div><dt>@T["Estimate for comparison"]</dt><dd>@Number(comparisonEstimate.CentralKw) kW</dd></div>
                            <div><dt>@T["Comparison range"]</dt><dd>@Number(comparisonEstimate.LowerKw) – @Number(comparisonEstimate.UpperKw) kW</dd></div>
                            <div><dt>@T["Comparison estimate time"]</dt><dd><time datetime="@comparisonEstimate.Timestamp.ToString("O")">@FormatTime(comparisonEstimate.Timestamp)</time></dd></div>
                        }
                        @if (HasVerifiedComparison)
                        {
                            <div><dt>@T["Inverter minus estimate"]</dt><dd>@OptionalNumber(CurrentState.Comparison.DeviationKw) kW</dd></div>
                            <div><dt>@T["Deviation"]</dt><dd>@OptionalNumber(CurrentState.Comparison.DeviationPercent) %</dd></div>
                        }
                    </dl>
                }
                @if (!HasVerifiedComparison) { <p class="solar-notice">@T.Translate(CurrentState.Comparison.Reason ?? T["A verified comparison is not available."])</p> }
                <p class="solar-timestamps">@T["This historical reading can differ from the latest inverter snapshot. The server checks age, measurement type and timestamp alignment. A percentage may be unavailable at night or at very low power."]</p>
            </section>
            <div class="solar-attribution"><a href="https://open-meteo.com/en/docs" target="_blank" rel="noopener noreferrer">@T["Open-Meteo weather"]</a> · <a href="https://open-meteo.com/en/licence" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></div>
        }
    </section>
</MudPaper>

@code {
    [Parameter] public SolarEstimateState? State { get; set; }
    [Parameter] public InverterData? Actual { get; set; }
    [Parameter] public SolarEstimateOptions? Options { get; set; }
    [Parameter] public DateTimeOffset? Now { get; set; }
    [Parameter] public SolarHistoryResult? HistoryData { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Detailed { get; set; }
    [Parameter] public bool Refreshing { get; set; }
    [Parameter] public EventCallback OnRefreshInverter { get; set; }
    [Parameter] public string ReturnTo { get; set; } = "/generation";
    private SolarHistoryChart? _history;
    private bool _refreshing;
    private string? _refreshError;
    private string DetailsUrl => "/solar-details?returnTo=" + Uri.EscapeDataString(EnergyDetailsNavigation.ReturnPath(ReturnTo));

    private static CultureInfo DisplayCulture => CultureInfo.CurrentCulture;
    private readonly AsyncQueryScope _queries = new();
    private DateTimeOffset _clock = DateTimeOffset.UtcNow;
    private bool _disposed;

    private SolarEstimateState CurrentState => State ?? EstimateService.Current;
    private InverterData? CurrentActual => Actual ?? InverterSnapshot.Current;
    private SolarEstimateOptions CurrentOptions => Options ?? EstimateOptions.CurrentValue;
    private DateTimeOffset ClockNow => Now ?? _clock;
    private SolarPowerEstimate? Estimate => CurrentState.Estimate;
    private SolarPowerEstimate? ComparisonEstimate => CurrentState.ComparisonEstimate ?? (Estimate?.Observation.Kind == SolarRadiationKind.Satellite ? Estimate : null);
    private bool HasVerifiedComparison => PvDcConfirmed && !CurrentState.RefreshFailed && CurrentState.Error is null
        && CurrentState.Comparison.Status != SolarComparisonStatus.InsufficientData && ComparisonEstimate is not null;
    private string ComparisonLabel => !HasVerifiedComparison ? T["Comparison unavailable"] : CurrentState.Comparison.Status switch
        { SolarComparisonStatus.WithinRange => T["Within estimate range"], SolarComparisonStatus.BelowEstimate => T["Below estimate range"], _ => T["Above estimate range"] };
    private bool PvDcConfirmed => CurrentOptions.DeyeSolarPowerIsPvDcConfirmed
        && !string.IsNullOrWhiteSpace(CurrentOptions.DeyeConfirmedDeviceSn)
        && CurrentOptions.DeyeConfirmedDeviceSn == InverterOptions.CurrentValue.DeviceKey;
    private bool IsWeatherModel => Estimate is null || Estimate.Observation.Kind == SolarRadiationKind.WeatherModel;
    private DateTimeOffset? SourceTimestamp => IsWeatherModel
        ? Estimate?.Observation.RetrievedAt ?? Estimate?.Timestamp : Estimate?.Timestamp;
    private int StaleAfterMinutes => IsWeatherModel ? CurrentOptions.NowcastStaleAfterMinutes : CurrentOptions.StaleAfterMinutes;
    private int MaximumAgeMinutes => IsWeatherModel ? CurrentOptions.NowcastMaximumAgeMinutes : CurrentOptions.MaximumAgeMinutes;
    private int ActualMaximumAgeMinutes => CurrentOptions.NowcastActualMaximumAgeMinutes;
    private bool EvaluationStopped => IsWeatherModel && Estimate is { } estimate && (ClockNow - estimate.Timestamp).TotalMinutes > 2;
    private bool HasUsableEstimate => Estimate is { } estimate && double.IsFinite(estimate.CentralKw) && estimate.CentralKw >= 0
        && estimate.Timestamp <= ClockNow && !EvaluationStopped
        && SourceTimestamp is { } sourceAt && sourceAt <= ClockNow && (ClockNow - sourceAt).TotalMinutes <= MaximumAgeMinutes;
    private string? ActualDeviceIssue => string.IsNullOrWhiteSpace(CurrentActual?.SolarDeviceSn)
        || string.IsNullOrWhiteSpace(InverterOptions.CurrentValue.DeviceKey) ? T["The inverter reading's device is unverified"]
        : CurrentActual.SolarDeviceSn != InverterOptions.CurrentValue.DeviceKey ? T["The reading belongs to another inverter"] : null;
    private bool HasUsableActual => ActualDeviceIssue is null && CurrentActual is { SolarObservedAt: { } observedAt, SolarProduction: >= 0 }
        && observedAt <= ClockNow && (ClockNow - observedAt).TotalMinutes <= ActualMaximumAgeMinutes;
    private string? EstimateNotice => EvaluationStopped ? T["The calculation has stopped updating. The estimate is unavailable."]
        : !HasUsableEstimate ? T["The estimate is unavailable. Waiting for fresh data."]
        : CurrentState.RefreshFailed ? T["Weather refresh failed. The latest available data is used."]
        : SourceTimestamp is { } sourceAt && (ClockNow - sourceAt).TotalMinutes > StaleAfterMinutes ? T["Weather data is stale. The estimate is approximate."]
        : null;
    private bool HasWarning => EstimateNotice is not null || !HasUsableActual || !PvDcConfirmed;
    private string EstimateInfo => Estimate is { } estimate
        ? T.Format("{0} · {1}. At {2}.", (IsWeatherModel ? T["Weather estimate"] : T["Satellite estimate"]), (estimate.Basis == SolarPowerBasis.Ac ? "AC" : "PV DC"), FormatTime(estimate.Timestamp))
        : T["No weather estimate has been received yet."];
    private string ActualInfo => CurrentActual is not { SolarProduction: >= 0 } actual ? T["The inverter reading is unavailable."]
        : ActualDeviceIssue is { } deviceIssue ? deviceIssue + "."
        : actual.SolarObservedAt is not { } observedAt ? T["The inverter measurement time is unverified."]
        : observedAt > ClockNow ? T["The inverter measurement time is invalid."]
        : T.Format("{0}. Measured at {1}.", ((ClockNow - observedAt).TotalMinutes > ActualMaximumAgeMinutes ? T["The inverter reading is stale"] : PvDcConfirmed ? T["Inverter · PV DC"] : T["Inverter"]), FormatTime(observedAt));

    protected override void OnInitialized()
    {
        _clock = Clock.GetUtcNow();
        EstimateService.OnUpdated += OnUpdated;
        InverterSnapshot.OnDataUpdated += OnUpdated;
        _queries.StartRefresh(Clock, TimeSpan.FromSeconds(30), RefreshAsync);
    }

    private void OnUpdated() => _ = RefreshAsync();

    private async Task RefreshSourcesAsync()
    {
        if (_disposed || _refreshing || Refreshing) return;
        _refreshing = true;
        _refreshError = null;
        try
        {
            var inverter = OnRefreshInverter.HasDelegate ? OnRefreshInverter.InvokeAsync() : InverterRefresh.RefreshAsync(_queries.LifetimeToken);
            await Task.WhenAll(inverter, _history?.RefreshDataAsync() ?? Task.CompletedTask);
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_disposed || _queries.LifetimeToken.IsCancellationRequested) { }
        catch (Exception) { if (!_disposed) _refreshError = T["Could not refresh inverter readings. Showing the last available results; please try again."]; }
        finally { if (!_disposed) _refreshing = false; }
    }

    private async Task RefreshAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                _clock = Clock.GetUtcNow();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (InvalidOperationException) when (_disposed) { }
    }

    private static string Number(double value) => value.ToString("F2", DisplayCulture);
    private static string OptionalNumber(double? value) => value.HasValue && double.IsFinite(value.Value) ? Number(value.Value) : "—";
    private string BasisLabel(SolarPowerBasis basis) => basis switch { SolarPowerBasis.PvDc => T["PV DC generation"], SolarPowerBasis.Ac => T["Inverter AC power"], _ => T["Grid export"] };
    private string FormatTime(DateTimeOffset timestamp) => TimeZoneInfo.ConvertTime(timestamp,
        TimeZoneInfo.FindSystemTimeZoneById(CurrentOptions.TimeZoneId)).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", DisplayCulture);

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        EstimateService.OnUpdated -= OnUpdated;
        InverterSnapshot.OnDataUpdated -= OnUpdated;
        await _queries.DisposeAsync();
    }
}
