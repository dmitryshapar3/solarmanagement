@using System.Globalization
@using DeyeSolar.Domain.Options
@using DeyeSolar.Web.Services
@using Microsoft.Extensions.Options
@inject SolarEstimateService EstimateService
@inject InverterDataSnapshot InverterSnapshot
@inject IOptionsMonitor<SolarEstimateOptions> EstimateOptions
@inject IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject IInverterRefreshService InverterRefresh
@inject TimeProvider Clock
@implements IAsyncDisposable

<section class="solar-snapshot @(Hero?IsNight?"solar-night":"solar-hero":null)" aria-labelledby="solar-card-title"><div class="hero-header"><div><h2 id="solar-card-title">@(Hero?T["Solar now"]:T["Latest solar snapshot"])</h2><p class="caption">@CurrentOptions.LocationLabel</p></div><StatusPill Dot="false">@(HasUsableActual?T["Inverter reading"]:T["Awaiting reading"])</StatusPill></div>
@if(IsNight){<h3>@T[HomeRunsOnBattery?"The sun has set. Home runs on battery.":"The sun has set."]</h3><p class="caption">@T.Format("Next sunrise {0}",T.Time(NightSunrise!.Value,ProductionData!.TimeZoneId,"d MMM HH:mm"))</p>}
<div class="solar-reading" data-testid="solar-actual"><strong class="@(Hero?"hero-number":"metric")">@(HasUsableActual&&CurrentActual is {} actual?Number(actual.SolarProduction/1000d):"—")<small class="unit"> kW</small></strong></div><p class="caption">@ActualInfo</p>
<div class="toolbar"><span>@T["Expected now"] <strong data-testid="solar-possible">@(HasUsableEstimate&&Estimate is {} estimate?Number(estimate.CentralKw):"—") kW</strong></span>@if(Estimate is {} range&&HasUsableEstimate){<span class="caption">@Number(range.LowerKw)–@Number(range.UpperKw) kW</span>}</div>
@if(Hero&&!IsNight){<p class="caption" role="status" data-testid="hero-comparison">@HeroComparisonLabel</p>}
@if(EstimateNotice is {} notice){<p class="caption" role="status">@notice</p>}
@if(Hero&&ProductionData is not null){<ProductionPlot Data="ProductionData" Compact="true"/>}
@if(!Hero){<p class="caption">@EstimateInfo</p><details><summary>@T["Data sources and timestamps"]</summary><p>@ActualInfo</p><p>@EstimateInfo</p>@if(SourceTimestamp is {} retrieved){<p>@T["Weather retrieved at"] @FormatTime(retrieved)</p>}@if(!PvDcConfirmed){<p>@T["The inverter power type is unconfirmed. Values are not compared."]</p>}<p>@ComparisonLabel</p>@if(CurrentState.Comparison.Actual is {} historical){<p>@T["Historical inverter power"] @Number(historical.PowerKw) kW · @FormatTime(historical.Timestamp)</p>}@if(HasVerifiedComparison){<p>@T["Inverter minus estimate"] @OptionalNumber(CurrentState.Comparison.DeviationKw) kW · @OptionalNumber(CurrentState.Comparison.DeviationPercent)%</p>}@if(Estimate is {} detail){<dl class="metadata"><div><dt>@T["Installed solar capacity"]</dt><dd>@Number(detail.TotalKwp) kWp</dd></div><div><dt>@T["Power basis"]</dt><dd>@BasisLabel(detail.Basis)</dd></div><div><dt>@T["Calculated at"]</dt><dd>@FormatTime(detail.CalculatedAt)</dd></div></dl>}</details>}
<div class="toolbar caption"><span>@EstimateInfo</span><a href="/energy">@T["View production"] →</a></div><p class="attribution">@if(IsWeatherModel){<a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">@T["Weather data by Open-Meteo.com, CC BY 4.0"]</a>}else{<span>DWD / EUMETSAT · @T["Satellite radiation data"]</span>}</p></section>

@code {
    [Parameter] public SolarEstimateState? State { get; set; }
    [Parameter] public InverterData? Actual { get; set; }
    [Parameter] public SolarEstimateOptions? Options { get; set; }
    [Parameter] public DateTimeOffset? Now { get; set; }
    [Parameter] public SolarHistoryResult? HistoryData { get; set; }
    [Parameter] public bool Hero {get;set;}
    [Parameter] public DeyeSolar.Web.Redesign.ProductionViewDto? ProductionData {get;set;}
    [Parameter] public bool HomeRunsOnBattery {get;set;}
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Detailed { get; set; }
    [Parameter] public bool Refreshing { get; set; }
    [Parameter] public EventCallback OnRefreshInverter { get; set; }
    [Parameter] public string ReturnTo { get; set; } = "/generation";
    private bool _refreshing;
    private string? _refreshError;
    private string DetailsUrl => "/energy";

    private CultureInfo DisplayCulture => T.Culture;
    private readonly AsyncQueryScope _queries = new();
    private DateTimeOffset _clock = DateTimeOffset.UtcNow;
    private bool _disposed;

    private SolarEstimateState CurrentState => State ?? EstimateService.Current;
    private InverterData? CurrentActual => Actual ?? InverterSnapshot.Current;
    private SolarEstimateOptions CurrentOptions => Options ?? EstimateOptions.CurrentValue;
    private DateTimeOffset ClockNow => Now ?? _clock;
    private DateTimeOffset? NightSunrise => Hero ? HomePresentation.NightSunrise(ProductionData,ClockNow) : null;
    private bool IsNight => NightSunrise.HasValue;
    private string HeroComparisonLabel => !PvDcConfirmed || !HasUsableActual || !HasUsableEstimate || CurrentState.RefreshFailed
        || CurrentState.Error is not null || Estimate is not {Basis:SolarPowerBasis.PvDc} expected
        || !double.IsFinite(expected.LowerKw) || !double.IsFinite(expected.UpperKw) || expected.LowerKw<0 || expected.UpperKw<expected.LowerKw
        ? T["Comparison unavailable"] : CurrentActual!.SolarProduction/1000d<expected.LowerKw ? T["Below estimate range"]
        : CurrentActual.SolarProduction/1000d>expected.UpperKw ? T["Above estimate range"] : T["Within estimate range"];
    private SolarPowerEstimate? Estimate => CurrentState.Estimate;
    private SolarPowerEstimate? ComparisonEstimate => CurrentState.ComparisonEstimate ?? (Estimate?.Observation.Kind == SolarRadiationKind.Satellite ? Estimate : null);
    private bool HasVerifiedComparison => PvDcConfirmed && !CurrentState.RefreshFailed && CurrentState.Error is null
        && CurrentState.Comparison.Status != SolarComparisonStatus.InsufficientData && ComparisonEstimate is not null;
    private string ComparisonLabel => !HasVerifiedComparison ? T["Comparison unavailable"] : CurrentState.Comparison.Status switch
        { SolarComparisonStatus.WithinRange => T["Within estimate range"], SolarComparisonStatus.BelowEstimate => T["Below estimate range"], _ => T["Above estimate range"] };
    private bool PvDcConfirmed => CurrentOptions.DeyeSolarPowerIsPvDcConfirmed
        && !string.IsNullOrWhiteSpace(CurrentOptions.DeyeConfirmedDeviceSn)
        && CurrentOptions.DeyeConfirmedDeviceSn == InverterOptions.CurrentValue.DeviceKey;
    private bool IsWeatherModel => Estimate is null || Estimate.Observation.Kind == SolarRadiationKind.WeatherModel;
    private DateTimeOffset? SourceTimestamp => IsWeatherModel
        ? Estimate?.Observation.RetrievedAt ?? Estimate?.Timestamp : Estimate?.Timestamp;
    private int StaleAfterMinutes => IsWeatherModel ? CurrentOptions.NowcastStaleAfterMinutes : CurrentOptions.StaleAfterMinutes;
    private int MaximumAgeMinutes => IsWeatherModel ? CurrentOptions.NowcastMaximumAgeMinutes : CurrentOptions.MaximumAgeMinutes;
    private int ActualMaximumAgeMinutes => CurrentOptions.NowcastActualMaximumAgeMinutes;
    private bool EvaluationStopped => IsWeatherModel && Estimate is { } estimate && (ClockNow - estimate.Timestamp).TotalMinutes > 2;
    private bool HasUsableEstimate => Estimate is { } estimate && double.IsFinite(estimate.CentralKw) && estimate.CentralKw >= 0
        && estimate.Timestamp <= ClockNow && !EvaluationStopped
        && SourceTimestamp is { } sourceAt && sourceAt <= ClockNow && (ClockNow - sourceAt).TotalMinutes <= MaximumAgeMinutes;
    private string? ActualDeviceIssue => string.IsNullOrWhiteSpace(CurrentActual?.SolarDeviceSn)
        || string.IsNullOrWhiteSpace(InverterOptions.CurrentValue.DeviceKey) ? T["The inverter reading's device is unverified"]
        : CurrentActual.SolarDeviceSn != InverterOptions.CurrentValue.DeviceKey ? T["The reading belongs to another inverter"] : null;
    private bool HasUsableActual => ActualDeviceIssue is null && CurrentActual is { SolarObservedAt: { } observedAt, SolarProduction: >= 0, SolarPowerValid: true }
        && observedAt <= ClockNow && (ClockNow - observedAt).TotalMinutes <= ActualMaximumAgeMinutes;
    private string? EstimateNotice => EvaluationStopped ? T["The calculation has stopped updating. The estimate is unavailable."]
        : !HasUsableEstimate ? T["The estimate is unavailable. Waiting for fresh data."]
        : CurrentState.RefreshFailed ? T["Weather refresh failed. The latest available data is used."]
        : SourceTimestamp is { } sourceAt && (ClockNow - sourceAt).TotalMinutes > StaleAfterMinutes ? T["Weather data is stale. The estimate is approximate."]
        : null;
    private bool HasWarning => EstimateNotice is not null || !HasUsableActual || !PvDcConfirmed;
    private string EstimateInfo => Estimate is { } estimate
        ? T.Format("{0} · {1}. At {2}.", (IsWeatherModel ? T["Weather estimate"] : T["Satellite estimate"]), (estimate.Basis == SolarPowerBasis.Ac ? "AC" : "PV DC"), FormatTime(estimate.Timestamp))
        : T["No weather estimate has been received yet."];
    private string ActualInfo => CurrentActual is not { SolarProduction: >= 0, SolarPowerValid: true } actual ? T["The inverter reading is unavailable."]
        : ActualDeviceIssue is { } deviceIssue ? deviceIssue + "."
        : actual.SolarObservedAt is not { } observedAt ? T["The inverter measurement time is unverified."]
        : observedAt > ClockNow ? T["The inverter measurement time is invalid."]
        : T.Format("{0}. Measured at {1}.", ((ClockNow - observedAt).TotalMinutes > ActualMaximumAgeMinutes ? T["The inverter reading is stale"] : PvDcConfirmed ? T["Inverter · PV DC"] : T["Inverter"]), FormatTime(observedAt));

    protected override void OnInitialized()
    {
        _clock = Clock.GetUtcNow();
        EstimateService.OnUpdated += OnUpdated;
        InverterSnapshot.OnDataUpdated += OnUpdated;
        _queries.StartRefresh(Clock, TimeSpan.FromSeconds(30), RefreshAsync);
    }

    private void OnUpdated() => _ = RefreshAsync();

    private async Task RefreshSourcesAsync()
    {
        if (_disposed || _refreshing || Refreshing) return;
        _refreshing = true;
        _refreshError = null;
        try
        {
            var inverter = OnRefreshInverter.HasDelegate ? OnRefreshInverter.InvokeAsync() : InverterRefresh.RefreshAsync(_queries.LifetimeToken);
            await inverter;
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_disposed || _queries.LifetimeToken.IsCancellationRequested) { }
        catch (Exception) { if (!_disposed) _refreshError = T["Could not refresh inverter readings. Showing the last available results; please try again."]; }
        finally { if (!_disposed) _refreshing = false; }
    }

    private async Task RefreshAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                _clock = Clock.GetUtcNow();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (InvalidOperationException) when (_disposed) { }
    }

    private string Number(double value) => value.ToString("F2", DisplayCulture);
    private string OptionalNumber(double? value) => value.HasValue && double.IsFinite(value.Value) ? Number(value.Value) : "—";
    private string BasisLabel(SolarPowerBasis basis) => basis switch { SolarPowerBasis.PvDc => T["PV DC generation"], SolarPowerBasis.Ac => T["Inverter AC power"], _ => T["Grid export"] };
    private string FormatTime(DateTimeOffset timestamp) => TimeZoneInfo.ConvertTime(timestamp,
        TimeZoneInfo.FindSystemTimeZoneById(CurrentOptions.TimeZoneId)).ToString("d MMM yyyy HH:mm:ss 'UTC'zzz", DisplayCulture);

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        EstimateService.OnUpdated -= OnUpdated;
        InverterSnapshot.OnDataUpdated -= OnUpdated;
        await _queries.DisposeAsync();
    }
}
