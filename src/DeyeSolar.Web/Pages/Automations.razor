@page "/automations"
@page "/automations/new"
@page "/automations/{Id:int}"
@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Data
@using DeyeSolar.Web.Auth
@inject InteractiveSecurityContext Security
@using System.Text.Json
@using SolarManagement.Inverters.Contracts
@inject DeyeSolar.Domain.Interfaces.IConfigurationRules Rules
@inject DeyeSolar.Domain.Interfaces.ISocketInventoryService Inventory
@inject IInverterCatalog Inverters
@inject RedesignQueries Queries
@inject NavigationManager Nav
@implements IAsyncDisposable
<PageTitle>@T["Automations"] · SmartSolar</PageTitle>
<PageHeader Title="@T["Automations"]" Subtitle="@T["Use your solar surplus automatically."]"><UiButton Href="@(_canManage?"/automations/new":null)" Disabled="@(!_canManage)" Variant="primary" Icon="plus">@T["New automation"]</UiButton></PageHeader>
@if (_error is not null) { <div class="banner critical" role="alert">@T.Translate(_error)</div> }
@if (_loading) { <UiState Kind="loading" Title="@T["Loading…"]" /> }
else { <div class="split-panel"><div class="selection-list">
@foreach(var rule in _rules) { <div class="selection-card @(Id==rule.Id?"selected":null)"><div class="toolbar"><a href="@($"/automations/{rule.Id}")"><h2>@rule.Name</h2></a><UiSwitch Value="@rule.Enabled" ValueChanged="value => Toggle(rule,value)" Busy="@(_busy==rule.Id)" Disabled="@(!_canManage||_saving)" Label="@T.Format("Enable {0}",rule.Name)" /></div><p class="rule-sentence">@Sentence(rule)</p><p class="caption">@T["Target device"]: @TargetName(rule)</p><div class="gallery-controls" style="margin-top:12px"><StatusPill Dot="false">@T.Format("Every {0} s",rule.IntervalSeconds)</StatusPill><StatusPill Dot="false">@T.Format("Wait {0} min",rule.CooldownMinutes)</StatusPill>@if(rule.ActiveFrom.HasValue) { <StatusPill Dot="false">@rule.ActiveFrom–@rule.ActiveTo</StatusPill> }</div><p class="caption">@(rule.PauseReason=="manual_override"?T["Paused since you switched this device by hand"]:rule.Enabled?rule.CurrentState?T["Running"]:T["Waiting"]:T["Paused"])</p></div> }
@if(_rules.Count==0) { <UiCard><UiState Title="@T["No automations yet"]" Message="@T["Create an automation or start with a template."]" /></UiCard> }
<UiCard Title="@T["Start with a template"]"><div class="form-stack"><UiButton Variant="outline" Disabled="@(!_canManage)" OnClick="() => Template(0)">@T["Use solar surplus"]</UiButton><UiButton Variant="outline" Disabled="@(!_canManage)" OnClick="() => Template(1)">@T["Keep a battery reserve"]</UiButton><UiButton Variant="outline" Disabled="@(!_canManage)" OnClick="() => Template(2)">@T["Daylight only"]</UiButton></div></UiCard></div>
@if(_draft is not null) { <CascadingValue Value="@_form" IsFixed="true"><UiCard Title="@(_new?T["New automation"]:T["Edit automation"])"><form @onsubmit="Save" @onsubmit:preventDefault><fieldset class="installation-fields" disabled="@(!_canManage||_saving)"><div class="form-stack">
<div class="ui-field"><label for="automation-name">@T["Name"]</label><input id="automation-name" @bind="_draft.Name" maxlength="100" required disabled="@_saving" /></div>
@if(_evaluation is not null) { <div class="ui-card" style="background:var(--fill);padding:16px"><h3>@T["Right now"]</h3><StatusPill Kind="@(_evaluation.Freshness=="current"?"neutral":"warning")" Dot="false">@T[_evaluation.Decision=="not_checked"?"Not checked yet":ActivityPresentation.Reason(_evaluation.Decision)]</StatusPill><p class="caption">@(_evaluation.CheckedAt is {} at?T.Format("Checked {0}",Time(at)):T["Not checked yet"])</p>@foreach(var condition in _evaluation.Conditions) { <div class="condition-row"><span>@ConditionLabel(condition.Kind)</span><strong>@ConditionValue(condition)</strong><span class="@(condition.Status=="passed"?"pass":"fail")">@T[condition.Status=="passed"?"Passed":condition.Status=="blocked"?"Blocked":condition.Status=="bypassed"?"Bypassed":condition.Status=="skipped"?"Skipped":"Unknown"]</span></div> }<p class="caption">@T["These are recorded values for the saved automation. Unsaved changes are not evaluated, and opening this page does not switch a device."]</p><p class="caption">@T[_evaluation.Freshness=="current"?"Fresh readings":_evaluation.Freshness=="stale"?"Waiting for fresh readings":_evaluation.Freshness is "configuration_changed" or "source_changed"?"Configuration changed":"Not checked yet"]</p>@if(_evaluation.NextCheckAt is {} next) { <p class="caption">@T.Format("Next check {0}",Time(next))</p> }</div> }
<h3>@T["Battery thresholds"]</h3>
@if(!_draft.UseSeparateSocTurnOffThreshold || !_new && _draft.SocTurnOffThreshold==_draft.SocTurnOnThreshold) { <div class="banner">@T["This existing automation uses a shared threshold. Enable separate thresholds to edit the range."]</div><label class="checkbox-row"><input type="checkbox" @bind="_draft.UseSeparateSocTurnOffThreshold" /><span>@T["Set separate turn OFF SOC"]</span></label> }
<div class="threshold-controls"><div class="threshold-labels"><span>@T["Switch off at"] @_draft.SocTurnOffThreshold%</span><span>@T["Switch on at"] @_draft.SocTurnOnThreshold%</span></div><input type="range" min="0" max="100" value="@_draft.SocTurnOffThreshold" @oninput="OffRange" disabled="@(!_draft.UseSeparateSocTurnOffThreshold)" aria-label="@T["Switch off threshold"]" /><input type="range" min="0" max="100" value="@_draft.SocTurnOnThreshold" @oninput="OnRange" aria-label="@T["Switch on threshold"]" /></div>
<div class="form-grid"><UiNumber Label="@T["Switch on at"]" Unit="%" Value="@_draft.SocTurnOnThreshold" ValueChanged="SetOn" Min="0" Max="100" Integer="true" /><UiNumber Label="@T["Switch off at"]" Unit="%" Value="@_draft.SocTurnOffThreshold" ValueChanged="SetOff" Min="0" Max="100" Integer="true" Disabled="@(!_draft.UseSeparateSocTurnOffThreshold)" /></div>
@if(_thresholdError is not null) { <p class="field-error" role="alert">@_thresholdError</p> }
<label class="checkbox-row"><input type="checkbox" @bind="_draft.UseSolarProductionThreshold" /><span>@T["Require solar"]</span></label>
@if(_draft.UseSolarProductionThreshold) { <UiNumber Label="@T["Solar averages at least"]" Unit="kW" Value="@(_draft.MinAverageSolarProductionWatts/1000d)" ValueChanged="value => _draft.MinAverageSolarProductionWatts=(int)Math.Round(value*1000)" Min=".001" Max="30" /><p class="field-hint">@T["Checked only while battery SOC is below 95%; bypassed at 95% or above"]</p> }
<div class="ui-field"><label for="automation-device">@T["Target device"]</label><select id="automation-device" @bind="_draft.EntityId" required><option value="">@T["Select a device"]</option>@foreach(var device in _devices) { <option value="@device.Id">@device.Name @(!device.Online?"· "+T["Offline"]:"")</option> }@if(!string.IsNullOrEmpty(_draft.EntityId) && !_devices.Any(d=>d.Id==_draft.EntityId)) { <option value="@_draft.EntityId">@T["Unavailable device"]</option> }</select></div>
<label class="checkbox-row"><input type="checkbox" @bind="_window" /><span>@T["Use a schedule window"]</span></label>
@if(_window) { <div class="form-grid"><div class="ui-field"><label for="automation-from">@T["From"]</label><input id="automation-from" type="time" value="@_from" @onchange="e => _from=e.Value?.ToString()??string.Empty" /></div><div class="ui-field"><label for="automation-to">@T["To"]</label><input id="automation-to" type="time" value="@_to" @onchange="e => _to=e.Value?.ToString()??string.Empty" /></div></div><p class="field-hint">@T["The saved schedule uses fixed times. Review it when daylight hours change."]</p> }
<details><summary>@T["Advanced"]</summary><div class="form-stack"><UiNumber Label="@T["Check every"]" Unit="s" Value="@_draft.IntervalSeconds" ValueChanged="value => _draft.IntervalSeconds=(int)value" Min="10" Max="3600" Integer="true" /><UiNumber Label="@T["Wait between switches"]" Unit="min" Value="@_draft.CooldownMinutes" ValueChanged="value => _draft.CooldownMinutes=(int)value" Min="1" Max="240" Integer="true" /><div class="ui-field"><label for="automation-source">@T["Battery and solar source"]</label><select id="automation-source" value="@_draft.SourceInverterId?.ToString()" @onchange="SourceChanged"><option value="">@T["Socket-linked or installation default inverter"]</option>@foreach(var source in _sources) { <option value="@source.Id.Value" disabled="@(!source.Capabilities.HasBattery)">@source.Name</option> }@if(_draft.SourceInverterId is {} selected && !_sources.Any(s=>s.Id.Value==selected)) { <option value="@selected" disabled>@T["Unavailable source"]</option> }</select></div><p class="field-hint">@T["Battery and PV conditions use this source. The installation default follows its selected inverter."]</p></div></details>
<div class="toolbar"><span>@T["Enabled"]</span><UiSwitch @bind-Value="@_draft.Enabled" Label="@T["Enabled"]" Disabled="@(!_canManage||string.IsNullOrEmpty(_draft.EntityId))" /></div>
@if(_validation is not null) { <div class="banner critical" role="alert">@T.Translate(_validation)</div> }
<div class="form-actions">@if(!_new) { <UiButton Variant="critical" Disabled="@(!_canManage)" OnClick="() => _delete=true">@T["Delete"]</UiButton> }<UiButton Href="/automations" Variant="outline">@T["Cancel"]</UiButton><UiButton Type="submit" Variant="primary" Busy="_saving" Disabled="@(!_canManage||!_form.IsValid)">@T["Save automation"]</UiButton></div></div></fieldset></form></UiCard></CascadingValue> }
else { <UiCard><UiState Title="@(Id.HasValue?T["Automation not found"]:T["Choose an automation"])"><UiButton Href="@(_canManage?"/automations/new":null)" Disabled="@(!_canManage)" Variant="primary">@T["New automation"]</UiButton></UiState></UiCard> }
</div> }
@if(_delete) { <UiModal Title="@T["Delete automation?"]" OnClose="()=>_delete=false"><p>@T["This removes the automation. The device keeps its current state."]</p><div class="form-actions"><UiButton Variant="outline" OnClick="()=>_delete=false">@T["Cancel"]</UiButton><UiButton Variant="critical" OnClick="Delete" Busy="_saving" Disabled="@(!_canManage)">@T["Delete"]</UiButton></div></UiModal> }
<UnsavedChangesGuard Dirty="@(Dirty&&!_saving)"/>
@code {
 [CascadingParameter(Name="DisplayTimeZone")]public string? PersonalTimeZone{get;set;}
 [Parameter] public int? Id {get;set;}
 [SupplyParameterFromQuery(Name="template")] public string? TemplateQuery {get;set;}
 private List<TriggerRule> _rules=[];
 private IReadOnlyList<DevicePowerInfo> _devices=[];
 private IReadOnlyList<InverterDescriptor> _sources=[];
 private TriggerRule? _draft;
 private RuleEvaluationDto? _evaluation;
 private bool _loading=true,_new,_saving,_delete,_window,_rangeEdited,_canManage;
 private int? _busy;
 private string? _error,_validation,_thresholdError;
 private string _from="",_to="";
 private readonly AsyncQueryScope _queries=new();
 private readonly UiFormState _form=new();private string _originalDraft="";private bool Dirty=>_draft is not null&&(DraftState!=_originalDraft||!_form.IsValid);private string DraftState=>JsonSerializer.Serialize(_draft)+"|"+_window+"|"+_from+"|"+_to;
 protected override async Task OnInitializedAsync(){_form.Changed+=FormChanged;try{await Security.EnsureAsync(InstallationPermission.ManageRules,_queries.LifetimeToken);_canManage=true;}catch(InstallationAccessException denied)when(denied.Status==403){}}
 protected override Task OnParametersSetAsync()=>Load();
 private Task Load()=>_queries.RunAsync(async ct=> { var rules=await Rules.GetAllAsync(ct);var devices=await Inventory.GetCachedDevicesAsync(ct);var sources=await Inverters.ListRegisteredAsync(ct);var evaluation=Id.HasValue?await Queries.EvaluationAsync(Id.Value,ct):null;return (rules,devices,sources,evaluation); },started:()=>{_loading=true;_error=null;},received:data=>{_rules=data.rules;_devices=data.devices;_sources=data.sources;_evaluation=data.evaluation;_new=Nav.Uri.Split('?')[0].EndsWith("/new",StringComparison.Ordinal);_draft=_new?NewDraft():Id.HasValue&&_rules.FirstOrDefault(r=>r.Id==Id) is {} rule?Clone(rule):null;_rangeEdited=false;_validation=null;_thresholdError=null;_from=_draft?.ActiveFrom?.ToString("HH:mm")??"";_to=_draft?.ActiveTo?.ToString("HH:mm")??"";_window=_from.Length>0||_to.Length>0;if(_new && TemplateQuery is "solar" or "reserve" or "daylight")ApplyTemplate(TemplateQuery);_originalDraft=DraftState;},failed:_=>_error="Automations could not be loaded.",finished:()=>_loading=false);
 private static TriggerRule Clone(TriggerRule r)=>JsonSerializer.Deserialize<TriggerRule>(JsonSerializer.Serialize(r))!;
 private static TriggerRule NewDraft()=>new(){Enabled=false,UseSeparateSocTurnOffThreshold=true,SocTurnOnThreshold=75,SocTurnOffThreshold=55};
 private string TargetName(TriggerRule rule)=>_devices.FirstOrDefault(d=>d.Id==rule.EntityId)?.Name??T["Unavailable device"];
 private string Sentence(TriggerRule r)=>r.UseSolarProductionThreshold?T.Format("When battery reaches {0}% and solar averages {1} kW, turn on the device. Turn it off at {2}%.",r.SocTurnOnThreshold,(r.MinAverageSolarProductionWatts/1000d).ToString("0.##"),r.SocTurnOffThreshold):T.Format("When battery reaches {0}%, turn on the device. Turn it off at {1}%.",r.SocTurnOnThreshold,r.SocTurnOffThreshold);
 private void SetOn(double value){if(!_canManage)return;_draft!.SocTurnOnThreshold=(int)value;_rangeEdited=true;ValidateRange();}
 private void SetOff(double value){if(!_canManage)return;_draft!.SocTurnOffThreshold=(int)value;_rangeEdited=true;ValidateRange();}
 private void OnRange(ChangeEventArgs e){if(double.TryParse(e.Value?.ToString(),out var v))SetOn(v);}
 private void OffRange(ChangeEventArgs e){if(double.TryParse(e.Value?.ToString(),out var v))SetOff(v);}
 private void ValidateRange()=>_thresholdError=_draft!.UseSeparateSocTurnOffThreshold&&(_new||_rangeEdited)&&_draft.SocTurnOffThreshold>=_draft.SocTurnOnThreshold?T["The switch-off threshold must be below the switch-on threshold."]:null;
 private void SourceChanged(ChangeEventArgs e){if(_canManage)_draft!.SourceInverterId=Guid.TryParse(e.Value?.ToString(),out var id)?id:null;}
 private void Template(int kind){if(_canManage)Nav.NavigateTo("/automations/new?template="+(kind==0?"solar":kind==1?"reserve":"daylight"));}
 private void ApplyTemplate(string kind){_draft=NewDraft();_draft.Name=T[kind=="solar"?"Use solar surplus":kind=="reserve"?"Keep a battery reserve":"Daylight only"];_draft.UseSolarProductionThreshold=kind!="reserve";_draft.MinAverageSolarProductionWatts=kind=="solar"?1800:100;_window=kind=="daylight";_from="";_to="";}

 private async Task Save(){if(!_canManage||_saving||_draft is null)return;_validation=null;ValidateRange();if(!_form.IsValid||_thresholdError is not null){_validation=T["Correct the fields before saving."];return;}if(_window&&(!TimeOnly.TryParseExact(_from,"HH:mm",out var a)||!TimeOnly.TryParseExact(_to,"HH:mm",out var b))){_validation="Set both time-window values or leave both empty.";return;}_draft.ActiveFrom=_window?TimeOnly.ParseExact(_from,"HH:mm"):null;_draft.ActiveTo=_window?TimeOnly.ParseExact(_to,"HH:mm"):null;RuleConfigurationPolicy.Normalize(_draft);if(RuleConfigurationPolicy.Validate(_draft) is {} validationError){_validation=validationError.Message;return;}if(_draft.Enabled&&_draft.SourceInverterId is {} source&&!_sources.Any(s=>s.Id.Value==source&&s.Capabilities.HasBattery)){_validation="Select an available inverter with battery data before enabling this rule.";return;}_saving=true;try{await Security.EnsureAsync(InstallationPermission.ManageRules,_queries.LifetimeToken);if(_new)await Rules.CreateAsync(_draft,_queries.LifetimeToken);else await Rules.UpdateAsync(_draft,_queries.LifetimeToken);Nav.NavigateTo("/automations");}catch(InstallationAccessException denied)when(denied.Status==403){_canManage=false;_validation=denied.Message;}catch(Exception error)when(!_queries.IsDisposed){_validation=error is ArgumentException?error.Message:"The rule could not be saved. Check its device and source, then try again.";}finally{_saving=false;}}
 private async Task Toggle(TriggerRule r,bool enabled){if(!_canManage||_busy.HasValue)return;if(Dirty){_error="Save or discard your changes before changing another automation.";return;}_busy=r.Id;try{await Security.EnsureAsync(InstallationPermission.ManageRules,_queries.LifetimeToken);var draft=Clone(r);draft.Enabled=enabled;await Rules.UpdateAsync(draft,_queries.LifetimeToken);await Load();}catch(InstallationAccessException denied)when(denied.Status==403){_canManage=false;_error=denied.Message;}catch(Exception)when(!_queries.IsDisposed){_error="The automation could not be changed.";}finally{_busy=null;}}
 private async Task Delete(){if(!_canManage||_draft is null||_saving)return;_saving=true;try{await Security.EnsureAsync(InstallationPermission.ManageRules,_queries.LifetimeToken);await Rules.DeleteAsync(_draft.Id,RuleConfigurationVersion.Read(_draft),_queries.LifetimeToken);_delete=false;Nav.NavigateTo("/automations");}catch(InstallationAccessException denied)when(denied.Status==403){_canManage=false;_validation=denied.Message;}catch(Exception)when(!_queries.IsDisposed){_validation="The automation could not be deleted.";}finally{_saving=false;}}
 private string ConditionLabel(string kind)=>T[kind switch{"battery_soc"=>"Battery charge","solar_average"=>"Solar average","cooldown"=>"Wait between switches","active_window"=>"Schedule window",_=>"Condition"}];
 private static string ConditionValue(EvaluationConditionDto c)=>c.Kind=="solar_average"?UiFormat.Number(c.Observed/1000d)+" / "+UiFormat.Number(c.Threshold/1000d)+" kW":c.Kind=="battery_soc"?UiFormat.Number(c.Observed,"0")+" / "+UiFormat.Number(c.Threshold,"0")+"%":c.Kind=="cooldown"?UiFormat.Number(c.Observed,"0.#")+" min":"—";
 private string Time(DateTimeOffset t)=>UiFormat.Time(t,PersonalTimeZone??"UTC","HH:mm:ss zzz");
 private void FormChanged(){if(!_queries.IsDisposed)_ = InvokeAsync(StateHasChanged);}
 public ValueTask DisposeAsync(){_form.Changed-=FormChanged;return _queries.DisposeAsync();}
}
