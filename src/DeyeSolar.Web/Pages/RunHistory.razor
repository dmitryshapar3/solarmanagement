@page "/runs"
@inject IDbContextFactory<DeyeSolar.Web.Data.DeyeSolarDbContext> DbFactory
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsService
@using Microsoft.EntityFrameworkCore

<PageTitle>@T["Run History - DeyeSolar"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@T["Rule Run History"]</MudText>

<MudStack Row="true" Class="mb-4" Spacing="2">
    <MudSelect @bind-Value="_hours" Label="@T["Time Range"]" Dense="true" Style="max-width: 200px;">
        <MudSelectItem Value="1">@T["Last 1 hour"]</MudSelectItem>
        <MudSelectItem Value="6">@T["Last 6 hours"]</MudSelectItem>
        <MudSelectItem Value="24">@T["Last 24 hours"]</MudSelectItem>
        <MudSelectItem Value="168">@T["Last 7 days"]</MudSelectItem>
    </MudSelect>
    <MudSelect @bind-Value="_filter" Label="@T["Filter"]" Dense="true" Style="max-width: 200px;">
        <MudSelectItem Value="@("ALL")">@T["All runs"]</MudSelectItem>
        <MudSelectItem Value="@("ON")">@T["ON only"]</MudSelectItem>
        <MudSelectItem Value="@("OFF")">@T["OFF only"]</MudSelectItem>
        <MudSelectItem Value="@("CHANGES")">@T["Changes only (ON/OFF)"]</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Outlined" OnClick="LoadData">@T["Refresh"]</MudButton>
</MudStack>

@if (_logs == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_logs.Count == 0)
{
    <MudAlert Severity="Severity.Info">@T["No rule runs in selected time range."]</MudAlert>
}
else
{
    <MudTable Items="_logs" Hover="true" Dense="true" Elevation="2" FixedHeader="true" Height="600px">
        <HeaderContent>
            <MudTh>@T["Time"]</MudTh>
            <MudTh>@T["Rule"]</MudTh>
            <MudTh>@T["Action"]</MudTh>
            <MudTh>@T["SOC %"]</MudTh>
            <MudTh>@T["Solar W"]</MudTh>
            <MudTh>@T["Battery W"]</MudTh>
            <MudTh>@T["Reason"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@TimeHelper.ToUserTime(context.Timestamp, _tz).ToString("g", System.Globalization.CultureInfo.CurrentCulture)</MudTd>
            <MudTd>@context.RuleName</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Action == "ON" ? Color.Success : context.Action == "OFF" ? Color.Error : Color.Default)">
                    @context.Action
                </MudChip>
            </MudTd>
            <MudTd>@context.BatterySoc</MudTd>
            <MudTd>@context.SolarProduction</MudTd>
            <MudTd>@context.BatteryPower</MudTd>
            <MudTd><MudText Typo="Typo.body2">@T.Translate(context.Reason)</MudText></MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.caption" Class="mt-2">@T.Format("Showing {0} entries", _logs.Count)</MudText>
}

@code {
    private List<DeyeSolar.Web.Data.RuleRunLog>? _logs;
    private int _hours = 6;
    private string _filter = "ALL";
    private string? _tz;

    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        _tz = display.TimeZoneId;
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var cutoff = DateTime.UtcNow.AddHours(-_hours);

        IQueryable<DeyeSolar.Web.Data.RuleRunLog> query = db.RuleRunLogs
            .Where(r => r.Timestamp >= cutoff);

        if (_filter == "ON")
            query = query.Where(r => r.Action == "ON");
        else if (_filter == "OFF")
            query = query.Where(r => r.Action == "OFF");
        else if (_filter == "CHANGES")
            query = query.Where(r => r.Action != "NO_CHANGE");

        _logs = await query
            .OrderByDescending(r => r.Timestamp)
            .Take(1000)
            .ToListAsync();
    }
}
