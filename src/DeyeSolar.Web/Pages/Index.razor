@page "/"
@using System.Globalization
@using DeyeSolar.Web.Services
@inject InverterDataSnapshot Snapshot
@inject IInverterRefreshService InverterRefresh
@inject DeviceStatusSnapshot DeviceSnapshot
@inject DeyeSolar.Domain.Interfaces.ISocketController SocketController
@inject DeyeSolar.Domain.Interfaces.IRuleRepository RuleRepo
@using DeyeSolar.Web.Shared
@implements IDisposable

<PageTitle>Dashboard - DeyeSolar</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="energy-status" Elevation="2">
            <section aria-labelledby="energy-status-title" aria-busy="@_refreshing.ToString().ToLowerInvariant()" data-testid="energy-status">
                <div class="energy-status-heading">
                    <div>
                        <h2 id="energy-status-title">Energy status</h2>
                        <span class="energy-status-source">DeyeCloud</span>
                        @if (_data is { } reading)
                        {
                            <span class="energy-status-updated" title="Poll time; the Deye measurement may be older.">Last Deye poll <time datetime="@reading.Timestamp.ToString("O")">@TimeHelper.ToUserTime(reading.Timestamp.UtcDateTime, _tz).ToString("HH:mm:ss", CultureInfo.InvariantCulture)</time></span>
                        }
                    </div>
                    <button type="button" class="energy-status-refresh" @onclick="RefreshInverterAsync" disabled="@_refreshing"
                            aria-label="Refresh inverter data" title="Fetch the latest Deye readings">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                        @(_refreshing ? "Refreshing…" : "Refresh")
                    </button>
                </div>
                <div class="energy-status-metrics">
                    <div class="energy-status-metric energy-status-battery" data-testid="battery-soc">
                        <span class="energy-status-label">Battery SOC</span>
                        <strong>@(_data?.BatterySoc.ToString(CultureInfo.InvariantCulture) ?? "—")<small>%</small></strong>
                        @if (_data is not null)
                        {
                            <div class="energy-status-charge" role="progressbar" aria-label="Battery charge" aria-valuenow="@_data.BatterySoc" aria-valuemin="0" aria-valuemax="100">
                                <span class="@SocClass(_data.BatterySoc)" style="@($"width: {Math.Clamp(_data.BatterySoc, 0, 100)}%")"></span>
                            </div>
                        }
                    </div>
                    <div class="energy-status-metric" data-testid="solar-generation">
                        <span class="energy-status-label">Solar generation</span>
                        <strong>@Power(_data?.SolarProduction)<small>W</small></strong>
                    </div>
                    <div class="energy-status-metric" data-testid="grid-power">
                        <span class="energy-status-label">Grid</span>
                        <strong>@Power(_data?.GridConsumption)<small>W</small></strong>
                        <span class="energy-status-direction @GridClass">@GridDirection</span>
                    </div>
                </div>
                @if (_data is null)
                {
                    <p class="energy-status-message" role="status">Waiting for the first Deye reading.</p>
                }
                @if (_refreshError is not null)
                {
                    <p class="energy-status-error" role="alert">@_refreshError</p>
                }
            </section>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <section class="dashboard-charts" aria-label="Generation and electricity sales" data-testid="dashboard-charts">
            <div class="dashboard-chart-column" data-testid="dashboard-generation">
                <SolarHistoryChart Overview="true" />
            </div>
            <div class="dashboard-chart-column" data-testid="dashboard-sales">
                <SalesStatistics Overview="true" />
            </div>
        </section>
    </MudItem>

    @if (_data is not null)
    {

        <!-- Quick Actions -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                <MudText Typo="Typo.caption" Class="mb-2">Manual override (rules will correct on next cycle)</MudText>
                <MudSelect T="string" @bind-Value="_manualDeviceId" Label="Device" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @if (_devices != null)
                    {
                        @foreach (var d in _devices)
                        {
                            <MudSelectItem T="string" Value="@d.Id">
                                @d.Name (@d.Category)
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               Disabled="@string.IsNullOrWhiteSpace(_manualDeviceId)"
                               OnClick="@(() => ManualToggle(true))">
                        Socket ON
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               Disabled="@string.IsNullOrWhiteSpace(_manualDeviceId)"
                               OnClick="@(() => ManualToggle(false))">
                        Socket OFF
                    </MudButton>
                </MudStack>
                @if (!string.IsNullOrEmpty(_actionMessage))
                {
                    <MudAlert Severity="@_actionSeverity" Class="mt-2">@_actionMessage</MudAlert>
                }
            </MudPaper>
        </MudItem>

        <!-- Rules -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Rules</MudText>
                @if (_rules == null || _rules.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No rules configured.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>State</th>
                                <th>Last switched</th>
                                <th>Last checked</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in _rules)
                            {
                                <tr>
                                    <td>
                                        @rule.Name
                                        @if (!rule.Enabled)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">disabled</MudChip>
                                        }
                                    </td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(rule.CurrentState ? Color.Success : Color.Default)">
                                            @(rule.CurrentState ? "ON" : "OFF")
                                        </MudChip>
                                    </td>
                                    <td>@FormatTimestamp(rule.CurrentStateChangedAt)</td>
                                    <td>@FormatTimestamp(rule.LastEvaluated)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@inject DeyeSolar.Web.Data.AppSettingsService SettingsService

@code {
    private InverterData? _data;
    private List<TriggerRule>? _rules;
    private IReadOnlyList<DevicePowerInfo>? _devices;
    private string? _manualDeviceId;
    private string? _actionMessage;
    private Severity _actionSeverity;
    private string? _tz;
    private DeyeSolar.Domain.Options.ShellyOptions _shelly = new();
    private bool _refreshing;
    private bool _disposed;
    private string? _refreshError;
    private readonly CancellationTokenSource _lifetime = new();
    private static string Power(int? watts) => watts.HasValue ? Math.Abs((long)watts.Value).ToString("N0", CultureInfo.InvariantCulture) : "—";
    private string GridDirection => _data is null ? "Awaiting reading" : _data.GridConsumption < 0 ? "Exporting" : _data.GridConsumption > 0 ? "Importing" : "Idle";
    private string GridClass => _data?.GridConsumption < 0 ? "energy-status-positive" : _data?.GridConsumption > 0 ? "energy-status-active" : "";
    private static string SocClass(int soc) => soc >= 80 ? "energy-status-charge-high" : soc >= 40 ? "energy-status-charge-medium" : "energy-status-charge-low";

    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        if (_disposed) return;
        _tz = display.TimeZoneId;
        _data = Snapshot.Current;
        await LoadRulesAndManualDevices();
        if (_disposed) return;
        Snapshot.OnDataUpdated += OnDataUpdated;
        _data = Snapshot.Current;
    }

    private void OnDataUpdated()
    {
        if (_disposed) return;
        _ = InvokeAsync(UpdateSnapshotAsync);
    }

    private async Task UpdateSnapshotAsync()
    {
        if (_disposed) return;
        _data = Snapshot.Current;
        _refreshError = null;
        StateHasChanged();
        try
        {
            await LoadRulesAndManualDevices();
        }
        catch
        {
            // Keep previous rules on transient failure; the inverter reading is already available.
        }
        if (!_disposed) StateHasChanged();
    }

    private async Task RefreshInverterAsync()
    {
        if (_disposed || _refreshing) return;
        _refreshing = true;
        _refreshError = null;
        try
        {
            await InverterRefresh.RefreshAsync(_lifetime.Token);
            if (!_disposed) _data = Snapshot.Current;
        }
        catch (OperationCanceledException) when (_disposed || _lifetime.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!_disposed) _refreshError = _data is null
                ? "Could not fetch Deye readings. Please try again."
                : "Could not refresh Deye readings. Showing the last successful reading; please try again.";
        }
        finally
        {
            if (!_disposed) _refreshing = false;
        }
    }

    private string FormatTimestamp(DateTime? utc)
    {
        if (!utc.HasValue) return "-";
        var local = TimeHelper.ToUserTime(utc.Value, _tz);
        return local.ToString("MM/dd HH:mm:ss");
    }

    private async Task ManualToggle(bool turnOn)
    {
        try
        {
            var entityId = _manualDeviceId;
            if (string.IsNullOrWhiteSpace(entityId))
            {
                _actionMessage = "Select a device first.";
                _actionSeverity = Severity.Warning;
                return;
            }

            if (turnOn)
                await SocketController.TurnOnAsync(entityId, CancellationToken.None);
            else
                await SocketController.TurnOffAsync(entityId, CancellationToken.None);

            await UpdateMatchingRuleStates(entityId, turnOn);
            MarkManualDeviceState(entityId, turnOn);

            var deviceName = _devices?.FirstOrDefault(d => d.Id == entityId)?.Name ?? entityId;
            _actionMessage = turnOn ? $"{deviceName} turned ON" : $"{deviceName} turned OFF";
            _actionSeverity = Severity.Success;
        }
        catch (Exception ex)
        {
            _actionMessage = $"Error: {ex.Message}";
            _actionSeverity = Severity.Error;
        }
    }

    private async Task UpdateMatchingRuleStates(string entityId, bool isOn)
    {
        var rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        foreach (var rule in rules.Where(r => string.Equals(r.EntityId, entityId, StringComparison.OrdinalIgnoreCase)))
        {
            if (rule.CurrentState == isOn)
                continue;

            rule.CurrentState = isOn;
            await RuleRepo.UpdateAsync(rule, CancellationToken.None);
        }

        _rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        _devices = BuildManualDevices(_rules);
    }

    private async Task LoadRulesAndManualDevices()
    {
        var shelly = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.ShellyOptions>("Shelly");
        if (_disposed) return;
        var rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        if (_disposed) return;
        _shelly = shelly;
        _rules = rules;
        _devices = BuildManualDevices(_rules);
        SelectDefaultManualDevice();
    }

    private IReadOnlyList<DevicePowerInfo> BuildManualDevices(IReadOnlyList<TriggerRule> rules)
        => ManualSocketDevices.Build(rules, _shelly.DeviceId, DeviceSnapshot.Current);

    private void MarkManualDeviceState(string entityId, bool isOn)
    {
        if (_devices == null)
            return;

        _devices = _devices
            .Select(device => string.Equals(device.Id, entityId, StringComparison.OrdinalIgnoreCase)
                ? device with { IsOn = isOn }
                : device)
            .ToList();
    }

    private void SelectDefaultManualDevice()
    {
        if (_devices == null || _devices.Count == 0)
        {
            _manualDeviceId = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_manualDeviceId) &&
            _devices.Any(d => d.Id == _manualDeviceId))
        {
            return;
        }

        _manualDeviceId =
            _devices.FirstOrDefault(d => d.IsOn)?.Id ??
            _devices[0].Id;
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Snapshot.OnDataUpdated -= OnDataUpdated;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
