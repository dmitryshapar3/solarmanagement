@page "/"
@using System.Globalization
@using DeyeSolar.Web.Services
@using DeyeSolar.Domain.Options
@using Microsoft.Extensions.Options
@inject InverterDataSnapshot Snapshot
@inject TimeProvider Clock
@inject IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject IOptionsMonitor<SolarEstimateOptions> EstimateOptions
@inject IInverterRefreshService InverterRefresh
@inject DeviceStatusSnapshot DeviceSnapshot
@inject DeyeSolar.Domain.Interfaces.ISocketInventoryService SocketInventory
@inject DeyeSolar.Domain.Interfaces.IRuleRepository RuleRepo
@using DeyeSolar.Web.Shared
@implements IDisposable

<PageTitle>Dashboard - DeyeSolar</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="energy-status" Elevation="2">
            <section aria-labelledby="energy-status-title" aria-busy="@_refreshing.ToString().ToLowerInvariant()" data-testid="energy-status">
                <div class="energy-status-heading">
                    <div>
                        <h2 id="energy-status-title">Current generation</h2>
                        <span class="energy-status-source">Inverter</span>
                        @if (_data is { } reading)
                        {
                            <span class="energy-status-updated" title="Poll time; the inverter measurement may be older.">Last inverter poll <time datetime="@reading.Timestamp.ToString("O")">@TimeHelper.ToUserTime(reading.Timestamp.UtcDateTime, _tz).ToString("HH:mm:ss", CultureInfo.InvariantCulture)</time></span>
                        }
                    </div>
                    <div class="energy-status-actions">
                    <button type="button" class="energy-status-refresh" @onclick="RefreshInverterAsync" disabled="@_refreshing"
                            aria-label="Refresh inverter data" title="Fetch the latest inverter readings">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                        @(_refreshing ? "Refreshing…" : "Refresh")
                    </button>
                    <a class="energy-status-refresh" href="/inverter-details?returnTo=%2F" aria-label="Current generation details">Details</a>
                    </div>
                </div>
                <div class="energy-status-metrics">
                    <div class="energy-status-metric energy-status-primary" data-testid="solar-generation">
                        <span class="energy-status-label">Solar generation · Inverter</span>
                        <strong>@SolarPower<small>kW</small></strong>
                        @if (HasSolarReading && _data?.SolarObservedAt is { } observedAt)
                        {
                            <span class="energy-status-direction">Measured <time datetime="@observedAt.ToString("O")">@TimeHelper.ToUserTime(observedAt.UtcDateTime, _tz).ToString("d MMM HH:mm:ss", CultureInfo.GetCultureInfo("en-GB"))</time></span>
                        }
                        else
                        {
                            <span class="energy-status-direction">PV measurement unavailable</span>
                        }
                    </div>
                    <div class="energy-status-metric" data-testid="load-power">
                        <span class="energy-status-label">Load</span>
                        <strong>@Power(_data?.LoadPowerValid == false ? null : _data?.LoadPower)<small>W</small></strong>
                    </div>
                    <div class="energy-status-metric" data-testid="grid-power">
                        <span class="energy-status-label">Grid</span>
                        <strong>@Power(GridPower)<small>W</small></strong>
                        <span class="energy-status-direction @GridClass">@GridDirection</span>
                    </div>
                    <div class="energy-status-metric" data-testid="battery-power">
                        <span class="energy-status-label">@PowerBalance.BatteryLabel(_data?.BatteryPowerValid == false ? null : _data?.BatteryPower)</span>
                        <strong>@Power(_data?.BatteryPowerValid == false ? null : _data?.BatteryPower)<small>W</small></strong>
                        <span class="energy-status-direction">@(_data is null || _data.BatteryPowerValid == false ? "Awaiting reading" : "Reported inverter power")</span>
                    </div>
                </div>
                @if (_data is null)
                {
                    <p class="energy-status-message" role="status">Waiting for the first inverter reading.</p>
                }
                @if (_refreshError is not null)
                {
                    <p class="energy-status-error" role="alert">@_refreshError</p>
                }
            </section>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <section class="dashboard-charts" aria-label="Generation and electricity sales" data-testid="dashboard-charts">
            <div class="dashboard-chart-column" data-testid="dashboard-generation">
                <SolarEstimateCard Overview="true" Actual="_data" OnRefreshInverter="RefreshInverterAsync" Refreshing="_refreshing" ReturnTo="/" />
            </div>
            <div class="dashboard-chart-column" data-testid="dashboard-sales">
                <SalesStatistics Overview="true" ReturnTo="/" />
            </div>
        </section>
    </MudItem>

    @if (_data is not null)
    {

        <!-- Quick Actions -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                <MudText Typo="Typo.caption" Class="mb-2">Manual override (rules will correct on next cycle)</MudText>
                <MudSelect T="string" @bind-Value="_manualDeviceId" Label="Device" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @if (_devices != null)
                    {
                        @foreach (var d in _devices)
                        {
                            <MudSelectItem T="string" Value="@d.Id">
                                @d.Name (@d.Category)
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
                <SocketCommandControls DeviceId="@_manualDeviceId" Online="@(_devices?.FirstOrDefault(device => device.Id == _manualDeviceId)?.Online == true)" OnAcknowledged="RefreshManualDevicesAsync" />
            </MudPaper>
        </MudItem>

        <!-- Rules -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Rules</MudText>
                @if (_rules == null || _rules.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No rules configured.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>State</th>
                                <th>Last switched</th>
                                <th>Last checked</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in _rules)
                            {
                                <tr>
                                    <td>
                                        @rule.Name
                                        @if (!rule.Enabled)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">disabled</MudChip>
                                        }
                                    </td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(rule.CurrentState ? Color.Success : Color.Default)">
                                            @(rule.CurrentState ? "ON" : "OFF")
                                        </MudChip>
                                    </td>
                                    <td>@FormatTimestamp(rule.CurrentStateChangedAt)</td>
                                    <td>@FormatTimestamp(rule.LastEvaluated)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@inject DeyeSolar.Web.Data.AppSettingsService SettingsService

@code {
    private InverterData? _data;
    private List<TriggerRule>? _rules;
    private IReadOnlyList<DevicePowerInfo>? _devices;
    private string? _manualDeviceId;
    private string? _tz;
    private bool _refreshing;
    private bool _disposed;
    private string? _refreshError;
    private readonly CancellationTokenSource _lifetime = new();
    private static string Power(int? watts) => watts.HasValue ? Math.Abs((long)watts.Value).ToString("N0", CultureInfo.InvariantCulture) : "—";
    private bool HasSolarReading => _data is { SolarObservedAt: { } observed, SolarProduction: >= 0 } reading && reading.SolarPowerValid != false
        && !string.IsNullOrWhiteSpace(reading.SolarDeviceSn) && reading.SolarDeviceSn == InverterOptions.CurrentValue.DeviceKey
        && observed <= Clock.GetUtcNow() && (Clock.GetUtcNow() - observed).TotalMinutes <= EstimateOptions.CurrentValue.NowcastActualMaximumAgeMinutes;
    private string SolarPower => HasSolarReading ? (_data!.SolarProduction / 1000d).ToString("N2", CultureInfo.GetCultureInfo("en-GB")) : "—";
    private int? GridPower => _data?.GridPowerValid == false ? null : _data?.GridConsumption;
    private string GridDirection => _data is null ? "Awaiting reading" : GridPower is null ? "Grid measurement unavailable" : GridPower < 0 ? "Exporting" : GridPower > 0 ? "Importing" : "Idle";
    private string GridClass => GridPower < 0 ? "energy-status-positive" : GridPower > 0 ? "energy-status-active" : "";
    private static string SocClass(int soc) => soc >= 80 ? "energy-status-charge-high" : soc >= 40 ? "energy-status-charge-medium" : "energy-status-charge-low";

    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        if (_disposed) return;
        _tz = display.TimeZoneId;
        _data = Snapshot.Current;
        await LoadRulesAndManualDevices();
        if (_disposed) return;
        Snapshot.OnDataUpdated += OnDataUpdated;
        _data = Snapshot.Current;
        _ = UpdateClockAsync();
    }

    private async Task UpdateClockAsync()
    {
        var token = _lifetime.Token;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (InvalidOperationException) when (_disposed) { }
    }

    private void OnDataUpdated()
    {
        if (_disposed) return;
        _ = InvokeAsync(UpdateSnapshotAsync);
    }

    private async Task UpdateSnapshotAsync()
    {
        if (_disposed) return;
        _data = Snapshot.Current;
        _refreshError = null;
        StateHasChanged();
        try
        {
            await LoadRulesAndManualDevices();
        }
        catch
        {
            // Keep previous rules on transient failure; the inverter reading is already available.
        }
        if (!_disposed) StateHasChanged();
    }

    private async Task RefreshInverterAsync()
    {
        if (_disposed || _refreshing) return;
        _refreshing = true;
        _refreshError = null;
        try
        {
            await InverterRefresh.RefreshAsync(_lifetime.Token);
            if (!_disposed) _data = Snapshot.Current;
        }
        catch (OperationCanceledException) when (_disposed || _lifetime.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!_disposed) _refreshError = _data is null
                ? "Could not fetch inverter readings. Please try again."
                : "Could not refresh inverter readings. Showing the last successful reading; please try again.";
        }
        finally
        {
            if (!_disposed) _refreshing = false;
        }
    }

    private string FormatTimestamp(DateTime? utc)
    {
        if (!utc.HasValue) return "-";
        var local = TimeHelper.ToUserTime(utc.Value, _tz);
        return local.ToString("MM/dd HH:mm:ss");
    }

    private async Task RefreshManualDevicesAsync()
    {
        var epoch = DeviceSnapshot.Epoch;
        var devices = await SocketInventory.RefreshDevicesAsync(_lifetime.Token);
        if (_disposed) return;
        DeviceSnapshot.TryUpdate(devices, epoch);
        await LoadRulesAndManualDevices();
    }

    private async Task LoadRulesAndManualDevices()
    {
        var rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        if (_disposed) return;
        _rules = rules;
        _devices = BuildManualDevices(_rules);
        SelectDefaultManualDevice();
    }

    private IReadOnlyList<DevicePowerInfo> BuildManualDevices(IReadOnlyList<TriggerRule> rules)
        => DeviceSnapshot.Current ?? ManualSocketDevices.Build(rules, null);

    private void SelectDefaultManualDevice()
    {
        if (_devices == null || _devices.Count == 0)
        {
            _manualDeviceId = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_manualDeviceId) &&
            _devices.Any(d => d.Id == _manualDeviceId))
        {
            return;
        }

        _manualDeviceId =
            _devices.FirstOrDefault(d => d.IsOn)?.Id ??
            _devices[0].Id;
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Snapshot.OnDataUpdated -= OnDataUpdated;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
