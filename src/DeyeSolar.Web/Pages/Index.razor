@page "/"
@inject InverterDataSnapshot Snapshot
@inject DeyeSolar.Domain.Interfaces.ISocketController SocketController
@inject DeyeSolar.Domain.Interfaces.IRuleRepository RuleRepo
@using DeyeSolar.Web.Shared
@implements IDisposable

<PageTitle>Dashboard - DeyeSolar</PageTitle>

<MudGrid>
    @if (_data == null)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">Waiting for first data reading...</MudAlert>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudText Typo="Typo.caption" Class="mb-2">
                Last update: @TimeHelper.ToUserTime(_data.Timestamp.UtcDateTime, _tz).ToString("HH:mm:ss")
                | Source: DeyeCloud
            </MudText>
        </MudItem>

        <!-- Battery SOC -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Battery SOC</MudText>
                <MudProgressLinear Color="@GetSocColor(_data.BatterySoc)" Value="@_data.BatterySoc" Class="my-2" />
                <MudText Typo="Typo.h4">@_data.BatterySoc%</MudText>
            </MudPaper>
        </MudItem>

        <!-- Solar Production -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning">Solar Production</MudText>
                <MudIcon Icon="@Icons.Material.Filled.WbSunny" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h4">@_data.SolarProduction W</MudText>
            </MudPaper>
        </MudItem>

        <!-- Battery Power -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Battery Power</MudText>
                <MudIcon Icon="@(_data.BatteryPower < 0 ? Icons.Material.Filled.BatteryChargingFull : Icons.Material.Filled.Battery5Bar)"
                         Color="@(_data.BatteryPower < 0 ? Color.Success : Color.Warning)" Size="Size.Large" />
                <MudText Typo="Typo.h4">@Math.Abs(_data.BatteryPower) W</MudText>
                <MudText Typo="Typo.caption">@(_data.BatteryPower < 0 ? "Charging" : _data.BatteryPower > 0 ? "Discharging" : "Idle")</MudText>
            </MudPaper>
        </MudItem>

        <!-- Grid -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Info">Grid</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ElectricalServices" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h4">@Math.Abs(_data.GridConsumption) W</MudText>
                <MudText Typo="Typo.caption">@(_data.GridConsumption < 0 ? "Exporting" : _data.GridConsumption > 0 ? "Importing" : "Idle")</MudText>
            </MudPaper>
        </MudItem>

        <!-- Battery Details -->
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Battery Details</MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <tbody>
                        <tr><td>Voltage</td><td>@_data.BatteryVoltage.ToString("F1") V</td></tr>
                        <tr><td>Current</td><td>@_data.BatteryCurrent.ToString("F1") A</td></tr>
                        <tr><td>Temperature</td><td>@_data.BatteryTemperature.ToString("F1") C</td></tr>
                        <tr><td>Load Power</td><td>@_data.LoadPower W</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <!-- Quick Actions -->
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                <MudText Typo="Typo.caption" Class="mb-2">Manual override (rules will correct on next cycle)</MudText>
                <MudSelect T="string" @bind-Value="_manualDeviceId" Label="Device" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @if (_devices != null)
                    {
                        @foreach (var d in _devices)
                        {
                            <MudSelectItem T="string" Value="@d.Id">
                                @d.Name (@d.Category)
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               Disabled="@string.IsNullOrWhiteSpace(_manualDeviceId)"
                               OnClick="@(() => ManualToggle(true))">
                        Socket ON
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               Disabled="@string.IsNullOrWhiteSpace(_manualDeviceId)"
                               OnClick="@(() => ManualToggle(false))">
                        Socket OFF
                    </MudButton>
                </MudStack>
                @if (!string.IsNullOrEmpty(_actionMessage))
                {
                    <MudAlert Severity="@_actionSeverity" Class="mt-2">@_actionMessage</MudAlert>
                }
            </MudPaper>
        </MudItem>

        <!-- Rules -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Rules</MudText>
                @if (_rules == null || _rules.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No rules configured.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>State</th>
                                <th>Last switched</th>
                                <th>Last checked</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in _rules)
                            {
                                <tr>
                                    <td>
                                        @rule.Name
                                        @if (!rule.Enabled)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">disabled</MudChip>
                                        }
                                    </td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(rule.CurrentState ? Color.Success : Color.Default)">
                                            @(rule.CurrentState ? "ON" : "OFF")
                                        </MudChip>
                                    </td>
                                    <td>@FormatTimestamp(rule.CurrentStateChangedAt)</td>
                                    <td>@FormatTimestamp(rule.LastEvaluated)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@inject DeyeSolar.Web.Data.AppSettingsService SettingsService

@code {
    private InverterData? _data;
    private List<TriggerRule>? _rules;
    private IReadOnlyList<DevicePowerInfo>? _devices;
    private string? _manualDeviceId;
    private string? _actionMessage;
    private Severity _actionSeverity;
    private string? _tz;
    private DeyeSolar.Domain.Options.ShellyOptions _shelly = new();

    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        _tz = display.TimeZoneId;
        _data = Snapshot.Current;
        await LoadRulesAndManualDevices();
        Snapshot.OnDataUpdated += OnDataUpdated;
    }

    private async void OnDataUpdated()
    {
        _data = Snapshot.Current;
        try
        {
            await LoadRulesAndManualDevices();
        }
        catch
        {
            // keep previous rules on transient failure
        }
        await InvokeAsync(StateHasChanged);
    }

    private string FormatTimestamp(DateTime? utc)
    {
        if (!utc.HasValue) return "-";
        var local = TimeHelper.ToUserTime(utc.Value, _tz);
        return local.ToString("MM/dd HH:mm:ss");
    }

    private async Task ManualToggle(bool turnOn)
    {
        try
        {
            var entityId = _manualDeviceId;
            if (string.IsNullOrWhiteSpace(entityId))
            {
                _actionMessage = "Select a device first.";
                _actionSeverity = Severity.Warning;
                return;
            }

            if (turnOn)
                await SocketController.TurnOnAsync(entityId, CancellationToken.None);
            else
                await SocketController.TurnOffAsync(entityId, CancellationToken.None);

            await UpdateMatchingRuleStates(entityId, turnOn);
            MarkManualDeviceState(entityId, turnOn);

            var deviceName = _devices?.FirstOrDefault(d => d.Id == entityId)?.Name ?? entityId;
            _actionMessage = turnOn ? $"{deviceName} turned ON" : $"{deviceName} turned OFF";
            _actionSeverity = Severity.Success;
        }
        catch (Exception ex)
        {
            _actionMessage = $"Error: {ex.Message}";
            _actionSeverity = Severity.Error;
        }
    }

    private async Task UpdateMatchingRuleStates(string entityId, bool isOn)
    {
        var rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        foreach (var rule in rules.Where(r => string.Equals(r.EntityId, entityId, StringComparison.OrdinalIgnoreCase)))
        {
            if (rule.CurrentState == isOn)
                continue;

            rule.CurrentState = isOn;
            await RuleRepo.UpdateAsync(rule, CancellationToken.None);
        }

        _rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        _devices = BuildManualDevices(_rules);
    }

    private async Task LoadRulesAndManualDevices()
    {
        _shelly = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.ShellyOptions>("Shelly");
        _rules = await RuleRepo.GetAllAsync(CancellationToken.None);
        _devices = BuildManualDevices(_rules);
        SelectDefaultManualDevice();
    }

    private IReadOnlyList<DevicePowerInfo> BuildManualDevices(IReadOnlyList<TriggerRule> rules)
    {
        var devices = new Dictionary<string, DevicePowerInfo>(StringComparer.OrdinalIgnoreCase);

        foreach (var group in rules
            .Where(r => !string.IsNullOrWhiteSpace(r.EntityId))
            .GroupBy(r => r.EntityId, StringComparer.OrdinalIgnoreCase))
        {
            var names = string.Join(", ", group.Select(r => r.Name).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct());
            var isOn = group.Any(r => r.CurrentState);
            devices[group.Key] = new DevicePowerInfo(
                group.Key,
                string.IsNullOrWhiteSpace(names) ? FormatDeviceName(group.Key) : names,
                FormatDeviceCategory(group.Key),
                Online: true,
                IsOn: isOn,
                CurrentPowerW: null);
        }

        AddConfiguredDevice(devices, _shelly.DeviceId, SocketDeviceSources.Shelly, "Shelly configured socket");

        return devices.Values.ToList();
    }

    private static void AddConfiguredDevice(
        Dictionary<string, DevicePowerInfo> devices,
        string rawId,
        string source,
        string name)
    {
        if (string.IsNullOrWhiteSpace(rawId))
            return;

        var entityId = SocketEntityIds.TryParse(rawId, out _, out _)
            ? rawId
            : SocketEntityIds.Create(source, rawId);

        if (devices.ContainsKey(entityId))
            return;

        devices[entityId] = new DevicePowerInfo(
            entityId,
            name,
            FormatDeviceCategory(entityId),
            Online: true,
            IsOn: false,
            CurrentPowerW: null);
    }

    private void MarkManualDeviceState(string entityId, bool isOn)
    {
        if (_devices == null)
            return;

        _devices = _devices
            .Select(device => string.Equals(device.Id, entityId, StringComparison.OrdinalIgnoreCase)
                ? device with { IsOn = isOn }
                : device)
            .ToList();
    }

    private void SelectDefaultManualDevice()
    {
        if (_devices == null || _devices.Count == 0)
        {
            _manualDeviceId = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_manualDeviceId) &&
            _devices.Any(d => d.Id == _manualDeviceId))
        {
            return;
        }

        _manualDeviceId =
            _devices.FirstOrDefault(d => d.IsOn)?.Id ??
            _devices[0].Id;
    }

    private static string FormatDeviceName(string entityId)
        => SocketEntityIds.TryParse(entityId, out _, out var rawId) ? rawId : entityId;

    private static string FormatDeviceCategory(string entityId)
    {
        if (!SocketEntityIds.TryParse(entityId, out var source, out _))
            return "Configured";

        return source switch
        {
            SocketDeviceSources.Shelly => "Shelly",
            _ => "Configured"
        };
    }

    private Color GetSocColor(int soc) => soc switch
    {
        >= 80 => Color.Success,
        >= 40 => Color.Warning,
        _ => Color.Error
    };

    public void Dispose()
    {
        Snapshot.OnDataUpdated -= OnDataUpdated;
    }
}
