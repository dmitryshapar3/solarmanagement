@page "/"
@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Services
@using Microsoft.Extensions.Options
@using DeyeSolar.Domain.Options
@inject InverterDataSnapshot InverterSnapshot
@inject DeviceStatusSnapshot DeviceSnapshot
@inject IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject IOptionsMonitor<SolarEstimateOptions> SolarOptions
@inject SolarProductionService Production
@inject IExportSalesService Sales
@inject DeviceNameService Names
@inject DeyeSolar.Domain.Interfaces.ISocketInventoryService Inventory
@inject DeyeSolar.Domain.Interfaces.IConfigurationRules Rules
@inject RedesignQueries Queries
@inject TimeProvider Clock
@implements IAsyncDisposable
<PageTitle>@T["Home"] · SmartSolar</PageTitle><PageHeader Title="@T["Home"]" Subtitle="@(T["Your solar energy, at a glance"]+" · "+DisplayDate)"/>
@if(_error is not null){<div class="banner critical" role="alert">@T.Translate(_error)</div>}
<div class="dashboard-top"><SolarEstimateCard Hero="true" Actual="InverterSnapshot.Current" ProductionData="_production" HomeRunsOnBattery="@HomePresentation.RunsOnBattery(Live)"/><div class="form-stack"><UiCard Title="@T["Battery"]"><div class="battery-number">@T.Number(Live.BatterySoc,"0")<span>%</span></div>@if(Live.BatterySoc is {} charge){<div class="battery-meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@charge" aria-label="@T["Battery charge"]"><span style="width:@charge%"></span></div>}else{<div class="battery-meter unknown" role="img" aria-label="@T["Battery charge unavailable"]"></div>}<div class="toolbar"><strong>@(Live.BatteryKw is null?T["State unknown"]:Live.BatteryKw<0?T["Charging"]:Live.BatteryKw>0?T["Discharging"]:T["Battery idle"])</strong><span>@T.Number(Live.BatteryKw) kW</span></div><p class="caption">@(Live.PolledAt is {} poll?T.Format("Last poll {0}",T.Time(poll,_zone,"HH:mm:ss zzz")):T["Waiting for readings"])</p><a class="text-link" href="/activity/readings">@T["Live readings"] →</a></UiCard>
<UiCard Title="@T["Export today"]"><div class="kpi-value" data-testid="sales-export">@T.Number(_sales?.ExportKwh)<small> kWh</small></div><div class="toolbar"><span>@T["Estimated energy value"]</span><strong data-testid="sales-value">@T.Number(_sales?.EnergyValuePln) PLN</strong></div><div class="toolbar"><span>@T["Deposit credit, estimated"]</span><strong data-testid="sales-deposit">@T.Number(_sales?.EstimatedDepositPln) PLN</strong></div><p class="caption">@(NightSunrise is not null&&_sales?.CurrentHour is null?T["All export hours are complete"]:T["Completed hours only"]) @if(_sales?.IsPartial==true){<span>· @T["Partial coverage"]</span>}</p>@if(_sales?.CurrentHour is {} progress){<div class="banner" data-testid="sales-progress"><strong>@T["In progress"]</strong><p>@T.Format("In progress: {0} {1}, excluded from totals",T.Number(progress.ExportKwh),"kWh")</p><p>@T.Format("In progress: {0} {1}, excluded from totals",T.Number(progress.EnergyValuePln),"PLN")</p></div>}<a class="text-link" href="/energy/export">@T["View export"] →</a></UiCard></div></div>
<div class="two-columns"><EnergyFlow Data="Live" Rules="@(InverterSnapshot.Epoch == _flowEpoch && InverterSnapshot.Current?.InverterId == _flowSource ? _flowRules : [])"/><UiCard Title="@T["Today’s production"]"><div class="kpi-grid detail-kpis"><div><p class="kpi-label">@T["Produced so far"]</p><strong class="metric">@T.Number(_production?.ObservedEnergyKwh) kWh</strong></div><div><p class="kpi-label">@T["Expected today"]</p><strong class="metric">@T.Number(_production?.ExpectedEnergyKwh) kWh</strong></div></div><dl class="metadata"><div><dt>@T["Best completed hour"]</dt><dd>@T.Number(_production?.BestHour?.ActualKw) kW</dd></div><div><dt>@T["Sunset"]</dt><dd>@(_production?.Sunset is {} sunset?T.Time(sunset,_production.TimeZoneId,"HH:mm"):T["Unavailable"])</dd></div><div><dt>@T["Next sunrise"]</dt><dd>@(_production?.NextSunrise is {} sunrise?T.Time(sunrise,_production.TimeZoneId,"d MMM HH:mm"):T["Unavailable"])</dd></div><div><dt>@T["Coverage"]</dt><dd>@(_production?.Partial==true?T["Partial readings"]:_production is null?T["Unavailable"]:T["Complete"])</dd></div></dl><a class="text-link" href="/energy">@T["Hour by hour"] →</a></UiCard></div>
<div class="two-columns"><UiCard Title="@T["Smart plugs"]">@if(_devices.Count==0){<UiState Title="@T["No smart plugs yet"]"><UiButton Href="/settings/connections" Icon="plus">@T["Add a smart plug"]</UiButton></UiState>}@foreach(var device in _devices.Take(4)){<div class="dashboard-row"><a href="@("/devices/"+Uri.EscapeDataString(device.Id))"><span class="device-icon @(device.Online&&device.StateKnown&&device.IsOn?"active":null)"><UiIcon Name="devices"/></span><span><strong>@device.Name</strong><small>@(device.Online&&device.StateKnown?device.IsOn?T.Number(device.CurrentPowerW,"0")+" W":T["Off"]:T["Unknown"])</small></span></a><DeviceControl DeviceId="@device.Id" Name="@device.Name" Online="device.Online" IsOn="device.IsOn" StateKnown="device.StateKnown" OnAcknowledged="Reload"/></div>}<a class="text-link" href="/devices">@T["All devices"] →</a></UiCard><UiCard Title="@T["Automations"]">@if(_rules.Count==0){<UiState Title="@T["No automations yet"]"><UiButton Href="/automations/new" Icon="plus">@T["New automation"]</UiButton></UiState>}@foreach(var rule in _rules.Take(4)){<a class="dashboard-row" href="@($"/automations/{rule.Id}")"><span><strong>@rule.Name</strong><small>@T.Format("On at {0}% · off at {1}%",rule.SocTurnOnThreshold,rule.SocTurnOffThreshold)</small></span><StatusPill Kind="@(rule.Enabled?"positive":"neutral")">@T[rule.PauseReason=="manual_override"?"Manually paused":rule.Enabled?rule.CurrentState?"Running":"Waiting":"Paused"]</StatusPill></a>}<a class="text-link" href="/automations">@T["All automations"] →</a></UiCard></div>
<UiCard Title="@T["Recent activity"]">@if(_activity.Count==0){<p class="caption">@T["No recorded activity yet."]</p>}@foreach(var item in _activity.Take(3)){<div class="dashboard-row"><time>@T.Time(item.End,_zone,"HH:mm:ss zzz")</time><span><strong>@T[ActivityPresentation.Kind(item.Kind)]</strong><small>@(item.RuleName??T["Manual control"]) · @T[ActivityPresentation.Reason(item.ReasonCode)]</small></span></div>}<a class="text-link" href="/activity">@T["All activity"] →</a></UiCard>
@code{
 [CascadingParameter(Name="DisplayTimeZone")]public string? PersonalTimeZone{get;set;}
 private string _zone=>PersonalTimeZone??SolarOptions.CurrentValue.TimeZoneId;private DateTimeOffset _now;private ProductionViewDto? _production;private ExportSalesResult? _sales;private IReadOnlyList<DeyeSolar.Web.Api.DeviceDto> _devices=[];private List<TriggerRule> _rules=[];private IReadOnlyList<ActivityItemDto> _activity=[];private string? _error;private long _devicesEpoch;private readonly AsyncQueryScope _queries=new();
 private DateTimeOffset? NightSunrise=>HomePresentation.NightSunrise(_production,_now);
 private IReadOnlyList<TriggerRule> _flowRules=[];private Guid? _flowSource;private long _flowEpoch;
 private LiveReading Live=>LiveReading.Read(InverterSnapshot.Current,_now,InverterOptions.CurrentValue.DeviceKey,SolarOptions.CurrentValue.NowcastActualMaximumAgeMinutes);private string DisplayDate=>T.Time(_now,_zone,"dddd, d MMMM");
 protected override async Task OnInitializedAsync(){_now=Clock.GetUtcNow();InverterSnapshot.OnDataUpdated+=Updated;DeviceSnapshot.OnDataUpdated+=Updated;await Reload();_queries.StartRefresh(Clock,TimeSpan.FromSeconds(30),()=>InvokeAsync(async()=>{_now=Clock.GetUtcNow();StateHasChanged();if(!_queries.IsLoading)await Reload();}));}
 private Task Reload()=>_queries.RunAsync(async ct=>{var generation=await Production.ReadAsync(SolarHistoryPeriod.Today,ct:ct);var sales=await Sales.ReadAsync(new(ExportSalesPeriod.Day,generation.Today),ct);var devices=await DeviceInventoryView.ReadSnapshotAsync(DeviceSnapshot,Inventory,Names,false,ct);var rules=await Rules.GetAllAsync(ct);var flowSource=InverterSnapshot.Current?.InverterId;var flowEpoch=InverterSnapshot.Epoch;var flowRules=await Queries.FlowRulesAsync(rules,flowSource,ct);var activity=await Queries.ActivityAsync(_now.AddHours(-24),_now,ct:ct);return(generation,sales,devices,rules,activity,flowRules,flowSource,flowEpoch);},started:()=>_error=null,received:value=>{_production=value.generation;_sales=value.sales;_devices=value.devices.Epoch==DeviceSnapshot.Epoch?value.devices.Devices:[];_devicesEpoch=value.devices.Epoch;_rules=value.rules;_activity=value.activity.Items;_flowRules=value.flowRules;_flowSource=value.flowSource;_flowEpoch=value.flowEpoch;},failed:_=>_error="Some home data is unavailable. The latest verified readings are retained.",finished:()=>{});
 private void Updated()=>_ = InvokeAsync(()=>{if(_queries.IsDisposed)return;_now=Clock.GetUtcNow();if(_devicesEpoch!=DeviceSnapshot.Epoch)_devices=[];StateHasChanged();});
 public async ValueTask DisposeAsync(){InverterSnapshot.OnDataUpdated-=Updated;DeviceSnapshot.OnDataUpdated-=Updated;await _queries.DisposeAsync();}
}
