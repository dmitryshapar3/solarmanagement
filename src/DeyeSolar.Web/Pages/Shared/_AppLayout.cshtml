@using System.Security.Claims
@inject DeyeSolar.Web.Localization.UiText T
@inject DeyeSolar.Web.Auth.AccountManagementService Account
@inject DeyeSolar.Web.Billing.IBillingAccessReader Billing
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{var id=User.FindFirstValue(ClaimTypes.NameIdentifier);var profile=id is null?null:await Account.ProfileAsync(id,Context.RequestAborted);var access=id is null?null:await Billing.ReadAsync(id,Context.RequestAborted);var name=profile?.DisplayName??User.Identity?.Name??"";var initials=string.Join("",name.Split(new[]{' ','@','.','_'},StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s=>char.ToUpperInvariant(s[0])));}
<!doctype html><html lang="@T.Language" data-theme="@DeyeSolar.Web.Components.Ui.WebAppearance.CookieTheme(Context)"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · SmartSolar</title><link rel="icon" type="image/svg+xml" href="/images/smartsolar-mark.svg"/><link rel="stylesheet" href="/css/fonts.css"/><link rel="stylesheet" href="/css/tokens.css"/><link rel="stylesheet" href="/css/smartsolar.css" asp-append-version="true"/></head><body><div class="app-shell"><aside class="sidebar" aria-label="@T["Main navigation"]"><div class="sidebar-brand"><a class="brand-lockup" href="/"><img src="/images/smartsolar-mark.svg" width="32" height="32" alt=""/><span>SmartSolar</span></a></div><nav class="app-nav"><a href="/"><partial name="_NavigationIcon" model='@("home")'/>@T["Home"]</a><a href="/energy"><partial name="_NavigationIcon" model='@("energy")'/>@T["Energy"]</a><a href="/devices"><partial name="_NavigationIcon" model='@("devices")'/>@T["Devices"]</a><a href="/automations"><partial name="_NavigationIcon" model='@("automations")'/>@T["Automations"]</a><details class="app-nav-group" open><summary><partial name="_NavigationIcon" model='@("activity")'/>@T["Activity"]</summary><div class="app-nav-submenu"><a href="/activity/readings">@T["Readings"]</a><a href="/activity">@T["Automation"]</a></div></details><hr/><a href="/settings" aria-current="page" class="active"><partial name="_NavigationIcon" model='@("settings")'/>@T["Settings"]</a><a href="/support"><partial name="_NavigationIcon" model='@("help")'/>@T["Help and support"]</a></nav><div class="sidebar-user"><a href="/settings/account"><span class="avatar">@initials</span><span><span class="user-name">@name</span><br/><span class="user-plan">@(access?.Status=="trial"?T.Format("Trial · {0} days left",access.TrialDaysRemaining):access?.HasAccess==true?T["Premium"]:T["Ended"])</span></span></a><a href="/Logout" class="icon-button" aria-label="@T["Sign out"]"><partial name="_NavigationIcon" model='@("logout")'/></a></div></aside><div style="flex:1;min-width:0"><header class="app-topbar"><a href="/settings">← @T["Settings"]</a><a class="brand-lockup" href="/"><img src="/images/smartsolar-mark.svg" width="32" height="32" alt=""/><span>SmartSolar</span></a><a class="avatar" href="/settings/account" aria-label="@T["Account"]">@initials</a></header><main class="app-content" id="main-content"><div class="page-content">@RenderBody()</div></main></div></div><script src="/js/smartsolar.js"></script></body></html>
