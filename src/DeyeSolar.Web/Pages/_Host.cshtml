@page "/"
@inject DeyeSolar.Web.Localization.UiText T
@using Microsoft.AspNetCore.Components.Web
@namespace DeyeSolar.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ _ = T.GetAntiforgeryToken(); }

<!DOCTYPE html>
<html lang="@T.Language">
<head>
    <meta charset="utf-8" />
    <meta name="solar-antiforgery" content="@T.GetAntiforgeryToken()" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="DeyeSolar.Web.styles.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            @T["An error has occurred. This application may no longer respond until reloaded."]
        </environment>
        <environment include="Development">
            @T["An unhandled exception has occurred. See browser dev tools for details."]
        </environment>
        <a href="" class="reload">@T["Reload"]</a>
        <a class="dismiss">X</a>
    </div>

    <script>window.deyeSolarLanguageToken = () => document.querySelector('meta[name="solar-antiforgery"]')?.content || "";</script>
    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
