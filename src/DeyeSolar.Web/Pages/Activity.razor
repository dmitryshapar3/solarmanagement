@page "/activity"
@using DeyeSolar.Web.Redesign
@inject RedesignQueries Queries
@inject DeyeSolar.Domain.Interfaces.IConfigurationRules Rules
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsReader
@inject TimeProvider Clock
@implements IAsyncDisposable
<PageTitle>@T["Activity"] · SmartSolar</PageTitle><PageHeader Title="@T["Activity"]" Subtitle="@T["See why your devices switched or stayed as they were."]"><UiButton Href="@CsvUrl" Icon="download">@T["Download CSV"]</UiButton><UiButton Href="/activity/readings" Variant="outline">@T["Live readings"]</UiButton></PageHeader>
<div class="toolbar"><div class="toolbar-controls"><div class="ui-field"><label for="activity-period">@T["Period"]</label><select id="activity-period" value="@_days" @onchange="Period"><option value="1">@T["Last 24 hours"]</option><option value="7">@T["Last 7 days"]</option><option value="30">@T["Last 30 days"]</option></select></div><div class="ui-field"><label for="activity-rule">@T["Automation"]</label><select id="activity-rule" value="@_rule" @onchange="Rule"><option value="">@T["All automations"]</option>@foreach(var rule in _rules){<option value="@rule.Id">@rule.Name</option>}</select></div></div><label class="checkbox-row"><input type="checkbox" checked="@_changesOnly" @onchange="Changes"/><span>@T["Changes only"]</span></label></div>
@if(_error is not null){<UiState Kind="error" Title="@T["Activity could not be loaded"]" Message="@T.Translate(_error)"/>}@if(_loading&&_feed is null){<UiState Kind="loading" Title="@T["Loading…"]"/>}
@if(_feed is {} feed){<div class="kpi-grid"><div class="kpi"><div class="kpi-label">@T["Switches"]</div><strong class="metric">@feed.Summary.Switches</strong></div><div class="kpi"><div class="kpi-label">@T["Acknowledged commands"]</div><strong class="metric">@feed.Summary.ConfirmedCommands</strong></div><div class="kpi"><div class="kpi-label">@T["Recorded on-duration"]</div><strong class="metric">@UiFormat.Duration(feed.Summary.OnSeconds)</strong></div><div class="kpi"><div class="kpi-label">@T["Coverage"]</div><strong class="metric">@(feed.Summary.ExpectedSeconds>0?UiFormat.Number(feed.Summary.KnownSeconds/feed.Summary.ExpectedSeconds*100,"0")+"%":"—")</strong><small>@(feed.Summary.Partial?T["Partial evidence"]:T["Complete"])</small></div></div>
<UiCard><p class="caption">@UiFormat.Time(feed.Start,_zone) – @UiFormat.Time(feed.End,_zone) · @_zone</p>@if(_items.Count==0){<UiState Title="@T["No activity in this period"]" Message="@T["Future automation checks and device commands will appear here."]"/>}
<div class="activity-list">@foreach(var item in _items){<article class="activity-event" @key="item.Id"><time datetime="@item.End.ToString("O")">@UiFormat.Time(item.End,_zone,"d MMM HH:mm:ss zzz")</time><div><h3>@T[ActivityPresentation.Kind(item.Kind)] @if(item.State.HasValue){<StatusPill Kind="@(item.State==true?"positive":"neutral")">@(item.Kind is "command.manual" or "command.requested"?item.State==true?T["Requested on"]:T["Requested off"]:item.State==true?T["On"]:T["Off"])</StatusPill>}</h3>@if(item.RuleId.HasValue){<a href="@($"/automations/{item.RuleId}")">@(item.RuleName??T["Deleted automation"])</a>}<p>@T[ActivityPresentation.Reason(item.ReasonCode)]</p><div class="gallery-controls">@if(item.ActorUserId is not null){<StatusPill Dot="false">@(item.ActorDisplayName??T["Unknown"])</StatusPill>}@if(item.SocMin.HasValue){<StatusPill Dot="false">@T["Battery"] @item.SocMin–@item.SocMax%</StatusPill>}@if(item.SolarMinWatts.HasValue){<StatusPill Dot="false">@T["Solar"] @UiFormat.Number(item.SolarMinWatts/1000d)–@UiFormat.Number(item.SolarMaxWatts/1000d) kW</StatusPill>}@if(item.Client is not null){<StatusPill Dot="false">@T[item.Client=="web"?"Web":item.Client=="app"?"App":"Automation"]</StatusPill>}</div>
@if(item.Kind=="rule.checked"){<details @ontoggle="()=>Expand(item.Id)"><summary>@T.Format("{0} recorded checks",item.CheckCount) · @UiFormat.Time(item.Start,_zone,"HH:mm")–@UiFormat.Time(item.End,_zone,"HH:mm")</summary>@if(_checks.TryGetValue(item.Id,out var checks)){<table class="data-table"><thead><tr><th>@T["Time"]</th><th>@T["Battery"]</th><th>@T["Solar"]</th><th>@T["Result"]</th></tr></thead><tbody>@foreach(var check in checks.Items){<tr><td>@UiFormat.Time(check.OccurredAt,_zone,"HH:mm:ss zzz")</td><td>@UiFormat.Number(check.BatterySoc,"0")%</td><td>@UiFormat.Number(check.SolarWatts/1000d) kW</td><td>@T[ActivityPresentation.Reason(check.ReasonCode)]</td></tr>}</tbody></table>@if(checks.NextCursor is not null){<UiButton Variant="outline" OnClick="()=>Expand(item.Id,true)" Disabled="@_expanding.Contains(item.Id)">@T["Load more checks"]</UiButton>}}else{<p>@T["Loading…"]</p>}</details>}</div></article>}</div>@if(feed.NextCursor is not null){<UiButton OnClick="()=>Load(true)" Variant="outline" Busy="_loading">@T["Load more activity"]</UiButton>}</UiCard>}
@code{
 [CascadingParameter(Name="DisplayTimeZone")]public string? PersonalTimeZone{get;set;}
 private string _zone=>PersonalTimeZone??_installationZone;
 private readonly AsyncQueryScope _queries=new();private ActivityFeedDto? _feed;private List<ActivityItemDto> _items=[];private List<TriggerRule> _rules=[];private readonly Dictionary<long,ActivityChecksDto> _checks=new();private readonly HashSet<long> _expanding=[];private int _days=1;private int? _rule;private bool _changesOnly,_loading;private string? _error;private string _installationZone="UTC";private DateTimeOffset _end,_start;
 private string CsvUrl=>"/api/activity.csv?from="+Uri.EscapeDataString(_start.ToString("O"))+"&to="+Uri.EscapeDataString(_end.ToString("O"))+"&changesOnly="+_changesOnly.ToString().ToLowerInvariant()+(_rule.HasValue?"&ruleId="+_rule:"");
 protected override async Task OnInitializedAsync(){_installationZone=(await SettingsReader.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display")).TimeZoneId;_rules=await Rules.GetAllAsync(_queries.LifetimeToken);await Load();}
 private Task Load(bool more=false){if(!more){_end=Clock.GetUtcNow();_start=_end.AddDays(-_days);_checks.Clear();}var cursor=more?_feed?.NextCursor:null;return _queries.RunAsync(ct=>Queries.ActivityAsync(_start,_end,_rule,_changesOnly,cursor,ct),started:()=>{_loading=true;_error=null;},received:value=>{_feed=value;if(more)_items.AddRange(value.Items.Where(i=>_items.All(old=>old.Id!=i.Id)));else _items=value.Items.ToList();},failed:_=>_error="Activity could not be loaded.",finished:()=>_loading=false);}
 private async Task Expand(long id,bool more=false){if(_expanding.Contains(id)||!more&&_checks.ContainsKey(id))return;_expanding.Add(id);try{var old=_checks.GetValueOrDefault(id);var value=await Queries.ChecksAsync(id,more?old?.NextCursor:null,_queries.LifetimeToken);if(!_queries.IsDisposed)_checks[id]=more&&old is not null?value with{Items=old.Items.Concat(value.Items).DistinctBy(i=>i.Id).ToArray()}:value;}catch(Exception)when(!_queries.IsDisposed){_error="Recorded checks could not be loaded.";}finally{_expanding.Remove(id);}}
 private Task Period(ChangeEventArgs e){_days=int.TryParse(e.Value?.ToString(),out var n)&&n is 1 or 7 or 30?n:1;return Load();}private Task Rule(ChangeEventArgs e){_rule=int.TryParse(e.Value?.ToString(),out var n)?n:null;return Load();}private Task Changes(ChangeEventArgs e){_changesOnly=e.Value is true;return Load();}
 public ValueTask DisposeAsync()=>_queries.DisposeAsync();
}
