@page "/rules/edit"
@page "/rules/edit/{Id:int}"
@inject DeyeSolar.Domain.Interfaces.IRuleRepository RuleRepo
@inject DeyeSolar.Domain.Interfaces.ISocketInventoryService SocketInventoryService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_isNew ? "New Rule" : "Edit Rule") - DeyeSolar</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(_isNew ? "Create Rule" : "Edit Rule")</MudText>

<MudPaper Class="pa-4" MaxWidth="600px" Elevation="2">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="_rule.Name" Label="Rule Name" Required="true"
                      RequiredError="Name is required" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Target Device</MudText>
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
            <MudSelect T="string" @bind-Value="_rule.EntityId" Label="Device" Required="true"
                       RequiredError="Select a device" Variant="Variant.Outlined" Style="flex:1">
                @if (_devices != null)
                {
                    @foreach (var d in _devices)
                    {
                        <MudSelectItem T="string" Value="@d.Id">@d.Name (@d.Category) @(d.Online ? "" : "- offline")</MudSelectItem>
                    }
                }
                @if (!string.IsNullOrEmpty(_rule.EntityId) && (_devices == null || !_devices.Any(d => d.Id == _rule.EntityId)))
                {
                    <MudSelectItem T="string" Value="@_rule.EntityId">@_rule.EntityId</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDevices"
                       Disabled="_loadingDevices" Size="Size.Medium">
                @if (_loadingDevices) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Load
            </MudButton>
        </MudStack>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_loadError</MudAlert>
        }
        else if (string.IsNullOrEmpty(_rule.EntityId))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                A device must be selected before the rule can be enabled.
            </MudAlert>
        }

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Turn ON Condition</MudText>
        <MudNumericField T="int" Value="_rule.SocTurnOnThreshold" ValueChanged="OnSocTurnOnChanged"
                         Label="Battery SOC at or above (%)"
                         Min="0" Max="100"
                         Error="@IsSocTurnOnInvalid" ErrorText="SOC turn ON must be between 0 and 100%"
                         HelperText="Turn on when battery charge reaches this level" />
        <MudCheckBox T="bool" Value="_rule.UseSeparateSocTurnOffThreshold" ValueChanged="OnUseSeparateSocTurnOffChanged"
                     Label="Set separate turn OFF SOC"
                     Color="Color.Primary" Class="mt-2" />
        <MudNumericField @bind-Value="_rule.SocTurnOffThreshold" Label="Battery SOC at or below (%)"
                         Min="0" Max="100" Class="mt-2"
                         Disabled="@(!_rule.UseSeparateSocTurnOffThreshold)"
                         Error="@IsSocTurnOffInvalid" ErrorText="@SocTurnOffErrorText"
                         HelperText="@(_rule.UseSeparateSocTurnOffThreshold ? "Turn off when battery charge drops to this level" : "Uses the turn-on SOC when disabled")" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Anti-flapping</MudText>
        <MudNumericField @bind-Value="_rule.CooldownMinutes" Label="Cooldown after OFF (min)"
                         Min="1" Max="240"
                         Error="@IsCooldownInvalid" ErrorText="Cooldown must be between 1 and 240 minutes"
                         HelperText="Keep OFF at least this long before re-evaluating turn-on" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Evaluation</MudText>
        <MudNumericField @bind-Value="_rule.IntervalSeconds" Label="Evaluate every (sec)"
                         Min="10" Max="3600"
                         Error="@IsIntervalInvalid" ErrorText="Evaluation interval must be between 10 and 3600 seconds"
                         HelperText="How often this rule runs" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Time Window (optional)</MudText>
        <MudGrid>
            <MudItem xs="6">
                <MudTimePicker @bind-Time="_activeFrom" Label="Active From"
                               Error="@IsTimeWindowInvalid" ErrorText="Set both times or leave both empty" />
            </MudItem>
            <MudItem xs="6">
                <MudTimePicker @bind-Time="_activeTo" Label="Active To"
                               Error="@IsTimeWindowInvalid" ErrorText="Set both times or leave both empty" />
            </MudItem>
        </MudGrid>

        <MudSwitch @bind-Value="_rule.Enabled" Label="Enabled" Color="Color.Primary" Class="mt-3"
                   Disabled="@string.IsNullOrEmpty(_rule.EntityId)" />

        @if (!string.IsNullOrEmpty(_validationError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_validationError</MudAlert>
        }

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            <MudButton Variant="Variant.Outlined" Href="/rules">Cancel</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public int? Id { get; set; }

    private TriggerRule _rule = new()
    {
        Enabled = false,
        SocTurnOnThreshold = 80,
        UseSeparateSocTurnOffThreshold = false,
        SocTurnOffThreshold = 80,
        CooldownMinutes = 15,
        IntervalSeconds = 30
    };
    private bool _isNew => Id == null;
    private MudForm? _form;
    private TimeSpan? _activeFrom;
    private TimeSpan? _activeTo;
    private IReadOnlyList<DeyeSolar.Domain.Models.DevicePowerInfo>? _devices;
    private bool _loadingDevices;
    private string? _loadError;
    private string? _validationError;

    private bool IsSocTurnOnInvalid => _rule.SocTurnOnThreshold is < 0 or > 100;
    private bool IsSocTurnOffInvalid =>
        _rule.UseSeparateSocTurnOffThreshold &&
        (_rule.SocTurnOffThreshold is < 0 or > 100 || _rule.SocTurnOffThreshold > _rule.SocTurnOnThreshold);
    private bool IsCooldownInvalid => _rule.CooldownMinutes is < 1 or > 240;
    private bool IsIntervalInvalid => _rule.IntervalSeconds is < 10 or > 3600;
    private bool IsTimeWindowInvalid => _activeFrom.HasValue != _activeTo.HasValue;

    private string SocTurnOffErrorText
    {
        get
        {
            if (_rule.SocTurnOffThreshold is < 0 or > 100)
                return "SOC turn OFF must be between 0 and 100%";
            if (_rule.SocTurnOffThreshold > _rule.SocTurnOnThreshold)
                return "SOC turn OFF cannot be higher than SOC turn ON";
            return string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await RuleRepo.GetByIdAsync(Id.Value, CancellationToken.None);
            if (existing != null)
            {
                _rule = existing;
                _activeFrom = _rule.ActiveFrom?.ToTimeSpan();
                _activeTo = _rule.ActiveTo?.ToTimeSpan();
            }
        }

        await LoadDevices(forceRefresh: false);
    }

    private async Task LoadDevices()
        => await LoadDevices(forceRefresh: true);

    private async Task LoadDevices(bool forceRefresh)
    {
        _loadingDevices = true;
        _loadError = null;
        try
        {
            _devices = forceRefresh
                ? await SocketInventoryService.RefreshDevicesAsync(CancellationToken.None)
                : await SocketInventoryService.GetCachedDevicesAsync(CancellationToken.None);

            if (!forceRefresh && (_devices == null || _devices.Count == 0))
            {
                _devices = await SocketInventoryService.RefreshDevicesAsync(CancellationToken.None);
            }

            if (_devices.Count == 0)
                _loadError = "No devices found. Check the socket backend in Settings.";
        }
        catch (Exception ex)
        {
            _devices = [];
            _loadError = $"Failed to load devices: {ex.Message}";
        }
        finally
        {
            _loadingDevices = false;
        }
    }

    private void OnSocTurnOnChanged(int value)
    {
        _rule.SocTurnOnThreshold = value;
        if (!_rule.UseSeparateSocTurnOffThreshold)
            _rule.SocTurnOffThreshold = value;
    }

    private void OnUseSeparateSocTurnOffChanged(bool value)
    {
        _rule.UseSeparateSocTurnOffThreshold = value;
        if (!value)
            _rule.SocTurnOffThreshold = _rule.SocTurnOnThreshold;
    }

    private async Task Save()
    {
        _validationError = null;

        if (string.IsNullOrEmpty(_rule.EntityId))
            _rule.Enabled = false;

        if (!_rule.UseSeparateSocTurnOffThreshold)
            _rule.SocTurnOffThreshold = _rule.SocTurnOnThreshold;

        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        if (!ValidateRule())
            return;

        _rule.ActiveFrom = _activeFrom.HasValue ? TimeOnly.FromTimeSpan(_activeFrom.Value) : null;
        _rule.ActiveTo = _activeTo.HasValue ? TimeOnly.FromTimeSpan(_activeTo.Value) : null;

        if (_isNew)
            await RuleRepo.CreateAsync(_rule, CancellationToken.None);
        else
            await RuleRepo.UpdateAsync(_rule, CancellationToken.None);

        Nav.NavigateTo("/rules");
    }

    private bool ValidateRule()
    {
        if (IsSocTurnOnInvalid)
        {
            _validationError = "SOC turn ON must be between 0 and 100%.";
            return false;
        }

        if (IsSocTurnOffInvalid)
        {
            _validationError = SocTurnOffErrorText;
            return false;
        }

        if (IsCooldownInvalid)
        {
            _validationError = "Cooldown must be between 1 and 240 minutes.";
            return false;
        }

        if (IsIntervalInvalid)
        {
            _validationError = "Evaluation interval must be between 10 and 3600 seconds.";
            return false;
        }

        if (IsTimeWindowInvalid)
        {
            _validationError = "Set both time-window values or leave both empty.";
            return false;
        }

        return true;
    }
}
