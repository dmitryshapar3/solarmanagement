@page "/rules/edit"
@page "/rules/edit/{Id:int}"
@inject DeyeSolar.Domain.Interfaces.IConfigurationRules RuleRepo
@inject DeyeSolar.Domain.Interfaces.ISocketInventoryService SocketInventoryService
@inject DeviceStatusSnapshot DeviceSnapshot
@inject SolarManagement.Inverters.Contracts.IInverterCatalog InverterCatalog
@inject Microsoft.Extensions.Options.IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@(_isNew ? T["New Rule"] : T["Edit Rule"]) @T["- DeyeSolar"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(_isNew ? T["Create Rule"] : T["Edit Rule"])</MudText>

<MudPaper Class="pa-4" MaxWidth="600px" Elevation="2">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="_rule.Name" Label="@T["Rule Name"]" Required="true"
                      RequiredError="@T["Name is required"]" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@T["Target Device"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
            <MudSelect T="string" @bind-Value="_rule.EntityId" Label="@T["Device"]" Required="true"
                       RequiredError="@T["Select a device"]" Variant="Variant.Outlined" Style="flex:1">
                @if (_devices != null)
                {
                    @foreach (var d in _devices)
                    {
                        <MudSelectItem T="string" Value="@d.Id">@d.Name (@T.Translate(d.Category)) @(d.Online ? "" : "- " + T["Offline"])</MudSelectItem>
                    }
                }
                @if (!string.IsNullOrEmpty(_rule.EntityId) && (_devices == null || !_devices.Any(d => d.Id == _rule.EntityId)))
                {
                    <MudSelectItem T="string" Value="@_rule.EntityId">@_rule.EntityId</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDevices"
                       Disabled="_loadingDevices" Size="Size.Medium">
                @if (_loadingDevices) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                @T["Load"]
            </MudButton>
        </MudStack>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@T.Translate(_loadError)</MudAlert>
        }
        else if (string.IsNullOrEmpty(_rule.EntityId))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                @T["A device must be selected before the rule can be enabled."]
            </MudAlert>
        }

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@T["Source Inverter"]</MudText>
        <MudSelect T="Guid?" @bind-Value="_rule.SourceInverterId" Label="@T["Battery and PV source"]" Variant="Variant.Outlined"
                   Disabled="_loadingInverters || _saving">
            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@T["Socket-linked or installation default inverter"]</MudSelectItem>
            @foreach (var inverter in _inverters)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)inverter.Id.Value)" Disabled="@(!inverter.Capabilities.HasBattery)">
                    @inverter.Name @(!inverter.Capabilities.HasBattery ? T["- battery data unavailable"] : "")
                </MudSelectItem>
            }
            @if (_rule.SourceInverterId is { } source && !_inverters.Any(inverter => inverter.Id.Value == source))
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)source)" Disabled="true">@source @T["- unavailable source"]</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" OnClick="LoadInverters" Disabled="_loadingInverters || _saving" Class="mt-2">@T["Reload inverter sources"]</MudButton>
        @if (_inverterError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@T.Translate(_inverterError)</MudAlert>
        }
        <MudText Typo="Typo.caption">@T["Battery and PV conditions use this source. The installation default follows its selected inverter."]</MudText>

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@T["Turn ON Condition"]</MudText>
        <MudNumericField Converter="@(T.InputConverter<int>(this, "RuleEdit:_rule.SocTurnOnThreshold"))" T="int" Value="_rule.SocTurnOnThreshold" ValueChanged="OnSocTurnOnChanged"
                         Label="@T["Battery SOC at or above (%)"]"
                         Min="0" Max="100"
                         Error="@IsSocTurnOnInvalid" ErrorText="@T["SOC turn ON must be between 0 and 100%"]"
                         HelperText="@T["Turn on when battery charge reaches this level"]" />
        <MudCheckBox T="bool" Value="_rule.UseSeparateSocTurnOffThreshold" ValueChanged="OnUseSeparateSocTurnOffChanged"
                     Label="@T["Set separate turn OFF SOC"]"
                     Color="Color.Primary" Class="mt-2" />
        <MudNumericField Converter="@(T.InputConverter<int>(this, "RuleEdit:_rule.SocTurnOffThreshold"))" @bind-Value="_rule.SocTurnOffThreshold" Label="@T["Battery SOC at or below (%)"]"
                         Min="0" Max="100" Class="mt-2"
                         Disabled="@(!_rule.UseSeparateSocTurnOffThreshold)"
                         Error="@IsSocTurnOffInvalid" ErrorText="@SocTurnOffErrorText"
                         HelperText="@(_rule.UseSeparateSocTurnOffThreshold ? T["Turn off when battery charge drops to this level"] : T["Uses the turn-on SOC when disabled"])" />
        <MudCheckBox T="bool" Value="_rule.UseSolarProductionThreshold" ValueChanged="OnUseSolarProductionThresholdChanged"
                     Label="@T["Require average PV production"]"
                     Color="Color.Primary" Class="mt-2" />
        <MudNumericField Converter="@(T.InputConverter<int>(this, "RuleEdit:_rule.MinAverageSolarProductionWatts"))" @bind-Value="_rule.MinAverageSolarProductionWatts" Label="@T["Average PV last hour at least (W)"]"
                         Min="1" Max="30000" Class="mt-2"
                         Disabled="@(!_rule.UseSolarProductionThreshold)"
                         Error="@IsSolarProductionThresholdInvalid" ErrorText="@T["Average PV threshold must be between 1 and 30000 W"]"
                         HelperText="@T["Checked only while battery SOC is below 95%; bypassed at 95% or above"]" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@T["Anti-flapping"]</MudText>
        <MudNumericField Converter="@(T.InputConverter<int>(this, "RuleEdit:_rule.CooldownMinutes"))" @bind-Value="_rule.CooldownMinutes" Label="@T["Cooldown after OFF (min)"]"
                         Min="1" Max="240"
                         Error="@IsCooldownInvalid" ErrorText="@T["Cooldown must be between 1 and 240 minutes"]"
                         HelperText="@T["Keep OFF at least this long before re-evaluating turn-on"]" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@T["Evaluation"]</MudText>
        <MudNumericField Converter="@(T.InputConverter<int>(this, "RuleEdit:_rule.IntervalSeconds"))" @bind-Value="_rule.IntervalSeconds" Label="@T["Evaluate every (sec)"]"
                         Min="10" Max="3600"
                         Error="@IsIntervalInvalid" ErrorText="@T["Evaluation interval must be between 10 and 3600 seconds"]"
                         HelperText="@T["How often this rule runs"]" />

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@T["Time Window (optional)"]</MudText>
        <MudGrid>
            <MudItem xs="6">
                <MudTimePicker Converter="@(T.InputConverter<TimeSpan?>(this, "RuleEdit:_activeFrom", "HH:mm"))" @bind-Time="_activeFrom" Label="@T["Active From"]"
                               Error="@IsTimeWindowInvalid" ErrorText="@T["Set both times or leave both empty"]" />
            </MudItem>
            <MudItem xs="6">
                <MudTimePicker Converter="@(T.InputConverter<TimeSpan?>(this, "RuleEdit:_activeTo", "HH:mm"))" @bind-Time="_activeTo" Label="@T["Active To"]"
                               Error="@IsTimeWindowInvalid" ErrorText="@T["Set both times or leave both empty"]" />
            </MudItem>
        </MudGrid>

        <MudSwitch @bind-Value="_rule.Enabled" Label="@T["Enabled"]" Color="Color.Primary" Class="mt-3"
                   Disabled="@string.IsNullOrEmpty(_rule.EntityId)" />

        @if (!string.IsNullOrEmpty(_validationError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@T.Translate(_validationError)</MudAlert>
        }

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving || _loadingInverters">@T["Save"]</MudButton>
            <MudButton Variant="Variant.Outlined" Href="/rules">@T["Cancel"]</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public int? Id { get; set; }

    private TriggerRule _rule = new() { Enabled = false };
    private bool _isNew => Id == null;
    private MudForm? _form;
    private TimeSpan? _activeFrom;
    private TimeSpan? _activeTo;
    private IReadOnlyList<DeyeSolar.Domain.Models.DevicePowerInfo>? _devices;
    private bool _loadingDevices;
    private string? _loadError;
    private string? _validationError;
    private IReadOnlyList<SolarManagement.Inverters.Contracts.InverterDescriptor> _inverters = [];
    private bool _loadingInverters;
    private string? _inverterError;
    private bool _saving;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();

    private bool IsSocTurnOnInvalid => RuleConfigurationPolicy.HasError(_rule, "soc_on_range");
    private bool IsSocTurnOffInvalid => RuleConfigurationPolicy.HasError(_rule, "soc_off_range", "soc_order");
    private bool IsSolarProductionThresholdInvalid => RuleConfigurationPolicy.HasError(_rule, "solar_watts_range");
    private bool IsCooldownInvalid => RuleConfigurationPolicy.HasError(_rule, "cooldown_range");
    private bool IsIntervalInvalid => RuleConfigurationPolicy.HasError(_rule, "interval_range");
    private bool IsTimeWindowInvalid => _activeFrom.HasValue != _activeTo.HasValue;
    private string SocTurnOffErrorText => T.Translate(RuleConfigurationPolicy.Errors(_rule)
        .FirstOrDefault(error => error.Code is "soc_off_range" or "soc_order")?.Message.TrimEnd('.'));

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await RuleRepo.GetByIdAsync(Id.Value, CancellationToken.None);
            if (existing != null)
            {
                _rule = existing;
                _activeFrom = _rule.ActiveFrom?.ToTimeSpan();
                _activeTo = _rule.ActiveTo?.ToTimeSpan();
            }
        }

        await LoadDevices(forceRefresh: false);
        await LoadInverters();
    }

    private async Task LoadInverters()
    {
        if (_disposed || _loadingInverters) return;
        var token = _lifetime.Token;
        _loadingInverters = true;
        try
        {
            var inverters = await InverterCatalog.ListRegisteredAsync(token);
            if (_disposed) return;
            _inverters = inverters;
            _inverterError = null;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception) { if (!_disposed) _inverterError = T["Inverter sources are unavailable. Reload them before enabling this rule."]; }
        finally { if (!_disposed) _loadingInverters = false; }
    }

    private async Task LoadDevices()
        => await LoadDevices(forceRefresh: true);

    private async Task LoadDevices(bool forceRefresh)
    {
        _loadingDevices = true;
        _loadError = null;
        try
        {
            _devices = forceRefresh
                ? await SocketInventoryService.RefreshDevicesAsync(CancellationToken.None)
                : await SocketInventoryService.GetCachedDevicesAsync(CancellationToken.None);

            if (!forceRefresh && (_devices == null || _devices.Count == 0))
            {
                _devices = await SocketInventoryService.RefreshDevicesAsync(CancellationToken.None);
            }

            if (_devices.Count > 0)
                DeviceSnapshot.Update(_devices);

            if (_devices.Count == 0)
                _loadError = T["No devices found. Check the socket backend in Settings."];
        }
        catch (Exception ex)
        {
            _devices = [];
            _loadError = T.Format("Failed to load devices: {0}", ex.Message);
        }
        finally
        {
            _loadingDevices = false;
        }
    }

    private void OnSocTurnOnChanged(int value)
    {
        _rule.SocTurnOnThreshold = value;
        RuleConfigurationPolicy.Normalize(_rule);
    }

    private void OnUseSeparateSocTurnOffChanged(bool value)
    {
        _rule.UseSeparateSocTurnOffThreshold = value;
        RuleConfigurationPolicy.Normalize(_rule);
    }

    private void OnUseSolarProductionThresholdChanged(bool value)
    {
        _rule.UseSolarProductionThreshold = value;
        RuleConfigurationPolicy.Normalize(_rule);
    }

    private async Task Save()
    {
        if (_disposed || _saving) return;
        _saving = true;
        try
        {
            _validationError = null;

            _rule.ActiveFrom = _activeFrom.HasValue ? TimeOnly.FromTimeSpan(_activeFrom.Value) : null;
            _rule.ActiveTo = _activeTo.HasValue ? TimeOnly.FromTimeSpan(_activeTo.Value) : null;
            RuleConfigurationPolicy.Normalize(_rule);

            if (_form != null)
            {
                await _form.Validate();
                if (!_form.IsValid) return;
            }

            if (!ValidateRule())
                return;

            if (_isNew)
                await RuleRepo.CreateAsync(_rule, CancellationToken.None);
            else
                await RuleRepo.UpdateAsync(_rule, CancellationToken.None);

            Nav.NavigateTo("/rules");
        }
        catch (ArgumentException error) { if (!_disposed) _validationError = error.Message; }
        catch (Exception) { if (!_disposed) _validationError = T["The rule could not be saved. Check its device and source, then try again."]; }
        finally { if (!_disposed) _saving = false; }
    }

    private bool ValidateRule()
    {
        if (_rule.Enabled && _rule.SourceInverterId is { } source)
        {
            if (_inverterError is not null || !_inverters.Any(inverter => inverter.Id.Value == source && inverter.Capabilities.HasBattery))
            {
                _validationError = T["Select an available inverter with battery data before enabling this rule."];
                return false;
            }
        }
        var error = RuleConfigurationPolicy.Validate(_rule);
        if (error is null) return true;
        _validationError = error.Message;
        return false;
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
