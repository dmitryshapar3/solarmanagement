@page "/settings/account"
@model DeyeSolar.Web.Pages.AccountSettingsModel
@inject DeyeSolar.Web.Localization.UiText T
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{Layout="/Pages/Shared/_AppLayout.cshtml";ViewData["Title"]=T["Account"];}
<header class="page-heading"><div><h1>@T["Settings"]</h1><p>@T["Your profile, sign-in methods and account security."]</p></div></header><nav class="settings-tabs" aria-label="@T["Settings"]"><a href="/settings">@T["Installation"]</a><a href="/settings/connections">@T["Connections"]</a><a href="/settings/account" class="active" aria-current="page">@T["Account"]</a></nav>
@if(Model.ErrorMessage is not null){<div class="banner critical" role="alert">@T.Translate(Model.ErrorMessage)</div>}@if(Model.Notice is not null){<div class="banner" role="status">@T.Translate(Model.Notice)</div>}
<div class="account-grid"><div class="form-stack"><section class="ui-card"><header class="card-header"><h2>@T["Profile"]</h2></header><form method="post" asp-page-handler="Profile" class="form-stack"><div class="ui-field"><label asp-for="DisplayName">@T["Display name"]</label><input asp-for="DisplayName" maxlength="100" autocomplete="name"/><span class="field-hint">@T["Used in SmartSolar; it does not change your login."]</span></div><div class="ui-field"><label>@T["Email"]</label><input value="@(Model.Profile.VerifiedEmail??T["Not linked"])" disabled/><span class="field-hint">@T["A new contact must be verified before it replaces the current one."]</span></div><button class="ui-button strong" type="submit">@T["Save profile"]</button></form></section>
<section class="ui-card"><header class="card-header"><h2>@T["Sign-in methods"]</h2></header><p class="caption">@T["Keep at least one verified sign-in method available."]</p>
@foreach(var provider in new[]{"google","apple"}){var linked=provider=="google"?Model.Identities?.GoogleLinked==true:Model.Identities?.AppleLinked==true;var available=provider=="google"?Model.Providers.GoogleEnabled:Model.Providers.Apple.WebAvailable;<div class="account-row"><span class="provider-symbol"><partial name="_AuthProviderIcon" model="provider"/></span><span><strong>@(provider=="google"?"Google":"Apple")</strong><br/><small>@(linked?T["Connected"]:T["Not linked"])</small></span>@if(linked||available){<form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="@((linked?"unlink-":"link-")+provider)"/><button class="ui-button outline" type="submit">@(linked?T["Disconnect"]:T["Connect"])</button></form>}else{<span class="caption">@T["Unavailable"]</span>}</div>}
@foreach(var channel in new[]{"email","phone"}){var value=channel=="email"?Model.Identities?.Email:Model.Identities?.Phone;var available=channel=="email"?Model.Providers.EmailEnabled:Model.Providers.PhoneEnabled;<div class="account-row"><span class="provider-symbol">@(channel=="email"?"@":"☎")</span><span><strong>@T[channel=="email"?"Email":"Phone"]</strong><br/><small>@(value??T["Not linked"])</small></span>@if(available){<form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="@("change-"+channel)"/><button class="ui-button outline" type="submit">@(value is null?T["Add"]:T["Change"])</button></form>}</div>}
<div class="account-row"><span class="provider-symbol">⌘</span><span><strong>@T["Password"]</strong><br/><small>@(Model.Identities?.HasPassword==true?T["Password set"]:T["No password set"])</small></span><form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="password"/><button class="ui-button outline" type="submit">@T["Set password"]</button></form></div></section>
<section class="ui-card"><header class="card-header"><h2>@T["Active sessions"]</h2></header>@foreach(var session in Model.Sessions.Sessions){<div class="account-row"><span class="provider-symbol">@(session.Platform=="ios"?"▣":"◫")</span><span><strong>@(session.Client??session.Platform??T["Session"])</strong> @if(session.IsCurrent){<span class="status-pill">@T["This session"]</span>}<br/><small>@T["Last seen:"] @(Model.DisplayTime(session.LastSeenAt)??T["Unavailable"])</small></span><form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="session"/><input type="hidden" name="SessionId" value="@session.Id"/><button class="ui-button outline" type="submit">@T["End session"]</button></form></div>}<form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="other-sessions"/><button class="ui-button outline" type="submit">@T["Sign out other sessions"]</button></form><form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="revoke-all"/><button class="ui-button outline" type="submit">@T["Sign out everywhere"]</button></form></section>
<section class="ui-card"><header class="card-header"><h2>@T["Account data"]</h2></header><div class="account-row"><span><strong>@T["Export your data"]</strong><br/><small>@T["Download a ZIP of your account and installation records."]</small></span><form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="export"/><button class="ui-button outline" type="submit">@T["Export data"]</button></form></div><div class="account-row"><span><strong>@T["Delete account"]</strong><br/><small>@T["Review ownership, subscriptions and deletion before confirming."]</small></span><form method="post" asp-page-handler="Prepare"><input type="hidden" name="Operation" value="delete"/><button class="ui-button critical" type="submit">@T["Delete account"]</button></form></div></section></div>
<div class="form-stack"><section class="ui-card"><header class="card-header"><h2>@T["Preferences"]</h2></header><form method="post" asp-page-handler="Preferences" class="form-stack"><div class="ui-field"><label asp-for="Language">@T["Language"]</label><select asp-for="Language">@foreach(var language in T.Languages){<option value="@language.Code">@language.Name</option>}</select></div><div class="ui-field"><label asp-for="DisplayTimeZoneId">@T["Personal display time zone"]</label><input asp-for="DisplayTimeZoneId" list="account-zones" placeholder="@T["Use installation time zone"]"/><datalist id="account-zones">@foreach(var zone in TimeZoneInfo.GetSystemTimeZones()){<option value="@zone.Id">@zone.Id</option>}</datalist><span class="field-hint">@T["Display preference only. Automation and settlement time zones keep their saved meaning."]</span></div><div class="ui-field"><label for="account-appearance">@T["Appearance"]</label><select id="account-appearance" data-appearance><option value="light">@T["Light"]</option><option value="dark">@T["Dark"]</option><option value="system">@T["System"]</option></select></div><button class="ui-button strong" type="submit">@T["Save preferences"]</button></form></section>
<section class="ui-card" id="subscription"><header class="card-header"><h2>@T["Premium"]</h2></header><span class="status-pill">@(Model.Access?.Status=="trial"?T["Free month"]:Model.Access?.HasAccess==true?T["Active"]:T["Ended"])</span>
@if(Model.Access is {} access){<p>@(access.Status=="trial"?T["Your trial includes one smart plug."]:T["Premium supports additional smart plugs."])</p><dl class="metadata">@if(access.Status=="trial"){<div><dt>@T["Trial remaining"]</dt><dd>@T.Format("{0} days",access.TrialDaysRemaining)</dd></div>}<div><dt>@T["Access until:"]</dt><dd>@Model.DisplayTime(access.SubscriptionExpiresAt??access.TrialEndsAt)</dd></div>@if(access.PlanPeriod is {} period){<div><dt>@T["Plan"]</dt><dd>@T[period=="year"?"Yearly":period=="month"?"Monthly":"Premium"]</dd></div>}@if(access.AutoRenewEnabled is {} renew){<div><dt>@T["Automatic renewal"]</dt><dd>@T[renew?"On":"Off"]</dd></div>}@if(access.RenewalAt is {} renewal){<div><dt>@T["Renewal date"]</dt><dd>@Model.DisplayTime(renewal)</dd></div>}</dl>@if(!access.HasAccess){<div class="banner warning">@T["Your trial has ended. Subscribe to read or control your sockets."]</div>}@if(!access.AppleSubscriptionsEnabled){<div class="banner">@T["Subscriptions are not configured yet. Contact support."]</div>}}
<p class="caption">@T["Purchases and restores are available in the SmartSolar iOS app. App Store prices and available plans are shown there."]</p><a class="ui-button outline" href="https://apps.apple.com/account/subscriptions" target="_blank" rel="noopener noreferrer">@T["Manage App Store subscription"]</a><p class="caption">@T["Deleting your SmartSolar account does not cancel an App Store subscription."]</p></section>
@if(Model.Prepared){<section class="ui-card account-action" id="account-action"><header class="card-header"><h2>@T[Model.ActionTitle]</h2></header>@if(Model.Operation=="delete"){<div class="banner critical">@T["Deletion removes your account and its access. Sole-owned installation records may be deleted. Shared ownership must be resolved first. Deleting the account does not cancel an App Store subscription."]</div>}else if(Model.Operation is "session" or "other-sessions" or "revoke-all"){<p>@T["Ending a session immediately removes its access to the account and installation."]</p>}
@if(Model.ChallengeId.Length>0){<form method="post" asp-page-handler="ContactComplete" class="form-stack"><input type="hidden" asp-for="ChallengeId"/><input type="hidden" asp-for="Destination"/><p>@T.Format("Enter the 6-digit code sent to {0}.",Model.ContactDestination??Model.Destination)</p><div class="ui-field"><label for="contact-code">@T["Verification code"]</label><input id="contact-code" name="ContactCode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required/></div><button type="submit" class="ui-button primary">@T["Verify new contact"]</button></form>}
else{<p class="caption">@T["Confirm with your current password, a code sent to a linked contact, or a linked sign-in provider."]</p><form method="post" asp-page-handler="Action" class="form-stack"><input type="hidden" asp-for="Operation"/><input type="hidden" asp-for="SessionId"/><input type="hidden" asp-for="VerificationId"/>
@if(Model.Operation is "change-email" or "change-phone"){<div class="ui-field"><label for="new-contact">@T[Model.Operation=="change-email"?"New email":"New phone"]</label><input id="new-contact" name="Destination" value="@Model.Destination" type="@(Model.Operation=="change-email"?"email":"tel")" required maxlength="256"/></div>}
@if(Model.Operation=="password"){<div class="ui-field"><label for="new-password">@T["New password"]</label><input id="new-password" name="NewPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" required/><span class="field-hint">@T["12–128 characters. Saving signs out all sessions."]</span></div>}
@if(Model.HasExternalProof){<div class="banner">@T["Account confirmed for this action."]</div>}else{if(Model.Identities?.HasPassword==true){<div class="ui-field"><label for="current-password">@T["Current password"]</label><input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="128"/></div>}if(Model.VerificationId.Length>0){<div class="ui-field"><label for="security-code">@T["Verification code"]</label><input id="security-code" name="Code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code"/></div>}}
@if(Model.Operation=="delete"){<label class="checkbox-row"><input type="checkbox" name="ConfirmDelete" value="true" required/><span>@T["I understand and want to delete this account"]</span></label>}
<div class="form-actions"><a class="ui-button outline" href="/settings/account">@T["Cancel"]</a><button type="submit" class="ui-button @(Model.Operation=="delete"?"critical":"primary")">@T[Model.ActionTitle]</button></div></form>
@if(!Model.HasExternalProof){@if(Model.Identities?.Email is not null&&Model.Providers.EmailEnabled||Model.Identities?.Phone is not null&&Model.Providers.PhoneEnabled){<form method="post" asp-page-handler="SecurityCode" class="form-stack"><input type="hidden" asp-for="Operation"/><input type="hidden" asp-for="SessionId"/><div class="ui-field"><label for="proof-contact">@T["Send a code to"]</label><select id="proof-contact" name="Destination">@if(Model.Identities?.Email is not null&&Model.Providers.EmailEnabled){<option value="@Model.Identities.Email">@Model.Identities.Email</option>}@if(Model.Identities?.Phone is not null&&Model.Providers.PhoneEnabled){<option value="@Model.Identities.Phone">@Model.Identities.Phone</option>}</select></div><input type="hidden" name="Channel" value="@(Model.Identities?.Email is not null&&Model.Providers.EmailEnabled?"email":"phone")"/><button type="submit" class="ui-button outline" data-resend-seconds="@Math.Clamp(Model.RetryAfterSeconds,0,300)" data-resend-label="@T.Format("Send a new code in {0}s","{0}")">@T["Send confirmation code"]</button></form>}
@foreach(var provider in new[]{"google","apple"}){if(provider=="google"&&Model.Identities?.GoogleLinked==true&&Model.Providers.GoogleEnabled||provider=="apple"&&Model.Identities?.AppleLinked==true&&Model.Providers.Apple.WebAvailable){<form method="post" asp-page-handler="External"><input type="hidden" asp-for="Operation"/><input type="hidden" asp-for="SessionId"/><input type="hidden" name="Provider" value="@provider"/><button type="submit" class="ui-button outline">@T.Format("Confirm with {0}",provider=="google"?"Google":"Apple")</button></form>}}}}
</section>}
</div></div>
