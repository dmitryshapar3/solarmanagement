@page "/activity/readings"
@using DeyeSolar.Web.Redesign
@inject RedesignQueries Queries
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsReader
@inject InverterDataSnapshot Snapshot
@inject TimeProvider Clock
@inject Microsoft.Extensions.Options.IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject Microsoft.Extensions.Options.IOptionsMonitor<DeyeSolar.Domain.Options.SolarEstimateOptions> SolarOptions
@implements IAsyncDisposable
<PageTitle>@T["Live readings"] · SmartSolar</PageTitle><PageHeader Title="@T["Live readings"]" Subtitle="@T["The evidence behind your production and automations."]"><UiButton Href="/activity" Variant="outline" Icon="back">@T["Activity"]</UiButton><UiButton Href="@CsvUrl" Icon="download">@T["Download CSV"]</UiButton></PageHeader>
@if (_data is not null)
{
    <ReadingsSnapshot Data="Snapshot.Current" ExpectedDevice="@InverterOptions.CurrentValue.DeviceKey" ProviderName="@(Snapshot.Epoch == _providerEpoch && Snapshot.Current?.InverterId == _providerSource ? _providerName : null)" Now="_now" TimeZoneId="@_zone" MaximumAgeMinutes="SolarOptions.CurrentValue.NowcastActualMaximumAgeMinutes"/>
}
<p class="caption">@T["Grid import and battery discharge are positive; export and charging are negative. A dash means unavailable; measured zero stays zero."]</p>
<div class="toolbar"><div class="segments" aria-label="@T["Readings period"]">@foreach(var hour in new[]{1,6,24,168}){<button aria-pressed="@(_hours==hour)" class="@(_hours==hour?"selected":null)" @onclick="()=>Period(hour)">@T[hour==168?"7 days":hour+" h"]</button>}</div><div class="segments" aria-label="@T["Aggregation"]"><button aria-pressed="@(_aggregate=="raw")" class="@(_aggregate=="raw"?"selected":null)" @onclick="Raw">@T["Raw"]</button><button aria-pressed="@(_aggregate=="5m")" class="@(_aggregate=="5m"?"selected":null)" @onclick="Average">@T["5-minute average"]</button></div></div>
@if(_error is not null){<UiState Kind="error" Title="@T["Readings could not be loaded"]" Message="@T.Translate(_error)"/>}@if(_loading&&_data is null){<UiState Kind="loading" Title="@T["Loading…"]"/>}
@if(_data is {} data){<UiCard><ReadingsPlot Data="data with{Items=_items,Gaps=_gaps}" TimeZoneId="@_zone"/><p class="field-hint">@T["Lines stop when readings or their measurement source are missing. A gap does not mean zero."]</p>@if(data.NextCursor is not null){<p class="caption">@T["The chart shows loaded records. Load more to see the rest of the selected period."]</p>}</UiCard>
@if(_gaps.Count>0){<div class="banner"><div><strong>@T["Incomplete coverage"]</strong><p>@T["Some intervals have no aligned readings. Their cause is shown only when recorded."]</p><details><summary>@T.Format("{0} gaps",_gaps.Count)</summary>@foreach(var gap in _gaps){<p>@UiFormat.Time(gap.From,_zone) – @UiFormat.Time(gap.To,_zone): @T[ActivityPresentation.Reason(gap.ReasonCode)]</p>}</details></div></div>}
<UiCard Title="@T["Recorded values"]"><div class="table-box" tabindex="0"><table class="data-table"><caption>@_zone · @T["A dash means unavailable; measured zero remains 0.00."]</caption><thead><tr><th>@T["Time"]</th><th>@T["Battery · %"]</th><th>@T["Solar · kW"]</th><th>@T["Load · kW"]</th><th>@T["Grid · kW"]</th><th>@T["Battery · W"]</th><th>@T["Voltage · V"]</th><th>@T["Current · A"]</th><th>@T["Temperature · °C"]</th><th>@T["Source"]</th></tr></thead><tbody>@foreach(var entry in Entries){@if(entry.Gap is {} gap){<tr class="gap-row"><th scope="row">@UiFormat.Time(gap.From,_zone,"d MMM HH:mm zzz") – @UiFormat.Time(gap.To,_zone,"HH:mm zzz")</th><td colspan="9">@T[ActivityPresentation.Reason(gap.ReasonCode)] · @T["Gaps stay gaps. Missing readings are never shown as zero."]</td></tr>}else if(entry.Reading is {} row){<tr><th scope="row"><time datetime="@row.Timestamp.ToString("O")">@UiFormat.Time(row.Timestamp,_zone,"d MMM HH:mm:ss zzz")</time></th><td>@UiFormat.Number(row.BatterySoc,"0.#")</td><td>@UiFormat.Number(row.SolarProduction/1000d)</td><td>@UiFormat.Number(row.LoadPower/1000d)</td><td>@UiFormat.Number(row.GridConsumption/1000d)</td><td>@UiFormat.Number(row.BatteryPower,"0")</td><td>@UiFormat.Number(row.BatteryVoltage,"0.#")</td><td>@UiFormat.Number(row.BatteryCurrent,"0.#")</td><td>@UiFormat.Number(row.BatteryTemperature,"0.#")</td><td><details><summary>@T["Evidence"]</summary><p>@row.DataSource</p><p>@T["Solar measured:"] @(row.SolarObservedAt is {} at?UiFormat.Time(at,_zone):T["Unavailable"])</p><p>@T["Inverter ID:"] @(row.InverterId?.ToString()??T["Unavailable"])</p><p>@T["Configuration revision:"] @row.ConfigurationRevision</p><p>@T["Runtime generation:"] @row.RuntimeGeneration</p></details></td></tr>}}</tbody></table></div>@if(_items.Count==0){<UiState Title="@T["No readings in this period"]" Message="@T["Connect an inverter and wait for a measured reading."]"/>}@if(data.NextCursor is not null){<UiButton Variant="outline" OnClick="()=>Load(true)" Busy="_loading">@T["Load more readings"]</UiButton>}</UiCard>}
@code{
 [CascadingParameter(Name="DisplayTimeZone")]public string? PersonalTimeZone{get;set;}
 private string _zone=>PersonalTimeZone??_installationZone;
 private int _hours=6;private string _aggregate="raw",_installationZone="UTC";private ReadingsViewDto? _data;private List<ReadingRowDto> _items=[];private List<ReadingGapDto> _gaps=[];private string? _error;private bool _loading;private readonly AsyncQueryScope _queries=new();private string CsvUrl=>"/api/readings.csv?hours="+_hours+"&aggregate="+_aggregate;
 private IEnumerable<(ReadingRowDto? Reading,ReadingGapDto? Gap,DateTimeOffset At)> Entries=>_items.Select(row=>((ReadingRowDto?)row,(ReadingGapDto?)null,row.Timestamp)).Concat(_gaps.Select(gap=>((ReadingRowDto?)null,(ReadingGapDto?)gap,gap.To))).OrderByDescending(entry=>entry.Item3);
 private DateTimeOffset _now; private string? _providerName; private Guid? _providerSource; private long _providerEpoch;
 protected override async Task OnInitializedAsync(){_now=Clock.GetUtcNow();Snapshot.OnDataUpdated+=Updated;_installationZone=(await SettingsReader.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display")).TimeZoneId;await Load();_queries.StartRefresh(Clock,TimeSpan.FromSeconds(30),()=>InvokeAsync(()=>{_now=Clock.GetUtcNow();StateHasChanged();}));}
 private Task Load(bool more=false)=>_queries.RunAsync(async ct=>{var source=Snapshot.Current?.InverterId;var epoch=Snapshot.Epoch;var data=await Queries.ReadingsAsync(_hours,_aggregate,more?_data?.NextCursor:null,ct);var provider=await Queries.ReadingsProviderAsync(source,ct);return(data,provider,source,epoch);},started:()=>{_loading=true;_error=null;},received:result=>{var value=result.data;_providerName=result.provider;_providerSource=result.source;_providerEpoch=result.epoch;_data=value;_items=more?_items.Concat(value.Items).DistinctBy(i=>i.Id).OrderByDescending(i=>i.Timestamp).ThenByDescending(i=>i.Id).ToList():value.Items.ToList();_gaps=more?_gaps.Concat(value.Gaps).Distinct().ToList():value.Gaps.ToList();},failed:_=>_error="Readings could not be loaded.",finished:()=>_loading=false);
 private Task Period(int hours){_hours=hours;return Load();}private Task Raw(){_aggregate="raw";return Load();}private Task Average(){_aggregate="5m";return Load();}private void Updated()=>_ = InvokeAsync(()=>{if(_queries.IsDisposed)return;_now=Clock.GetUtcNow();StateHasChanged();});public async ValueTask DisposeAsync(){Snapshot.OnDataUpdated-=Updated;await _queries.DisposeAsync();}
}
