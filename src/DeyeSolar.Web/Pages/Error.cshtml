@page
@inject DeyeSolar.Web.Localization.UiText T
@model DeyeSolar.Web.Pages.ErrorModel

<!DOCTYPE html>
<html lang="@T.Language">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@T["Error"]</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="main">
        <div class="content px-4">
            <h1 class="text-danger">@T["Error."]</h1>
            <h2 class="text-danger">@T["An error occurred while processing your request."]</h2>

            @if (Model.ShowRequestId)
            {
                <p>
                    <strong>@T["Request ID:"]</strong> <code>@Model.RequestId</code>
                </p>
            }

            <h3>@T["Development Mode"]</h3>
            <p>
                @T["Swapping to the"] <strong>Development</strong> @T["environment displays detailed information about the error that occurred."]
            </p>
            <p>
                <strong>@T["The Development environment shouldn't be enabled for deployed applications."]</strong>
                @T["It can result in displaying sensitive information from exceptions to end users. For local debugging, enable the"] <strong>Development</strong> @T["environment by setting the"] <strong>ASPNETCORE_ENVIRONMENT</strong> @T["environment variable to"] <strong>Development</strong>
                @T["and restarting the app."]
            </p>
        </div>
    </div>
</body>

</html>
