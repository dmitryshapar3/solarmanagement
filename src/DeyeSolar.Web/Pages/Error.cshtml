@page
@model DeyeSolar.Web.Pages.ErrorModel
@inject DeyeSolar.Web.Localization.UiText T
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]=T["Error"]; }
<h1>@T["Something went wrong"]</h1><p role="alert">@T["An error occurred while processing your request."]</p>
@if(Model.ShowRequestId) { <p><strong>@T["Request ID:"]</strong> <code>@Model.RequestId</code></p> }
<a href="/" class="ui-button primary">@T["Go to Home"]</a><a href="/support" class="ui-button outline">@T["Contact support"]</a>
