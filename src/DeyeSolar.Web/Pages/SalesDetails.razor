@page "/sales-details"
@inherits SalesQueryPageBase

<PageTitle>@T["Sales details - DeyeSolar"]</PageTitle>
<MudButton Href="@BackUrl" Variant="Variant.Outlined" Class="mb-4">@T["Back"]</MudButton>
@if (ValidSelection)
{
    <SalesStatistics Detailed="true" InitialRequest="Request" />
}
else
{
    <MudAlert Severity="Severity.Warning">@T["Choose a valid sales period and dates from 2000 onwards, no later than today. A custom period can include up to 366 days."]</MudAlert>
}
