@page "/history"
@inject IDbContextFactory<DeyeSolar.Web.Data.DeyeSolarDbContext> DbFactory
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsService
@using Microsoft.EntityFrameworkCore
@inject TimeProvider Clock
@implements IAsyncDisposable

<PageTitle>@T["History - DeyeSolar"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@T["Reading History"]</MudText>

<MudStack Row="true" Class="mb-4" Spacing="2">
    <MudSelect @bind-Value="_hours" Label="@T["Time Range"]" Dense="true" Style="max-width: 200px;">
        <MudSelectItem Value="1">@T["Last 1 hour"]</MudSelectItem>
        <MudSelectItem Value="6">@T["Last 6 hours"]</MudSelectItem>
        <MudSelectItem Value="24">@T["Last 24 hours"]</MudSelectItem>
        <MudSelectItem Value="168">@T["Last 7 days"]</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Outlined" OnClick="LoadData">@T["Refresh"]</MudButton>
</MudStack>

@if (_readings == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_readings.Count == 0)
{
    <MudAlert Severity="Severity.Info">@T["No readings in selected time range."]</MudAlert>
}
else
{
    <MudTable Items="_readings" Hover="true" Dense="true" Elevation="2" FixedHeader="true" Height="500px">
        <HeaderContent>
            <MudTh>@T["Time"]</MudTh>
            <MudTh>@T["SOC %"]</MudTh>
            <MudTh>@T["Solar W"]</MudTh>
            <MudTh>@T["Battery W"]</MudTh>
            <MudTh>@T["Grid W"]</MudTh>
            <MudTh>@T["Load W"]</MudTh>
            <MudTh>@T["Voltage V"]</MudTh>
            <MudTh>@T["Temp C"]</MudTh>
            <MudTh>@T["Source"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@TimeHelper.ToUserTime(context.Timestamp, _tz).ToString("g", System.Globalization.CultureInfo.CurrentCulture)</MudTd>
            <MudTd>@(context.BatterySocValid ? context.BatterySoc.ToString() : "—")</MudTd>
            <MudTd>@(context.SolarPowerValid ? context.SolarProduction.ToString() : "—")</MudTd>
            <MudTd>@(context.BatteryPowerValid ? context.BatteryPower.ToString() : "—")</MudTd>
            <MudTd>@(context.GridPowerValid ? context.GridConsumption.ToString() : "—")</MudTd>
            <MudTd>@(context.LoadPowerValid ? context.LoadPower.ToString() : "—")</MudTd>
            <MudTd>@(context.BatteryVoltageValid ? context.BatteryVoltage.ToString("F1") : "—")</MudTd>
            <MudTd>@(context.BatteryTemperatureValid ? context.BatteryTemperature.ToString("F1") : "—")</MudTd>
            <MudTd>@T.Translate(context.DataSource)</MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.caption" Class="mt-2">@T.Format("Showing {0} readings", _readings.Count)</MudText>
}

@code {
    private List<DeyeSolar.Web.Data.Reading>? _readings;
    private int _hours = 6;
    private string? _tz;
    private readonly AsyncQueryScope _queries = new();

    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        _tz = display.TimeZoneId;
        await LoadData();
    }

    private Task LoadData()
    {
        var range = DeyeSolar.Web.Data.HistoryQueryPolicy.Range(Clock.GetUtcNow(), _hours);
        return _queries.RunAsync(async ct =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(ct);
            return await DeyeSolar.Web.Data.HistoryQueryPolicy.Readings(db.Readings, range).ToListAsync(ct);
        }, () => { }, readings => _readings = readings,
            exception => System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(exception).Throw(), () => { });
    }

    public ValueTask DisposeAsync() => _queries.DisposeAsync();
}
