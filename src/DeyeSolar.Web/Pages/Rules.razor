@page "/rules"
@inject DeyeSolar.Domain.Interfaces.IConfigurationRules RuleRepo
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsService
@inject NavigationManager Nav
@using DeyeSolar.Web.Shared

<PageTitle>@T["Rules - DeyeSolar"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@T["Trigger Rules"]</MudText>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@T.Translate(_error)</MudAlert>
}

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/rules/edit"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
    @T["Add Rule"]
</MudButton>

@if (_rules == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_rules.Count == 0)
{
    <MudAlert Severity="Severity.Info">@T["No rules configured. Create one to get started."]</MudAlert>
}
else
{
    <MudTable Items="_rules" Hover="true" Dense="true" Elevation="2">
        <HeaderContent>
            <MudTh>@T["Name"]</MudTh>
            <MudTh>@T["Device"]</MudTh>
            <MudTh>@T["Turn ON"]</MudTh>
            <MudTh>@T["PV Avg"]</MudTh>
            <MudTh>@T["Turn OFF"]</MudTh>
            <MudTh>@T["Cooldown"]</MudTh>
            <MudTh>@T["Interval"]</MudTh>
            <MudTh>@T["Time Window"]</MudTh>
            <MudTh>@T["State"]</MudTh>
            <MudTh>@T["Changed"]</MudTh>
            <MudTh>@T["Enabled"]</MudTh>
            <MudTh>@T["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>
                @if (string.IsNullOrEmpty(context.EntityId))
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@T["Not set"]</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2">@context.EntityId[..Math.Min(context.EntityId.Length, 12)]...</MudText>
                }
            </MudTd>
            <MudTd>
                <span>@T["SOC ≥"] @context.SocTurnOnThreshold%</span>
            </MudTd>
            <MudTd>@FormatSolarProductionThreshold(context)</MudTd>
            <MudTd>
                <span>@FormatTurnOffThreshold(context)</span>
            </MudTd>
            <MudTd>@(context.CooldownMinutes) @T["min"]</MudTd>
            <MudTd>@(context.IntervalSeconds)@T["s"]</MudTd>
            <MudTd>@FormatTimeWindow(context)</MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.CurrentState ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.CurrentState ? T["ON"] : T["OFF"])
                </MudChip>
            </MudTd>
            <MudTd>
                @if (context.CurrentStateChangedAt.HasValue)
                {
                    <MudText Typo="Typo.body2">
                        @TimeHelper.ToUserTime(context.CurrentStateChangedAt.Value, _tz).ToString("g", System.Globalization.CultureInfo.CurrentCulture)
                    </MudText>
                }
                else
                {
                    <span>-</span>
                }
            </MudTd>
            <MudTd>
                <MudSwitch T="bool" Value="context.Enabled" ValueChanged="@(v => ToggleEnabled(context, v))"
                           Color="Color.Primary" />
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo($"/rules/edit/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteRule(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<TriggerRule>? _rules;
    private string? _tz;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        _tz = display.TimeZoneId;
        _rules = await RuleRepo.GetAllAsync(CancellationToken.None);
    }

    private static string FormatTimeWindow(TriggerRule rule)
    {
        if (!rule.ActiveFrom.HasValue || !rule.ActiveTo.HasValue)
            return "-";

        return $"{rule.ActiveFrom.Value:HH:mm} - {rule.ActiveTo.Value:HH:mm}";
    }

    private string FormatTurnOffThreshold(TriggerRule rule)
    {
        var threshold = rule.UseSeparateSocTurnOffThreshold
            ? rule.SocTurnOffThreshold
            : rule.SocTurnOnThreshold;

        return rule.UseSeparateSocTurnOffThreshold
            ? T.Format("SOC <= {0}%", threshold)
            : T.Format("SOC <= {0}% (same)", threshold);
    }

    private string FormatSolarProductionThreshold(TriggerRule rule)
        => rule.UseSolarProductionThreshold
            ? T.Format(">= {0} W (SOC < 95%)", rule.MinAverageSolarProductionWatts)
            : "-";

    private async Task ToggleEnabled(TriggerRule rule, bool enabled)
    {
        rule.Enabled = enabled;
        try { await RuleRepo.UpdateAsync(rule, CancellationToken.None); _error = null; }
        catch (ArgumentException error) { _error = error.Message; }
        catch { _error = "The rule could not be saved. Check its device and source, then try again."; }
        finally { _rules = await RuleRepo.GetAllAsync(CancellationToken.None); }
    }

    private async Task DeleteRule(TriggerRule rule)
    {
        try { await RuleRepo.DeleteAsync(rule.Id, rule.ConfigurationVersion!, CancellationToken.None); _error = null; }
        catch (ArgumentException error) { _error = error.Message; }
        catch { _error = "The rule could not be saved. Check its device and source, then try again."; }
        finally { _rules = await RuleRepo.GetAllAsync(CancellationToken.None); }
    }
}
