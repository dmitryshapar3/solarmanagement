@page "/settings/connections"
@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Services
@using DeyeSolar.Web.Integrations
@using DeyeSolar.Web.Auth
@inject RedesignQueries Queries
@inject InteractiveSecurityContext Security
@inject IIntegrationTestService Tests
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsReader
@inject IntegrationChangeNotifier Changes
@inject DeyeSolar.Web.Data.CurrentInstallation Installation
@implements IAsyncDisposable
<PageTitle>@T["Connections"] · SmartSolar</PageTitle><PageHeader Title="@T["Settings"]" Subtitle="@T["Connected services and their latest evidence."]"/><SettingsTabs/>
@if(_error is not null){<div class="banner critical" role="alert">@T.Translate(_error)</div>}
@if(_status is {} status){<div class="two-columns connected-services">@foreach(var service in status.Services){<ConnectedServiceCard Service="service" TimeZoneId="@_zone" CanManage="_canManage" OnCheck="CheckSaved" OnDiscover="DiscoverSaved" OnManage="ManageSaved"/>}</div>
<div class="two-columns connected-services"><UiCard Title="@T["Weather forecast"]"><StatusPill Kind="@(status.ForecastRetrievedAt.HasValue?"positive":"neutral")">@(status.ForecastRetrievedAt.HasValue?T["Last available forecast"]:T["Awaiting forecast"])</StatusPill><p class="caption">@T["Retrieved:"] @(status.ForecastRetrievedAt is {} forecast?T.Time(forecast,_zone):T["Unavailable"])</p><p class="caption">@T["Weather comes from Open-Meteo. No customer API key is required."]</p>@if(_canTest){<UiButton Variant="outline" OnClick="Weather" Busy="@(_testing=="openmeteo")">@T["Check connection"]</UiButton>}@if(_results.TryGetValue("openmeteo",out var weather)){<p role="status">@T.Translate(weather.Message)</p>}<div class="attribution"><a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo · CC BY 4.0</a></div></UiCard><UiCard Title="@T["Electricity prices"]"><p class="caption">@T["Price source"]: @(status.PriceSource=="manual"?T["Fixed price"]:status.PriceSource=="feed"?T["CSV / XML feed"]:"PSE RCE")</p>@if(status.PriceSource=="manual"){<p>@T["Sale price"]: @((status.ManualPricePlnPerKwh??0).ToString("0.######",T.Culture)) PLN/kWh</p>}else{<StatusPill Kind="@(status.MissingPriceHours==0?"positive":"warning")">@(status.MissingPriceHours==0?T["Stored hours complete"]:T.Format("{0} hours missing prices",status.MissingPriceHours))</StatusPill><p class="caption">@T["Latest stored interval:"] @(status.LatestStoredPriceAt is {} price?T.Time(price,status.SettlementTimeZoneId):T["Unavailable"])</p><p class="caption">@T.Time(status.PriceWindowStart,status.SettlementTimeZoneId) – @T.Time(status.PriceWindowEnd,status.SettlementTimeZoneId)</p><p class="caption">@T["A stored interval does not imply every price in the settlement day is published."]</p>@if(_canTest&&status.PriceSource=="pse"){<UiButton Variant="outline" OnClick="Prices" Busy="@(_testing=="pse")">@T["Check connection"]</UiButton>}@if(_results.TryGetValue("pse",out var priceResult)){<p role="status">@T.Translate(priceResult.Message)</p>}}</UiCard></div>}
@if(_canManage){<IntegrationSettings @ref="_editor"/>}else{<UiCard><p>@T["The installation owner or integration manager can add and edit connections."]</p></UiCard>}
@code{
 [CascadingParameter(Name="DisplayTimeZone")]public string? PersonalTimeZone{get;set;}
 private string _zone=>PersonalTimeZone??_installationZone;
 private IntegrationStatusViewDto? _status;private IntegrationSettings? _editor;private bool _canManage,_canTest;private string _installationZone="UTC";private string? _error,_testing;private readonly Dictionary<string,IntegrationTestResult> _results=[];private readonly AsyncQueryScope _queries=new();
 protected override async Task OnInitializedAsync(){Changes.Changed+=ConnectionChanged;_installationZone=(await SettingsReader.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display")).TimeZoneId;try{await Security.EnsureAsync(InstallationPermission.ManageIntegrations,_queries.LifetimeToken);_canManage=true;}catch(InstallationAccessException e)when(e.Status==403){}try{await Security.EnsureAsync(InstallationPermission.ManageSettings,_queries.LifetimeToken);_canTest=true;}catch(InstallationAccessException e)when(e.Status==403){}await LoadStatus();}
 private Task LoadStatus()=>_queries.RunAsync(ct=>Queries.IntegrationsAsync(ct),started:()=>{},received:value=>{_status=value;_error=null;},failed:_=>_error="Connection status could not be loaded.",finished:()=>{});
 private void ConnectionChanged(string installation,Guid instance){if(_queries.IsDisposed||installation.Length>0&&installation!=Installation.Id)return;_=InvokeAsync(async()=>{if(_queries.IsDisposed)return;await LoadStatus();if(!_queries.IsDisposed)StateHasChanged();});}
 private Task CheckSaved(Guid id)=>OpenSaved(id,"test");private Task DiscoverSaved(Guid id)=>OpenSaved(id,"discover");private Task ManageSaved(Guid id)=>OpenSaved(id,"settings");
 private async Task OpenSaved(Guid id,string action){if(_editor is null)return;try{await Security.EnsureAsync(InstallationPermission.ManageIntegrations,_queries.LifetimeToken);await _editor.OpenSavedAsync(id,action);}catch(InstallationAccessException e)when(e.Status==403){_canManage=false;}}
 private Task Weather()=>Test("openmeteo");private Task Prices()=>Test("pse");private async Task Test(string kind){if(_testing is not null)return;_testing=kind;try{await Security.EnsureAsync(InstallationPermission.ManageSettings,_queries.LifetimeToken);_results[kind]=await Tests.TestAsync(kind,new(),_queries.LifetimeToken);}catch(Exception)when(!_queries.IsDisposed){_error="The provider could not be verified. Please try again.";}finally{_testing=null;}}
 public ValueTask DisposeAsync(){Changes.Changed-=ConnectionChanged;return _queries.DisposeAsync();}
}
