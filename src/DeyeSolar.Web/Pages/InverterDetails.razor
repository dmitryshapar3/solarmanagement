@page "/inverter-details"
@using DeyeSolar.Web.Services
@inject InverterDataSnapshot Snapshot
@inject IInverterRefreshService InverterRefresh
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsService
@inject TimeProvider Clock
@inject Microsoft.Extensions.Options.IOptionsMonitor<DeyeSolar.Domain.Options.SolarEstimateOptions> EstimateOptions
@inject Microsoft.Extensions.Options.IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@implements IAsyncDisposable

<PageTitle>@T["Inverter details - DeyeSolar"]</PageTitle>
<MudPaper Class="pa-4" Elevation="2">
    <div class="inverter-details-heading">
        <h1>@T["Inverter details"]</h1>
        <div class="inverter-details-actions">
            <a href="@EnergyDetailsNavigation.ReturnPath(ReturnTo)">@T["Back"]</a>
            <button type="button" @onclick="RefreshAsync" disabled="@_refreshing" aria-label="@T["Refresh inverter details"]">@(_refreshing ? T["Refreshing…"] : T["Refresh"])</button>
        </div>
    </div>
    @if (_error is not null) { <p class="inverter-details-error" role="alert">@T.Translate(_error)</p> }
    <InverterReadings Data="_reading" TimeZoneId="@_timeZone" Now="Clock.GetUtcNow()"
                      AlignmentToleranceSeconds="EstimateOptions.CurrentValue.AlignmentToleranceSeconds"
                      MaximumAgeMinutes="EstimateOptions.CurrentValue.NowcastActualMaximumAgeMinutes"
                      ExpectedDeviceSn="@InverterOptions.CurrentValue.DeviceKey" />
</MudPaper>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    private InverterData? _reading;
    private string _timeZone = "Europe/Warsaw";
    private bool _refreshing;
    private bool _disposed;
    private string? _error;
    private readonly AsyncQueryScope _queries = new();
    protected override async Task OnInitializedAsync()
    {
        var display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
        if (_disposed) return;
        _timeZone = display.TimeZoneId;
        _reading = Snapshot.Current;
        Snapshot.OnDataUpdated += Updated;
        _queries.StartRefresh(Clock, TimeSpan.FromSeconds(30), () => InvokeAsync(() => { if (!_disposed) StateHasChanged(); }));
    }
    private void Updated()
    {
        if (_disposed) return;
        _ = InvokeAsync(() => { if (!_disposed) { _reading = Snapshot.Current; StateHasChanged(); } });
    }
    private async Task RefreshAsync()
    {
        if (_disposed || _refreshing) return;
        _refreshing = true;
        _error = null;
        try { await InverterRefresh.RefreshAsync(_queries.LifetimeToken); if (!_disposed) _reading = Snapshot.Current; }
        catch (OperationCanceledException) when (_disposed || _queries.LifetimeToken.IsCancellationRequested) { }
        catch (Exception) { if (!_disposed) _error = T["Could not refresh inverter readings. Showing the last available reading; please try again."]; }
        finally { if (!_disposed) _refreshing = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        Snapshot.OnDataUpdated -= Updated;
        await _queries.DisposeAsync();
    }
}
