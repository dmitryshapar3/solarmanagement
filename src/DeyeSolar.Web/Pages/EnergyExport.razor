@page "/energy/export"
@using DeyeSolar.Web.Services
@inject IExportSalesService Sales
@inject NavigationManager Nav
@inject TimeProvider Clock
@inject Microsoft.Extensions.Options.IOptionsMonitor<DeyeSolar.Domain.Options.SolarSalesOptions> SalesOptions
@implements IAsyncDisposable
<PageTitle>@T["Export"] · SmartSolar</PageTitle><PageHeader Title="@T["Energy"]" Subtitle="@T["Your grid export and its estimated value"]"><UiButton Icon="download" Href="@CsvUrl">@T["Download CSV"]</UiButton></PageHeader>
<div class="toolbar"><nav class="segments" aria-label="@T["Energy"]"><NavLink href="/energy" Match="NavLinkMatch.All">@T["Production"]</NavLink><NavLink href="/energy/export">@T["Export"]</NavLink></nav><div class="toolbar-controls"><div class="segments" aria-label="@T["Sales period"]">@foreach(var p in Enum.GetValues<ExportSalesPeriod>()){<button class="@(p==_request.Period?"selected":null)" aria-pressed="@((p==_request.Period).ToString().ToLowerInvariant())" @onclick="()=>Period(p)">@T[p.ToString()]</button>}</div>@if(_request.Period!=ExportSalesPeriod.Custom){<button class="icon-button" aria-label="@T["Previous period"]" disabled="@(!CanMove(-1))" @onclick="()=>Move(-1)"><UiIcon Name="back"/></button><input class="period-date" type="@DateType" aria-label="@T["Date"]" value="@DateInput" @onchange="DateChanged" min="@DateMinimum" max="@DateMaximum"/><button class="icon-button" aria-label="@T["Next period"]" disabled="@(!CanMove(1))" @onclick="()=>Move(1)"><UiIcon Name="chevron"/></button>}</div></div>
@if(_request.Period==ExportSalesPeriod.Custom){<div class="toolbar ui-card"><label>@T["From"]<input type="date" @bind="_from" min="2000-01-01" max="@Today.ToString("yyyy-MM-dd")"/></label><label>@T["To"]<input type="date" @bind="_to" min="2000-01-01" max="@Today.ToString("yyyy-MM-dd")"/></label><UiButton Variant="primary" OnClick="Apply">@T["Apply"]</UiButton><span class="caption">@T["Inclusive · up to 366 days"]</span></div>}
@if(_error is not null){<UiState Kind="error" Title="@T["Export could not be loaded"]" Message="@T.Translate(_error)"/>}
@if(_loading&&_data is not null){<p role="status">@T["Refreshing…"]</p>}
@if(_loading&&_data is null){<UiState Kind="loading" Title="@T["Loading…"]"/>}
@if(_data is {} data){
<div class="kpi-grid"><div class="kpi"><div class="kpi-label">@T["Exported to grid"]</div><div class="kpi-value" data-testid="sales-export">@UiFormat.Number(data.ExportKwh)<small> kWh</small></div><small>@T["Completed hours only"]</small><small data-testid="sales-credited">@T["Credited after hourly netting"]: @UiFormat.Number(data.CreditedExportKwh) kWh</small></div><div class="kpi"><div class="kpi-label">@T["Energy value"]</div><div class="kpi-value" data-testid="sales-value">@UiFormat.Number(data.EnergyValuePln)<small> PLN</small></div><small>@T["Signed market value"]</small></div><div class="kpi"><div class="kpi-label">@T["Estimated deposit"]</div><div class="kpi-value" data-testid="sales-deposit">@UiFormat.Number(data.EstimatedDepositPln)<small> PLN</small></div><small>@T["Estimated credit · × 1.23"]</small></div><div class="kpi"><div class="kpi-label">@T["Coverage"]</div><div class="kpi-value">@data.ValuedHours<small> / @data.ExpectedHours h</small></div><small data-testid="sales-measured">@T["Measured hours"]: @data.ObservedHours / @data.ExpectedHours</small><small>@T["Priced hours"]: @data.ValuedHours / @data.ExpectedHours</small><small>@(data.IsPartial?T["Partial data"]:T["Complete"])</small></div></div>
@if(data.DataError is not null){<div class="banner">@T.Translate(data.DataError)</div>}
@if(data.PriceError is not null||data.MissingPriceHours?.Count>0){<div class="banner"><div>@T["Some completed hours have no published price yet. Energy stays visible; value remains unavailable."] @if(data.PriceError is not null){@T.Translate(data.PriceError)}<details><summary>@T["Missing price hours"]</summary>@foreach(var hour in data.MissingPriceHours??[]){<p>@UiFormat.Time(hour,data.TimeZoneId,"d MMM HH:mm zzz")</p>}</details></div><UiButton Variant="outline" OnClick="RecheckPrices" Busy="_loading">@T["Check prices again"]</UiButton></div>}
<UiCard Title="@T["Export over time"]"><ExportPlot Data="data" SelectedIndex="_selected" SelectedIndexChanged="SelectInterval"/><p class="field-hint">@T["Totals cover completed hours. Current hour is provisional."]</p>@if(data.UpdatedAt is {} updated){<p class="caption"><time datetime="@updated.ToString("O")">@T.Format("Updated {0}",UiFormat.Time(updated,data.TimeZoneId))</time></p>}</UiCard>
<UiCard Title="@T["Completed hours and current progress"]"><div class="table-box" tabindex="0"><table class="data-table"><caption>@data.TimeZoneId · @T["A dash means unavailable; measured zero remains 0.00."]</caption><thead><tr><th>@T["Period"]</th><th>@T["Export · kWh"]</th>@if(data.Request.Period==ExportSalesPeriod.Day){<th>@T["Price · PLN/kWh"]</th>}<th>@T["Energy value · PLN"]</th><th>@T["Estimated deposit · PLN"]</th><th>@T["Status"]</th></tr></thead><tbody>
@for(var i=0;i<data.Buckets.Count;i++){var index=i;var b=data.Buckets[i];var progress=data.CurrentHour is {} p&&p.Start>=b.Start&&p.Start<b.End;var hour=data.Hours?.FirstOrDefault(h=>h.Start==b.Start);<tr class="@(_selected==index?"selected":null)" aria-current="@(_selected==index?"true":null)" tabindex="0" @onclick="()=>SelectInterval(index)" @onkeydown="e=>RowKey(e,index)"><th scope="row">@UiFormat.Time(b.Start,data.TimeZoneId,data.Request.Period==ExportSalesPeriod.Day?"HH:mm zzz":data.Request.Period==ExportSalesPeriod.Year?"MMM yyyy":"d MMM yyyy")</th><td class="numeric">@UiFormat.Number(b.ExportKwh)</td>@if(data.Request.Period==ExportSalesPeriod.Day){<td class="numeric">@UiFormat.Number(hour?.MarketAveragePricePlnPerKwh,"0.0000")</td>}<td class="numeric">@UiFormat.Number(b.EnergyValuePln)</td><td class="numeric">@UiFormat.Number(b.EstimatedDepositPln)</td><td>@(progress?T["In progress"]:b.ExpectedHours==0?b.Start>=Clock.GetUtcNow()?T["Upcoming"]:T["Before contract"]:b.ObservedHours<b.ExpectedHours?T["Partial readings"]:b.ValuedHours<b.ObservedHours?T["Price missing"]:T["Complete"])</td></tr>
@if(progress){<tr class="progress-row"><th>@T["Current hour · in progress"]</th><td>@UiFormat.Number(data.CurrentHour!.ExportKwh)</td>@if(data.Request.Period==ExportSalesPeriod.Day){<td>—</td>}<td>@UiFormat.Number(data.CurrentHour!.EnergyValuePln)</td><td>@UiFormat.Number(data.CurrentHour!.EstimatedDepositPln)</td><td>@T["Excluded from totals"]</td></tr>}}
</tbody><tfoot><tr><th>@T["Total · completed hours"]</th><td>@UiFormat.Number(data.ExportKwh)</td>@if(data.Request.Period==ExportSalesPeriod.Day){<td></td>}<td>@UiFormat.Number(data.EnergyValuePln)</td><td>@UiFormat.Number(data.EstimatedDepositPln)</td><td>@data.ValuedHours / @data.ExpectedHours h</td></tr></tfoot></table></div></UiCard>
<UiCard Title="@T["How settlement works"]"><p>@T["Grid imports and exports are netted for each hour before credited export is calculated. Energy value uses the available RCE prices under the contract terms."]</p><p>@T["These are inverter-based estimates under your saved contract terms. Your supplier settles using the OSD billing meter."]</p><p>@T["Estimated deposit is the energy value multiplied by 1.23. It is not a payout or your current balance."]</p><p>@T["Positive export and negative prices retain their signs. Missing prices never become zero."]</p><p class="caption">@T.Format("Contract starts {0}",data.ContractStartDate.ToString("d MMM yyyy")) · @data.TimeZoneId</p><UiButton Href="/settings#contract">@T["Contract settings"]</UiButton></UiCard>
}
@code{
 [SupplyParameterFromQuery(Name="period")]public string? PeriodQuery{get;set;}[SupplyParameterFromQuery(Name="date")]public string? DateQuery{get;set;}[SupplyParameterFromQuery(Name="from")]public string? FromQuery{get;set;}[SupplyParameterFromQuery(Name="to")]public string? ToQuery{get;set;}
 private ExportSalesRequest _request=new(ExportSalesPeriod.Day,DateOnly.FromDateTime(DateTime.UtcNow));private ExportSalesResult? _data;private string? _error;private bool _loading;private int _selected;private DateTime? _from,_to;private readonly AsyncQueryScope _queries=new();private bool _pinnedInterval;
 private DateOnly Today=>DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(),TimeZoneInfo.FindSystemTimeZoneById(SalesOptions.CurrentValue.TimeZoneId)).DateTime);
 private string Query=>"period="+_request.Period+"&date="+_request.Date.ToString("yyyy-MM-dd")+(_request.Period==ExportSalesPeriod.Custom?"&from="+_request.From?.ToString("yyyy-MM-dd")+"&through="+_request.Through?.ToString("yyyy-MM-dd"):"");private string CsvUrl=>"/api/sales.csv?"+Query;
 private string DateType=>_request.Period==ExportSalesPeriod.Month?"month":_request.Period==ExportSalesPeriod.Year?"number":"date";private string DateInput=>_request.Date.ToString(_request.Period==ExportSalesPeriod.Month?"yyyy-MM":_request.Period==ExportSalesPeriod.Year?"yyyy":"yyyy-MM-dd");private string DateMinimum=>_request.Period==ExportSalesPeriod.Month?"2000-01":_request.Period==ExportSalesPeriod.Year?"2000":"2000-01-01";private string DateMaximum=>Today.ToString(_request.Period==ExportSalesPeriod.Month?"yyyy-MM":_request.Period==ExportSalesPeriod.Year?"yyyy":"yyyy-MM-dd");
 protected override async Task OnParametersSetAsync(){if(!EnergyDetailsNavigation.TrySalesRequest(PeriodQuery??"day",DateQuery,FromQuery,ToQuery,Today,out var request)){_error=T["Choose a valid period of at most 366 days."];_data=null;return;} _request=request;_from=request.From?.ToDateTime(TimeOnly.MinValue);_to=request.Through?.ToDateTime(TimeOnly.MinValue);await Load(request);}
 protected override void OnInitialized()=>_queries.StartRefresh(Clock,TimeSpan.FromMinutes(5),()=>InvokeAsync(()=>_queries.IsLoading?Task.CompletedTask:Load(DateQuery is null&&_request.Period==ExportSalesPeriod.Day?_request with{Date=Today}:_request)));
 private Task Load(ExportSalesRequest request)=>_queries.RunAsync(ct=>Sales.ReadDetailsAsync(request,ct),started:()=>{_loading=true;_error=null;StateHasChanged();},received:data=>{var changed=_data?.Request!=data.Request;_data=data;_request=data.Request;if(changed)_pinnedInterval=false;if(!_pinnedInterval)_selected=LatestInterval(data);else _selected=Math.Clamp(_selected,0,Math.Max(0,data.Buckets.Count-1));},failed:error=>_error=_data is null?error is ArgumentException?error.Message:"Export could not be loaded.":"Refresh failed. Showing previous data; values may be out of date.",finished:()=>{_loading=false;StateHasChanged();});
 private Task RecheckPrices()=>_queries.RunAsync(ct=>Sales.RecheckPricesAsync(_request,ct),started:()=>{_loading=true;_error=null;StateHasChanged();},received:value=>_data=value,failed:_=>_error="Prices could not be checked. The saved estimates are retained.",finished:()=>{_loading=false;StateHasChanged();});
 private static int LatestInterval(ExportSalesResult data){var current=data.CurrentHour;var index=current is null?-1:data.Buckets.ToList().FindIndex(b=>current.Start>=b.Start&&current.Start<b.End);return index>=0?index:Math.Max(0,data.Buckets.ToList().FindLastIndex(b=>b.ExportKwh.HasValue));}
 private void SelectInterval(int index){_selected=index;_pinnedInterval=true;}
 private void Navigate(ExportSalesRequest r)=>Nav.NavigateTo("/energy/export?period="+r.Period.ToString().ToLowerInvariant()+"&date="+r.Date.ToString("yyyy-MM-dd")+(r.Period==ExportSalesPeriod.Custom?"&from="+r.From?.ToString("yyyy-MM-dd")+"&to="+r.Through?.ToString("yyyy-MM-dd"):""));
 private void Period(ExportSalesPeriod p)=>Navigate(new(p,_request.Date,p==ExportSalesPeriod.Custom?_request.Date:null,p==ExportSalesPeriod.Custom?_request.Date:null));
 private DateOnly Adjacent(int delta)=>_request.Period==ExportSalesPeriod.Month?_request.Date.AddMonths(delta):_request.Period==ExportSalesPeriod.Year?_request.Date.AddYears(delta):_request.Date.AddDays(delta);
 private bool CanMove(int d){try{var next=Adjacent(d);return next.Year>=2000&&next<=Today;}catch(ArgumentOutOfRangeException){return false;}}
 private void Move(int d){if(CanMove(d))Navigate(_request with{Date=Adjacent(d)});}
 private void DateChanged(ChangeEventArgs e){var text=e.Value?.ToString();var format=_request.Period==ExportSalesPeriod.Month?"yyyy-MM-dd":"yyyy-MM-dd";if(_request.Period==ExportSalesPeriod.Month)text+="-01";if(_request.Period==ExportSalesPeriod.Year)text+="-01-01";if(DateOnly.TryParseExact(text,format,out var date))Navigate(_request with{Date=date});}
 private void Apply(){if(_from is null||_to is null||_to<_from||(_to.Value-_from.Value).TotalDays>=366||DateOnly.FromDateTime(_to.Value)>Today){_error=T["Choose a valid period of at most 366 days."];return;}Navigate(new(ExportSalesPeriod.Custom,DateOnly.FromDateTime(_from.Value),DateOnly.FromDateTime(_from.Value),DateOnly.FromDateTime(_to.Value)));}
 private void RowKey(KeyboardEventArgs e,int i){if(e.Key is "Enter" or " ")SelectInterval(i);}
 public ValueTask DisposeAsync()=>_queries.DisposeAsync();
}
