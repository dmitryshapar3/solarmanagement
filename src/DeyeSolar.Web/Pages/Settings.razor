@page "/settings"
@using DeyeSolar.Web.Api
@using DeyeSolar.Web.Services
@using DeyeSolar.Web.Integrations
@inject IIntegrationTestService IntegrationTests
@inject DeyeSolar.Web.Data.AppSettingsService SettingsService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Settings - DeyeSolar</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>
<IntegrationSettings />
<MudGrid>
    <MudItem xs="12"><SiteSettingsEditor /></MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2">Weather (Open-Meteo)</MudText>
            <MudText Typo="Typo.body2">Verify weather access for the server's configured solar location. Customer API keys are configured on the server.</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => TestConnection("openmeteo"))" Disabled="@(_testing is not null)" Class="mt-3">Test connection</MudButton>
            @if (_testResults.TryGetValue("openmeteo", out var weatherTest)) { <MudAlert Severity="@(weatherTest.Success ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-2">@weatherTest.Message</MudAlert> }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2">Electricity prices (PSE)</MudText>
            <MudText Typo="Typo.body2">Verify access to the public PSE electricity price feed. No account or key is required.</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => TestConnection("pse"))" Disabled="@(_testing is not null)" Class="mt-3">Test connection</MudButton>
            @if (_testResults.TryGetValue("pse", out var priceTest)) { <MudAlert Severity="@(priceTest.Success ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-2">@priceTest.Message</MudAlert> }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Polling</MudText>
            <MudNumericField @bind-Value="_polling.IntervalSeconds" Label="Interval (seconds)" Min="5" Max="300" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePolling" Class="mt-3">Save</MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Display</MudText>
            <MudAutocomplete T="string" @bind-Value="_display.TimeZoneId" Label="Timezone"
                             SearchFunc="SearchTimezones" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDisplay" Class="mt-3">Save</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@code {
    private DeyeSolar.Domain.Options.PollingOptions _polling = new();
    private DeyeSolar.Domain.Options.DisplayOptions _display = new();
    private string? _errorMessage;
    private string? _testing;
    private readonly Dictionary<string, IntegrationTestResult> _testResults = new();
    private static readonly string[] _allTimeZones = TimeZoneInfo.GetSystemTimeZones().Select(tz => tz.Id).ToArray();

    protected override async Task OnInitializedAsync()
    {
        _polling = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.PollingOptions>("Polling");
        _display = await SettingsService.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _display.TimeZoneId == "UTC")
        {
            try
            {
                var timezone = await JS.InvokeAsync<string>("eval", "Intl.DateTimeFormat().resolvedOptions().timeZone");
                if (!string.IsNullOrEmpty(timezone)) { _display.TimeZoneId = timezone; await SaveDisplay(); StateHasChanged(); }
            }
            catch { }
        }
    }

    private async Task TestConnection(string kind)
    {
        if (_testing is not null) return;
        _testing = kind;
        _testResults.Remove(kind);
        try { _testResults[kind] = await IntegrationTests.TestAsync(kind, new IntegrationTestRequest(), CancellationToken.None); }
        catch (Exception) { _testResults[kind] = new(kind, false, "unavailable", "The provider could not be verified. Please try again.", DateTimeOffset.UtcNow); }
        finally { _testing = null; }
    }

    private async Task SavePolling()
    {
        await SettingsService.SaveSectionAsync("Polling", _polling);
        Snackbar.Add("Polling settings saved", Severity.Success);
    }

    private async Task SaveDisplay()
    {
        await SettingsService.SaveSectionAsync("Display", _display);
        Snackbar.Add("Display settings saved", Severity.Success);
    }

    private Task<IEnumerable<string>> SearchTimezones(string value, CancellationToken ct)
        => Task.FromResult(_allTimeZones.Where(tz => string.IsNullOrWhiteSpace(value) || tz.Contains(value, StringComparison.OrdinalIgnoreCase)).AsEnumerable());
}