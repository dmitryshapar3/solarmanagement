@page "/signin"
@model DeyeSolar.Web.Pages.SignInModel
@inject DeyeSolar.Web.Localization.UiText T
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout=null; }
<!doctype html><html lang="@T.Language" data-theme="@DeyeSolar.Web.Components.Ui.WebAppearance.CookieTheme(HttpContext)"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@T["Sign in"] · SmartSolar</title><link rel="icon" href="/images/smartsolar-mark.svg" type="image/svg+xml" /><link rel="stylesheet" href="/css/fonts.css" /><link rel="stylesheet" href="/css/tokens.css" /><link rel="stylesheet" href="/css/smartsolar.css" /></head><body>
<main class="auth-shell"><section class="auth-brand"><a class="brand-lockup" href="/"><img src="/images/smartsolar-mark.svg" width="36" height="36" alt="" /><span>SmartSolar</span></a><div><h1>@T["See what the sun does for your home"]</h1><div class="form-stack" style="margin-top:28px"><p>☀ @T["Live production against the weather forecast"]</p><p>↗ @T["Smart plugs that use your surplus automatically"]</p><p>▥ @T["Export value under net-billing, hour by hour"]</p></div></div><div class="marketing-preview ui-card" style="margin-top:auto;background:rgba(255,255,255,.42);color:var(--on-sun)"><div class="hero-header"><h2>@T["Solar now"]</h2><span class="status-pill">@T["Sample"]</span></div><div class="hero-number">4.20<span class="unit">kW</span></div><svg class="chart" viewBox="0 0 400 120" role="img" aria-label="@T["Sample solar production chart"]"><path d="M0 112C60 112 76 105 100 75S160 10 220 15S300 58 340 95L400 112L400 118H0Z" fill="rgba(18,18,15,.12)" /><path d="M0 112C60 112 76 105 100 80S160 25 220 28S260 48 290 68" fill="none" stroke="var(--on-sun)" stroke-width="2.5" /></svg><small style="color:var(--on-sun)">@T["Sample data · a sunny October day in Kraków"]</small></div></section>
<section class="auth-main"><div class="auth-panel"><header><h1>@(Model.VerificationId.Length>0 && Model.Mode!="password"?T["Check your messages"]:T["Sign in"])</h1><p style="margin-top:8px">@T["Use the same account as the SmartSolar app."]</p></header>
@if(Model.ErrorMessage is not null) { <div class="auth-error" role="alert">@T.Translate(Model.ErrorMessage)</div> }
@if(Model.VerificationId.Length==0&&(Model.Providers.GoogleEnabled||Model.Providers.Apple.WebAvailable)) {<div class="auth-providers">@if(Model.Providers.GoogleEnabled){<a href="/auth/google" class="auth-provider"><partial name="_AuthProviderIcon" model='@("google")'/>@T["Continue with Google"]</a>}@if(Model.Providers.Apple.WebAvailable){<a href="/auth/apple" class="auth-provider"><partial name="_AuthProviderIcon" model='@("apple")'/>@T["Continue with Apple"]</a>}</div><div class="auth-divider">@T["or"]</div>}
@if(Model.Mode=="password") {
<form method="post" asp-page-handler="Password" class="auth-form"><input type="hidden" asp-for="Mode" /><input type="hidden" asp-for="ReturnUrl" /><div class="ui-field"><label for="username">@T["Username, email or phone"]</label><input id="username" name="Username" value="@Model.Username" autocomplete="username" required maxlength="256" /></div><div class="ui-field"><label for="password">@T["Password"]</label><input id="password" name="Password" type="password" autocomplete="current-password" required maxlength="128" /></div><button type="submit" class="ui-button primary large">@T["Sign in"]</button></form>
@if(Model.CodeAvailable) { <a class="text-link" href="/signin?mode=code&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl??"/")">@T["Sign in with a code instead"]</a> }
} else if(!string.IsNullOrEmpty(Model.VerificationId)) {
<p>@T.Format("Enter the 6-digit code sent to {0}.",Model.Destination)</p><form method="post" asp-page-handler="Complete" class="auth-form"><input type="hidden" asp-for="VerificationId" /><input type="hidden" asp-for="ExpiresAt" /><input type="hidden" asp-for="Destination" /><input type="hidden" asp-for="ReturnUrl" /><input type="hidden" asp-for="Mode" /><div class="ui-field"><label for="code">@T["Verification code"]</label><input id="code" name="Code" class="auth-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus /></div><button type="submit" class="ui-button primary large">@T["Continue"]</button></form>
@if(Model.ExpiresAt is {} expires) { <p class="auth-footnote">@T["Code expires"] <time datetime="@expires.ToString("O")">@expires.ToLocalTime().ToString("HH:mm")</time></p> }
<form method="post" asp-page-handler="Start"><input type="hidden" asp-for="Destination" /><input type="hidden" asp-for="ReturnUrl" /><button type="submit" class="ui-button outline" data-resend-seconds="@Math.Clamp(Model.RetryAfterSeconds,0,300)" data-resend-label="@T.Format("Send a new code in {0}s","{0}")">@T["Send a new code"]</button></form><a class="text-link" href="/signin">@T["Change email or phone"]</a>
} else {
<form method="post" asp-page-handler="Start" class="auth-form"><input type="hidden" asp-for="ReturnUrl" /><div class="ui-field"><label for="destination">@T["Email or phone number"]</label><input id="destination" name="Destination" value="@Model.Destination" autocomplete="username" required maxlength="256" /></div><button type="submit" class="ui-button primary large">@T["Continue"]</button></form><p class="auth-footnote">@(Model.Providers.RegistrationEnabled?T["We’ll send you a 6-digit code. New to SmartSolar? Continuing creates your account with a free month of Premium."]:T["We’ll send you a 6-digit code to sign in to your existing account."])</p><a class="text-link" href="/signin?mode=password&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl??"/")">@T["Sign in with a password instead"]</a>
}
<footer class="auth-footer"><div><a href="/privacy" class="text-link">@T["Privacy policy"]</a> · <a href="/support" class="text-link">@T["Support"]</a></div><form method="post" asp-page-handler="Language"><input type="hidden" asp-for="Mode" /><input type="hidden" asp-for="VerificationId" /><input type="hidden" asp-for="Destination" /><input type="hidden" asp-for="ExpiresAt" /><input type="hidden" asp-for="ReturnUrl" /><select name="Language" aria-label="@T["Language"]" onchange="this.form.requestSubmit()">@foreach(var language in T.Languages) { <option value="@language.Code" selected="@(language.Code==T.Language)">@language.Name</option> }</select><noscript><button class="ui-button" type="submit">@T["Save language"]</button></noscript></form></footer></div></section></main><script src="/js/smartsolar.js"></script></body></html>
