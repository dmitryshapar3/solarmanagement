@page "/devices"
@page "/devices/{Id}"
@using DeyeSolar.Web.Api
@using DeyeSolar.Web.Services
@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Integrations
@using DeyeSolar.Web.Auth
@inject DeviceStatusSnapshot DeviceSnapshot
@inject DeyeSolar.Domain.Interfaces.ISocketInventoryService Inventory
@inject DeyeSolar.Web.Data.IAppSettingsReader SettingsReader
@inject DeviceNameService DeviceNames
@inject RedesignQueries Queries
@inject IntegrationSetupService Setup
@inject AuthenticationStateProvider Authentication
@inject InteractiveSecurityContext Security
@inject IJSRuntime JS
@inject TimeProvider Clock
@implements IAsyncDisposable
<PageTitle>@T["Devices"] · SmartSolar</PageTitle><PageHeader Title="@T["Devices"]" Subtitle="@T["Your smart plugs, their state and automations."]"><UiButton Href="/settings/connections" Icon="plus" Variant="primary">@T["Add a smart plug"]</UiButton></PageHeader>
@if(_error is not null){<div class="banner critical" role="alert">@T.Translate(_error)</div>}@if(_notice is not null){<div class="banner" role="status">@_notice</div>}@if(_loading&&_devices is null){<UiState Kind="loading" Title="@T["Loading…"]"/>}
<div class="devices-grid"><div class="selection-list">
@foreach(var device in _devices??[]){
 var facts=_listFacts.GetValueOrDefault(device.Id);var controlling=facts?.Details?.ControllingRules??[];var since=DevicePresentation.CurrentObservedStateSince(device,facts?.History);
 <div class="selection-card @(Id==device.Id?"selected":null)" @key="device.Id"><div class="toolbar"><a href="@DeviceUrl(device.Id)"><span class="device-icon @(device.Online&&device.StateKnown&&device.IsOn?"active":null)"><UiIcon Name="devices"/></span><h2>@device.Name</h2></a>
 @if(facts?.Details?.CanSwitch==true){<DeviceControl DeviceId="@device.Id" Name="@device.Name" Online="device.Online" IsOn="device.IsOn" StateKnown="device.StateKnown" OnAcknowledged="Refresh"/>}else{<UiSwitch Value="@(device.StateKnown&&device.IsOn)" Label="@T.Format("Switch {0}",device.Name)" Disabled="true"/>}</div>
 <div class="device-power">@(!device.Online?T["Offline"]:!device.StateKnown?T["Unknown"]:device.IsOn?T["On"]+" · "+T.Number(device.CurrentPowerW,"0")+" W":T["Off"])</div>
 @if(since is {} observedSince){<p class="device-state-since caption">@T["Device state observed"] · @T["From"] @T.Time(observedSince,_zone,"HH:mm zzz")</p>}
 <div class="device-list-facts"><span class="caption">@(facts?.Details?.ProviderDisplayName??T["Provider unavailable"])</span><StatusPill Kind="@(device.Online?"positive":"neutral")">@(device.Online?T["Online"]:T["Offline"])</StatusPill>
 @if(DevicePresentation.ManuallyPaused(facts?.Details)){<StatusPill Kind="warning">@T["Manual control · rule paused"]</StatusPill>}
 @foreach(var rule in controlling.Where(rule=>rule.Enabled)){<a href="@($"/automations/{rule.Id}")"><StatusPill Kind="info">@T["Controlled by"] · @rule.Name</StatusPill></a>}</div></div>
}
@if(_devices?.Count==0){<UiCard><UiState Title="@T["No smart plugs yet"]" Message="@T["Connect a smart plug service, select your plugs and enable the connection."]"/></UiCard>}<UiButton Href="/settings/connections" Icon="plus" Variant="outline">@T["Add a smart plug"]</UiButton><p class="caption">@T["A provider acknowledgement confirms the command. The displayed state comes from the next device observation."]</p></div>
@if(_detail is {} detail){<UiCard Title="@detail.Name"><div class="toolbar"><StatusPill Kind="@(detail.Device?.Online==true?"positive":"neutral")">@(detail.Device?.Online==true?T["Online"]:T["Unavailable"])</StatusPill>@if(detail.CanSwitch&&detail.Device is {} device){<DeviceControl DeviceId="@detail.Id" Name="@detail.Name" Online="device.Online" IsOn="device.IsOn" StateKnown="device.StateKnown" OnAcknowledged="Refresh"/>}</div><div class="detail-value">@(detail.Device is not {Online:true} ? T["Offline"] : !detail.Device.StateKnown ? T["Unknown"] : detail.Device.IsOn ? T["On"] : T["Off"])</div>@if(DevicePresentation.CurrentObservedStateSince(detail.Device,_history) is {} stateSince){<p class="device-state-since">@(detail.Device?.IsOn==true?T["On"]:T["Off"]) · @T["From"] @T.Time(stateSince,_zone)<small>@T["Device state observed"] · @T["Only recorded evidence contributes to on-duration. Unknown time stays unknown."]</small></p>}<div class="kpi-grid detail-kpis"><div><p class="kpi-label">@T["Power now"]</p><strong class="metric">@T.Number(detail.Device?.Online==true?detail.Device.CurrentPowerW:null,"0") W</strong></div><div><p class="kpi-label">@T["Last confirmed command"]</p><strong>@(detail.LastConfirmedSwitch is {} at?T.Time(at,_zone):T["Unavailable"])</strong></div></div>
@if(_history is {} history){<DeviceTimeline Data="history" TimeZoneId="@_zone"/>}else{<p class="caption">@(_historyError is null?T["History is unavailable for this device."]:T.Translate(_historyError))</p>}
@foreach(var rule in detail.ControllingRules){<a class="automation-strip" href="@($"/automations/{rule.Id}")"><UiIcon Name="automations"/><span><small>@(rule.PauseReason=="manual_override"&&!rule.Enabled?T["Manual control · rule paused"]:rule.Enabled?T["Controlled by"]:T["Paused automation"])</small><strong>@rule.Name</strong><span>@T.Format("On at {0}% · off at {1}%",rule.SocTurnOnThreshold,rule.SocTurnOffThreshold)</span></span><UiIcon Name="chevron"/></a>}
@if(detail.ControllingRules.Any(rule=>rule.Enabled)){<p class="field-hint">@T["These enabled automations can change the device again."] @T.Format("An automation may switch it back within {0} seconds.",detail.ControllingRules.Where(rule=>rule.Enabled).Min(rule=>rule.IntervalSeconds))</p>}@if(DevicePresentation.ManuallyPaused(detail)){<p class="field-hint">@T["Paused since you switched this device by hand"]</p>}
<form class="form-stack detail-settings" @onsubmit="Save" @onsubmit:preventDefault><h3>@T["Settings"]</h3><div class="form-grid"><div class="ui-field"><label for="device-name">@T["Name in SmartSolar"]</label><input id="device-name" @bind="_name" maxlength="80" disabled="@(!Guid.TryParse(detail.Id,out _))"/><p class="field-hint">@T["Cloud name:"] @detail.Device?.CloudName · @T["Rules stay connected."]</p></div>@if(_editableAssociation){<div class="ui-field"><label for="device-source">@T["Battery and solar source"]</label><select id="device-source" value="@_source?.ToString()" @onchange="Source"><option value="">@T["Installation default"]</option>@foreach(var inverter in _sources){<option value="@inverter.Id">@inverter.Name</option>}</select><p class="field-hint">@T["Used by automations that follow this plug’s source."]</p></div><div class="ui-field"><label>@T["Circuit"]</label><div class="segments"><button type="button" class="@(_phase==1?"selected":null)" @onclick="()=>_phase=1">@T["Single-phase"]</button><button type="button" class="@(_phase==3?"selected":null)" @onclick="()=>_phase=3">@T["Three-phase"]</button></div></div>}</div><div class="form-actions"><UiButton Variant="primary" Type="submit" Busy="_saving" Disabled="@(!Dirty)">@T["Save changes"]</UiButton><UiButton Variant="quiet" OnClick="ResetName" Disabled="@(detail.Device?.LocalName is null||_saving)">@T["Restore cloud name"]</UiButton></div></form>
<details class="support-details"><summary>@T["Details for support"]</summary><dl class="metadata"><div><dt>@T["Provider"]</dt><dd>@(detail.ProviderDisplayName??detail.ProviderId??T["Unavailable"])</dd></div>@if(detail.Model is {} model){<div><dt>@T["Model"]</dt><dd>@model</dd></div>}<div><dt>@T["Device ID"]</dt><dd class="copy-id">@detail.Id<button class="icon-button" aria-label="@T["Copy device ID"]" @onclick="Copy"><UiIcon Name="copy"/></button></dd></div>@if(detail.AddedAt is {} added){<div><dt>@T["Added"]</dt><dd>@T.Time(added,_zone,"d MMM yyyy")</dd></div>}</dl></details></UiCard>}
else{<UiCard><UiState Title="@(Id is null?T["Choose a smart plug"]:T["Device not found"])"><UiButton Href="/settings/connections">@T["Connections"]</UiButton></UiState></UiCard>}
</div>
<UnsavedChangesGuard Dirty="@(Dirty&&!_saving)"/>
@code{
 [CascadingParameter(Name="DisplayTimeZone")]public string? PersonalTimeZone{get;set;}
 private string _zone=>PersonalTimeZone??_installationZone;
 [Parameter]public string? Id{get;set;}private IReadOnlyList<DeviceDto>? _devices;private DeviceDetailsDto? _detail;private DeviceHistoryDto? _history;private IReadOnlyList<IntegrationSourceInverterDto> _sources=[];private IntegrationConfigurationDto? _configuration;private string _installationZone="UTC",_name="";private Guid? _source;private int _phase=1;private IReadOnlyDictionary<string,DeviceFacts> _listFacts=new Dictionary<string,DeviceFacts>(StringComparer.OrdinalIgnoreCase);private bool _loading,_saving,_editableAssociation;private string? _error,_historyError,_notice;private readonly AsyncQueryScope _queries=new();
 private static string DeviceUrl(string id)=>"/devices/"+Uri.EscapeDataString(id);private bool Dirty=>_detail is {} d&&(_name!=d.Name||_editableAssociation&&(_source!=d.SourceInverterId||_phase!=d.PhaseCount));
 protected override async Task OnInitializedAsync(){_installationZone=(await SettingsReader.LoadSectionAsync<DeyeSolar.Domain.Options.DisplayOptions>("Display")).TimeZoneId;DeviceSnapshot.OnDataUpdated+=Updated;_queries.StartRefresh(Clock,TimeSpan.FromMinutes(1),()=>InvokeAsync(()=>Dirty||_saving||_queries.IsLoading?Task.CompletedTask:Refresh()));}
 protected override Task OnParametersSetAsync()=>Refresh();
 private Task Refresh(){var selected=Id;return _queries.RunAsync(async ct=>{
 var devices=await DeviceInventoryView.ReadSnapshotAsync(DeviceSnapshot,Inventory,DeviceNames,true,ct);
 using var limit=new SemaphoreSlim(4);
 var presentations=await Task.WhenAll(devices.Devices.Select(async device=>{await limit.WaitAsync(ct);try{return new KeyValuePair<string,DeviceFacts>(device.Id,await ReadFacts(device.Id,ct));}finally{limit.Release();}}));
 var facts=presentations.GroupBy(pair=>pair.Key,StringComparer.OrdinalIgnoreCase).ToDictionary(group=>group.Key,group=>group.Last().Value,StringComparer.OrdinalIgnoreCase);
 var detail=selected is null?null:facts.TryGetValue(selected,out var selectedFacts)?selectedFacts.Details:await Queries.DeviceAsync(selected,ct);
 DeviceHistoryDto? history=null;IntegrationConfigurationDto? configuration=null;IReadOnlyList<IntegrationSourceInverterDto> sources=[];string? historyError=null,settingsError=null;
 if(detail is not null){
  try{if(facts.TryGetValue(detail.Id,out var savedFacts))history=savedFacts.History;else if(detail.SupportsHistory&&Guid.TryParse(detail.Id,out var device))history=await Queries.DeviceHistoryAsync(device,ct:ct);}catch(Exception)when(!ct.IsCancellationRequested){historyError="Device history could not be loaded.";}
  try{if(detail.InstanceId is {} instance){await Security.EnsureAsync(InstallationPermission.ManageIntegrations,ct);configuration=await Setup.ReadAsync(instance,ct);sources=await Setup.SocketSourceOptionsAsync(ct);}}catch(InstallationAccessException denied)when(denied.Status==403){}catch(Exception)when(!ct.IsCancellationRequested){settingsError="Device settings are temporarily unavailable.";}
 }
 return(devices,detail,history,configuration,sources,historyError,settingsError,facts);
 },started:()=>{_loading=true;_error=null;if(_detail?.Id!=selected){_detail=null;_history=null;}},received:data=>{
 var keepDraft=_detail?.Id==data.detail?.Id&&Dirty&&!_saving;
 _devices=data.devices.Epoch==DeviceSnapshot.Epoch?data.devices.Devices:[];_listFacts=data.devices.Epoch==DeviceSnapshot.Epoch?data.facts:new Dictionary<string,DeviceFacts>(StringComparer.OrdinalIgnoreCase);_detail=data.detail;_history=data.history;_historyError=data.historyError;_configuration=data.configuration;_sources=data.sources;_editableAssociation=data.configuration is not null;_error=data.settingsError;
 if(!keepDraft){_name=_detail?.Name??"";_source=_detail?.SourceInverterId;_phase=_detail?.PhaseCount??1;}
 },failed:_=>_error="Devices could not be loaded.",finished:()=>_loading=false);}
 private sealed record DeviceFacts(DeviceDetailsDto? Details,DeviceHistoryDto? History);
 private async Task<DeviceFacts> ReadFacts(string id,CancellationToken ct){DeviceDetailsDto? detail;try{detail=await Queries.DeviceAsync(id,ct);}catch(Exception)when(!ct.IsCancellationRequested){return new(null,null);}DeviceHistoryDto? history=null;try{if(detail?.SupportsHistory==true&&Guid.TryParse(id,out var device))history=await Queries.DeviceHistoryAsync(device,ct:ct);}catch(Exception)when(!ct.IsCancellationRequested){}return new(detail,history);}
 private void Source(ChangeEventArgs e)=>_source=Guid.TryParse(e.Value?.ToString(),out var id)?id:null;
 private async Task Save(){if(_saving||_detail is not {} detail||!Dirty)return;_saving=true;_error=null;_notice=null;try{if(!DeviceNameService.TryName(_name,out var name)){_error=T["Use a name of up to 80 characters without control characters."];return;}if(_name!=detail.Name)await DeviceNames.RenameAsync(detail.Id,name,_queries.LifetimeToken);if(_editableAssociation&&_configuration is {} config&&detail.InstanceId is {} instance&&Guid.TryParse(detail.Id,out var device)&&(_source!=detail.SourceInverterId||_phase!=detail.PhaseCount)){var actor=(await Authentication.GetAuthenticationStateAsync()).User;var i=config.Instance;await Setup.SetSocketSourceAsync(instance,device,new(new(i.Revision,i.PackageVersion,i.PackageDigest,i.DescriptorDigest),_source,_phase,detail.SourceInverterId,detail.PhaseCount),actor,_queries.LifetimeToken);}_notice=T["Device settings saved."];await Refresh();}catch(Exception error)when(!_queries.IsDisposed){_error=error is IntegrationRequestException or ArgumentException?error.Message:"Device settings could not be saved.";}finally{_saving=false;}}
 private async Task ResetName(){if(_detail is not {} detail||_saving)return;_saving=true;_error=null;try{await DeviceNames.RenameAsync(detail.Id,null,_queries.LifetimeToken);if(_queries.IsDisposed||Id!=detail.Id)return;await Refresh();_notice=T["Cloud name restored."];}catch(Exception)when(!_queries.IsDisposed){_error="Device settings could not be saved.";}finally{_saving=false;}}
 private async Task Copy(){if(_detail is null)return;try{await JS.InvokeVoidAsync("smartSolar.copy",_detail.Id);_notice=T["Device ID copied."];}catch(JSException){_error=T["Copy is unavailable. Select the device ID manually."];}}
 private void Updated()=>_ = InvokeAsync(async()=>{if(_queries.IsDisposed||_saving||Dirty)return;await Refresh();StateHasChanged();});
 public async ValueTask DisposeAsync(){DeviceSnapshot.OnDataUpdated-=Updated;await _queries.DisposeAsync();}
}
