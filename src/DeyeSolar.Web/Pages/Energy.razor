@page "/energy"
@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Services
@inject SolarProductionService Production
@inject NavigationManager Nav
@inject TimeProvider Clock
@inject InverterDataSnapshot InverterSnapshot
@inject Microsoft.Extensions.Options.IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject Microsoft.Extensions.Options.IOptionsMonitor<DeyeSolar.Domain.Options.SolarEstimateOptions> SolarOptions
@implements IAsyncDisposable
<PageTitle>@T["Energy"] · SmartSolar</PageTitle><PageHeader Title="@T["Energy"]" Subtitle="@T["Production against the weather forecast"]"><UiButton Icon="download" Href="@CsvUrl">@T["Download CSV"]</UiButton></PageHeader>
<div class="toolbar"><nav class="segments" aria-label="@T["Energy"]"><NavLink href="/energy" Match="NavLinkMatch.All">@T["Production"]</NavLink><NavLink href="/energy/export">@T["Export"]</NavLink></nav><div class="toolbar-controls"><div class="segments" aria-label="@T["Chart period"]">@foreach(var choice in _periods) { <button class="@(_period==choice.Key?"selected":null)" aria-pressed="@((_period==choice.Key).ToString().ToLowerInvariant())" @onclick="()=>ChangePeriod(choice.Key)">@T[choice.Value]</button> }</div><div class="date-navigation"><button class="icon-button" @onclick="()=>Day(-1)" disabled="@(!CanPrevious)" aria-label="@T["Previous day"]"><UiIcon Name="back" /></button><span data-testid="history-date">@(_data?.Date.ToString("d MMM yyyy")??"—")</span><button class="icon-button" @onclick="()=>Day(1)" disabled="@(!CanNext)" aria-label="@T["Next day"]"><UiIcon Name="chevron" /></button></div></div></div>
@if(_error is not null) { <UiState Kind="error" Title="@T["Production could not be loaded"]" Message="@T.Translate(_error)" /> }
@if(_data is null && _loading) { <UiState Kind="loading" Title="@T["Loading…"]" /> }
@if(_data is {} data) {
@if(data.WeatherError is not null){<div class="banner" role="status">@T.Translate(data.WeatherError)</div>}@if(data.ActualError is not null){<div class="banner" role="status">@T.Translate(data.ActualError)</div>}
<div class="kpi-grid"><div class="kpi"><div class="kpi-label">@T["Produced so far"]</div><div class="kpi-value">@UiFormat.Number(data.ObservedEnergyKwh) <small>kWh</small></div>@if(data.Partial) { <small>@T["Partial coverage"]</small> }</div><div class="kpi"><div class="kpi-label">@(_period==SolarHistoryPeriod.Today&&data.Date==data.Today?T["Expected today"]:T["Expected for the period"])</div><div class="kpi-value">@UiFormat.Number(data.ExpectedEnergyKwh) <small>kWh</small></div><small>@T["Weather estimate"]</small></div><div class="kpi"><div class="kpi-label">@T["Best hour"]</div><div class="kpi-value">@UiFormat.Number(data.BestHour?.ActualKw) <small>kW</small></div><small>@(data.BestHour is {} best?UiFormat.Time(best.Timestamp,data.TimeZoneId,"HH:mm zzz"):T["Unavailable"])</small></div><div class="kpi"><div class="kpi-label">@T["Right now"]</div><div class="kpi-value">@UiFormat.Number(Live.SolarKw) <small>kW</small></div><small>@(Live.SolarAt is {} at?UiFormat.Time(at,data.TimeZoneId,"HH:mm:ss zzz"):T["Waiting for readings"])</small></div></div>
<UiCard><ProductionPlot Data="data" Period="_period" @bind-SelectedIndex="_selected" /><p class="field-hint">@T["Gaps stay gaps. Missing readings are never shown as zero."]</p></UiCard>
<UiCard Title="@(_period==SolarHistoryPeriod.Today?T["Hour by hour"]:T["Day by day"])"><div class="table-box" tabindex="0" aria-label="@T["Production data table"]"><table class="data-table"><caption>@data.TimeZoneId · @T["A dash means unavailable; measured zero remains 0.00."]</caption><thead><tr><th>@(_period==SolarHistoryPeriod.Today?T["Hour"]:T["Day"])</th><th>@(_period==SolarHistoryPeriod.Today?T["Actual average · kW"]:T["Produced · kWh"])</th><th>@T["Expected range"]</th><th>@T["Comparison"]</th><th>@T["Status"]</th></tr></thead><tbody>
@if(_period==SolarHistoryPeriod.Today) { @for(var i=0;i<data.Hours.Count;i++) { var index=i;var hour=data.Hours[i];var progress=data.CurrentHour?.Timestamp==hour.Timestamp;var actual=progress?CurrentMean:hour.ActualKw;<tr class="@(_selected==i?"selected":null)" @onclick="()=>_selected=index" tabindex="0" @onkeydown="e=>SelectRow(e,index)" aria-current="@(_selected==i?"true":null)"><th scope="row"><time datetime="@hour.Timestamp.ToString("O")">@UiFormat.Time(hour.Timestamp,data.TimeZoneId,"HH:mm zzz")</time></th><td class="numeric">@UiFormat.Number(actual)</td><td>@UiFormat.Number(hour.LowerKw)–@UiFormat.Number(hour.UpperKw) kW</td><td><MiniRange Lower="hour.LowerKw" Upper="hour.UpperKw" Actual="actual" Progress="progress" Label="@T["Actual and expected range"]" /></td><td><StatusPill Dot="false" Kind="@(actual.HasValue?"positive":"neutral")">@(progress?T["In progress"]:hour.Timestamp>=Clock.GetUtcNow()?T["Upcoming"]:actual is null?T["Unavailable"]:hour.LowerKw is null||hour.UpperKw is null?T["Expected range unavailable"]:actual<hour.LowerKw?T["Below"]:actual>hour.UpperKw?T["Above"]:T["In range"])</StatusPill></td></tr> } }
else { @for(var i=0;i<data.Days.Count;i++) { var index=i;var day=data.Days[i];<tr class="@(_selected==i?"selected":null)" @onclick="()=>_selected=index" tabindex="0" @onkeydown="e=>SelectRow(e,index)" aria-current="@(_selected==i?"true":null)"><th scope="row">@day.Date.ToString("d MMM yyyy")</th><td class="numeric">@UiFormat.Number(day.ObservedEnergyKwh)</td><td>@UiFormat.Number(day.LowerEnergyKwh)–@UiFormat.Number(day.UpperEnergyKwh) kWh</td><td><MiniRange Lower="day.LowerEnergyKwh" Upper="day.UpperEnergyKwh" Actual="day.ObservedEnergyKwh" Label="@T["Actual and expected range"]" /></td><td>@(day.Partial?T["Partial"]:T["Complete"])</td></tr> } }
</tbody></table></div></UiCard><div class="two-columns"><UiCard Title="@T["Right now"]"><SolarEstimateCard /><p class="field-hint">@T["The latest inverter reading is separate from completed hourly averages."]</p></UiCard><UiCard Title="@T["How the forecast works"]"><p>@T["The estimate uses your panel layout, location and weather. It is an engineering estimate, not a guarantee."]</p><p>@T["Hourly actual power requires sufficient measured coverage. Missing hours remain gaps."]</p><UiButton Href="/settings">@T["Solar site settings"]</UiButton><div class="attribution"><a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">@T["Weather data by Open-Meteo.com, CC BY 4.0"]</a>@if(data.ForecastRetrievedAt is {} fetched) { <p>@T.Format("Forecast updated {0}",UiFormat.Time(fetched,data.TimeZoneId))</p> }</div></UiCard></div>
}
@code {
 [SupplyParameterFromQuery(Name="period")]public string? PeriodQuery{get;set;}
 [SupplyParameterFromQuery(Name="date")]public string? DateQuery{get;set;}
 private SolarHistoryPeriod _period;
 private ProductionViewDto? _data;
 private bool _loading;private int _selected;private string? _error;
 private readonly AsyncQueryScope _queries=new();
 private readonly Dictionary<SolarHistoryPeriod,string> _periods=new(){[SolarHistoryPeriod.Today]="Day",[SolarHistoryPeriod.Week]="7 days",[SolarHistoryPeriod.Month]="30 days"};
 private string CsvUrl=>"/api/solar/production.csv?period="+_period+(DateQuery is null?"":"&date="+Uri.EscapeDataString(DateQuery));
 private bool CanPrevious=>_data is {} d&&d.Date>d.Today.AddDays(-29);private bool CanNext=>_data is {} d&&d.Date<d.Today;
 private LiveReading Live=>LiveReading.Read(InverterSnapshot.Current,Clock.GetUtcNow(),InverterOptions.CurrentValue.DeviceKey,SolarOptions.CurrentValue.NowcastActualMaximumAgeMinutes);
 private double? CurrentMean=>_data?.CurrentHour is {CoveredSeconds:>0,ObservedEnergyKwh:{} energy} hour?energy*3600/hour.CoveredSeconds:null;
 protected override Task OnParametersSetAsync(){_period=PeriodQuery switch{null or "day"=>SolarHistoryPeriod.Today,"7d"=>SolarHistoryPeriod.Week,"30d"=>SolarHistoryPeriod.Month,_=>(SolarHistoryPeriod)(-1)};DateOnly? date=null;if((int)_period<0||DateQuery is not null&&!DateOnly.TryParseExact(DateQuery,"yyyy-MM-dd",out _)){_error=T["Choose a valid period and date."];_data=null;return Task.CompletedTask;}if(DateQuery is not null)date=DateOnly.ParseExact(DateQuery,"yyyy-MM-dd");return Load(date);}
 private Task Load(DateOnly? date)=>_queries.RunAsync(ct=>Production.ReadAsync(_period,date,ct),started:()=>{_loading=true;_error=null;},received:value=>{_data=value;_selected=_period==SolarHistoryPeriod.Today?InitialHour(value):value.Days.Count-1;},failed:error=>_error=error is ArgumentException?T["Choose a date within the last 30 days."]:T["Production could not be loaded."],finished:()=>_loading=false);
 private static int InitialHour(ProductionViewDto value){var at=value.Date==value.Today?value.CurrentHour?.Timestamp:value.BestHour?.Timestamp;var hours=value.Hours.ToList();var preferred=at is {} timestamp?hours.FindIndex(h=>h.Timestamp==timestamp):-1;return preferred>=0?preferred:Math.Max(0,hours.FindLastIndex(h=>h.ActualKw.HasValue&&TimeZoneInfo.ConvertTime(h.Timestamp,TimeZoneInfo.FindSystemTimeZoneById(value.TimeZoneId)).Hour is >=5 and <=20));}
 private void ChangePeriod(SolarHistoryPeriod period)=>Nav.NavigateTo("/energy?period="+(period==SolarHistoryPeriod.Today?"day":period==SolarHistoryPeriod.Week?"7d":"30d")+(DateQuery is null?"":"&date="+DateQuery));
 private void Day(int delta){if(_data is null||delta<0&&!CanPrevious||delta>0&&!CanNext)return;Nav.NavigateTo("/energy?period="+(_period==SolarHistoryPeriod.Today?"day":_period==SolarHistoryPeriod.Week?"7d":"30d")+"&date="+_data.Date.AddDays(delta).ToString("yyyy-MM-dd"));}
 private void SelectRow(KeyboardEventArgs e,int index){if(e.Key is "Enter" or " ")_selected=index;}
 public ValueTask DisposeAsync()=>_queries.DisposeAsync();
}
