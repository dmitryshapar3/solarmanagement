@page "/energy"
@using DeyeSolar.Web.Redesign
@using DeyeSolar.Web.Services
@inject SolarProductionService Production
@inject NavigationManager Nav
@inject TimeProvider Clock
@inject InverterDataSnapshot InverterSnapshot
@inject Microsoft.Extensions.Options.IOptionsMonitor<SolarManagement.Inverters.Contracts.InverterConnectionOptions> InverterOptions
@inject Microsoft.Extensions.Options.IOptionsMonitor<DeyeSolar.Domain.Options.SolarEstimateOptions> SolarOptions
@implements IAsyncDisposable
<PageTitle>@T["Energy"] · SmartSolar</PageTitle><PageHeader Title="@T["Energy"]" Subtitle="@T["Production against the weather forecast"]"><UiButton Icon="download" Href="@CsvUrl">@T["Download CSV"]</UiButton></PageHeader>
<div class="toolbar"><nav class="segments" aria-label="@T["Energy"]"><NavLink href="@_window.Url("/energy")" Match="NavLinkMatch.All">@T["Production"]</NavLink><NavLink href="@_window.Url("/energy/export")">@T["Export"]</NavLink></nav></div>
<EnergyPeriodFilters Selection="_window" Today="Today" SelectionChanged="ChangeWindow" />
@if(_error is not null) { <UiState Kind="error" Title="@T["Production could not be loaded"]" Message="@T.Translate(_error)" /> }
@if(_loading && _data is not null) { <p role="status">@T["Refreshing…"]</p> }
@if(_data is null && _loading) { <UiState Kind="loading" Title="@T["Loading…"]" /> }
@if(_data is {} data) {
@if(data.WeatherError is not null){<div class="banner" role="status">@T.Translate(data.WeatherError)</div>}@if(data.ActualError is not null){<div class="banner" role="status">@T.Translate(data.ActualError)</div>}
@if(data.ForecastIncomplete) { <div class="banner" role="status" data-testid="forecast-coverage"><div>@(data.ForecastAvailableFrom is null ? T["Forecast unavailable"] : T["Weather data is available only for part of this period. Dates without a forecast remain unavailable."]) @if(data.ForecastAvailableFrom is {} availableFrom && data.ForecastAvailableThrough is {} availableThrough) { <span>@T.Format("Available forecast: {0} – {1}.", availableFrom.ToString("d MMM yyyy", T.Culture), availableThrough.ToString("d MMM yyyy", T.Culture))</span> }</div></div> }
<div class="kpi-grid"><div class="kpi"><div class="kpi-label">@T["Produced so far"]</div><div class="kpi-value">@T.Number(data.ObservedEnergyKwh) <small>kWh</small></div>@if(data.Partial) { <small>@T["Partial coverage"]</small> }</div><div class="kpi"><div class="kpi-label">@(_period==SolarHistoryPeriod.Today&&data.Date==data.Today?T["Expected today"]:T["Expected for the period"])</div><div class="kpi-value">@T.Number(data.ExpectedEnergyKwh ?? data.AvailableExpectedEnergyKwh) <small>kWh</small></div><small>@(data.ForecastIncomplete ? T["Total for available forecast days"] : T["Weather estimate"])</small></div><div class="kpi"><div class="kpi-label">@(ForecastOnly?T["Expected best hour"]:T["Best hour"])</div><div class="kpi-value">@T.Number(ForecastOnly?BestForecastHour?.ExpectedKw:data.BestHour?.ActualKw) <small>kW</small></div><small>@((ForecastOnly?BestForecastHour:data.BestHour) is {} best?T.Time(best.Timestamp,data.TimeZoneId,_period==SolarHistoryPeriod.Today?"HH:mm zzz":"d MMM HH:mm zzz"):T["Unavailable"])</small></div><div class="kpi"><div class="kpi-label">@T["Right now"]</div><div class="kpi-value">@T.Number(Live.SolarKw) <small>kW</small></div><small>@(Live.SolarAt is {} at?T.Time(at,data.TimeZoneId,"HH:mm:ss zzz"):T["Waiting for readings"])</small></div></div>
<UiCard><ProductionPlot Data="data" Period="_period" @bind-SelectedIndex="_selected" /><p class="field-hint">@T["Gaps stay gaps. Missing readings are never shown as zero."]</p></UiCard>
<UiCard Title="@(_period==SolarHistoryPeriod.Today?T["Hour by hour"]:T["Day by day"])"><div class="table-box" tabindex="0" aria-label="@T["Production data table"]"><table class="data-table"><caption>@data.TimeZoneId · @T["A dash means unavailable; measured zero remains 0.00."]</caption><thead><tr><th>@(_period==SolarHistoryPeriod.Today?T["Hour"]:T["Day"])</th><th>@(_period==SolarHistoryPeriod.Today?T["Actual average · kW"]:T["Produced · kWh"])</th><th>@T["Expected"]</th><th>@T["Expected range"]</th><th>@T["Comparison"]</th><th>@T["Status"]</th></tr></thead><tbody>
@if(_period==SolarHistoryPeriod.Today) { @for(var i=0;i<data.Hours.Count;i++) { var index=i;var hour=data.Hours[i];var progress=data.CurrentHour?.Timestamp==hour.Timestamp;var actual=progress?CurrentMean:hour.ActualKw;<tr class="@(_selected==i?"selected":null)" @onclick="()=>_selected=index" tabindex="0" @onkeydown="e=>SelectRow(e,index)" aria-current="@(_selected==i?"true":null)"><th scope="row"><time datetime="@hour.Timestamp.ToString("O")">@T.Time(hour.Timestamp,data.TimeZoneId,"HH:mm zzz")</time></th><td class="numeric">@T.Number(actual)</td><td class="numeric">@T.Number(hour.ExpectedKw) kW</td><td>@T.Number(hour.LowerKw)–@T.Number(hour.UpperKw) kW</td><td><MiniRange Lower="hour.LowerKw" Upper="hour.UpperKw" Actual="actual" Progress="progress" Label="@T["Actual and expected range"]" /></td><td><StatusPill Dot="false" Kind="@(actual.HasValue?"positive":"neutral")">@(progress?T["In progress"]:hour.Timestamp>=Clock.GetUtcNow()?(hour.ExpectedKw.HasValue?T["Forecast"]:T["Forecast unavailable"]):actual is null?T["Unavailable"]:hour.LowerKw is null||hour.UpperKw is null?T["Expected range unavailable"]:actual<hour.LowerKw?T["Below"]:actual>hour.UpperKw?T["Above"]:T["In range"])</StatusPill></td></tr> } }
else { @for(var i=0;i<data.Days.Count;i++) { var index=i;var day=data.Days[i];<tr class="@(_selected==i?"selected":null)" @onclick="()=>_selected=index" tabindex="0" @onkeydown="e=>SelectRow(e,index)" aria-current="@(_selected==i?"true":null)"><th scope="row">@day.Date.ToString("d MMM yyyy",T.Culture)</th><td class="numeric">@T.Number(day.ObservedEnergyKwh)</td><td class="numeric">@T.Number(day.ExpectedEnergyKwh) kWh</td><td>@T.Number(day.LowerEnergyKwh)–@T.Number(day.UpperEnergyKwh) kWh</td><td><MiniRange Lower="day.LowerEnergyKwh" Upper="day.UpperEnergyKwh" Actual="day.ObservedEnergyKwh" Label="@T["Actual and expected range"]" /></td><td>@(day.Date>data.Today?(day.ExpectedEnergyKwh.HasValue?T["Forecast"]:T["Forecast unavailable"]):day.Partial?T["Partial"]:T["Complete"])</td></tr> } }
</tbody></table></div></UiCard><div class="two-columns"><UiCard Title="@T["Right now"]"><SolarEstimateCard /><p class="field-hint">@T["The latest inverter reading is separate from completed hourly averages."]</p></UiCard><UiCard Title="@T["How the forecast works"]"><p>@T["The estimate uses your panel layout, location and weather. It is an engineering estimate, not a guarantee."]</p><p>@T["Hourly actual power requires sufficient measured coverage. Missing hours remain gaps."]</p><p>@T["Weather forecasts cover up to 16 days including today. Later dates remain unavailable."]</p><UiButton Href="/settings">@T["Solar site settings"]</UiButton><div class="attribution"><a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">@T["Weather data by Open-Meteo.com, CC BY 4.0"]</a>@if(data.ForecastRetrievedAt is {} fetched) { <p>@T.Format("Forecast updated {0}",T.Time(fetched,data.TimeZoneId))</p> }</div></UiCard></div>
}
@code {
 [SupplyParameterFromQuery(Name="period")] public string? PeriodQuery {get;set;}
 [SupplyParameterFromQuery(Name="date")] public string? DateQuery {get;set;}
 [SupplyParameterFromQuery(Name="from")] public string? FromQuery {get;set;}
 [SupplyParameterFromQuery(Name="through")] public string? ThroughQuery {get;set;}
 [SupplyParameterFromQuery(Name="to")] public string? ToQuery {get;set;}
 private EnergyPeriodSelection _window = new(EnergyPeriod.Day, DateOnly.FromDateTime(DateTime.UtcNow));
 private SolarHistoryPeriod _period => _window.ProductionPeriod;
 private ProductionViewDto? _data;
 private bool _loading; private int _selected; private string? _error;
 private readonly AsyncQueryScope _queries = new();
 private DateOnly Today => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), TimeZoneInfo.FindSystemTimeZoneById(SolarOptions.CurrentValue.TimeZoneId)).DateTime);
 private string CsvUrl => "/api/solar/production.csv?period=" + _period + "&date=" + EnergyPeriodSelection.Iso(_window.Date)
     + (_window.Period==EnergyPeriod.Custom?"&from="+EnergyPeriodSelection.Iso(_window.FirstDate)+"&through="+EnergyPeriodSelection.Iso(_window.LastDate):"");
 private bool ForecastOnly => _window.LastDate > Today;
 private ProductionHourDto? BestForecastHour => _data?.BestForecastHour;
 private LiveReading Live => LiveReading.Read(InverterSnapshot.Current, Clock.GetUtcNow(), InverterOptions.CurrentValue.DeviceKey, SolarOptions.CurrentValue.NowcastActualMaximumAgeMinutes);
 private double? CurrentMean => _data?.CurrentHour is {CoveredSeconds:>0, ObservedEnergyKwh:{} energy} hour ? energy*3600/hour.CoveredSeconds : null;
 protected override Task OnParametersSetAsync()
 {
     if(!EnergyPeriodSelection.TryParse(PeriodQuery, DateQuery, FromQuery, ThroughQuery ?? ToQuery, Today, out var window))
     { _error = "Choose a valid period of at most 366 days."; _data = null; return Task.CompletedTask; }
     _window = window; return Load();
 }
 private Task Load() => _queries.RunAsync(ct=>Production.ReadAsync(_window.ToProductionRequest(),ct),
     started:()=>{_loading=true;_error=null;_data=null;},
     received:value=>{_data=value;_selected=_period==SolarHistoryPeriod.Today?InitialHour(value):Math.Max(0,value.Days.ToList().FindIndex(d=>d.Date>=value.Today));},
     failed:error=>_error=error is ArgumentException?"Choose a valid period of at most 366 days.":"Production could not be loaded.", finished:()=>_loading=false);
 private static int InitialHour(ProductionViewDto value)
 {
     var at=value.Date==value.Today?value.CurrentHour?.Timestamp:value.Date>value.Today?value.Hours.OrderByDescending(h=>h.ExpectedKw).FirstOrDefault()?.Timestamp:value.BestHour?.Timestamp;
     var hours=value.Hours.ToList(); var preferred=at is {} timestamp?hours.FindIndex(h=>h.Timestamp==timestamp):-1;
     return preferred>=0?preferred:Math.Max(0,hours.FindLastIndex(h=>h.ActualKw.HasValue&&TimeZoneInfo.ConvertTime(h.Timestamp,TimeZoneInfo.FindSystemTimeZoneById(value.TimeZoneId)).Hour is >=5 and <=20));
 }
 private void ChangeWindow(EnergyPeriodSelection window) => Nav.NavigateTo(window.Url("/energy"));
 private void SelectRow(KeyboardEventArgs e,int index) { if(e.Key is "Enter" or " ")_selected=index; }
 public ValueTask DisposeAsync() => _queries.DisposeAsync();
}
