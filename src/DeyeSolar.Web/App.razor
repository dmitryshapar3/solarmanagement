<CascadingAuthenticationState>
    <MudThemeProvider Theme="_theme" IsDarkMode="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
          <ErrorBoundary @key="routeData">
           <ChildContent>
            <InstallationGate>
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @{
                        NavigationManager.NavigateTo("/login", true);
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </InstallationGate>
           </ChildContent>
           <ErrorContent>
            <p role="alert">@T["Action failed."]</p>
            <button @onclick="ReloadApplication">@T["Retry"]</button>
            <a href="/account">@T["Account"]</a>
           </ErrorContent>
          </ErrorBoundary>
        </Found>
        <NotFound>
            <PageTitle>@T["Not found"]</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">@T["Sorry, there's nothing at this address."]</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private void ReloadApplication() => NavigationManager.NavigateTo("/", true);
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976d2",
            Secondary = "#ff9800",
            Success = "#4caf50",
            Warning = "#ff9800",
            Error = "#f44336"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#42a5f5",
            Secondary = "#ffb74d",
            Success = "#66bb6a",
            Surface = "#1e1e2e",
            Background = "#121212",
            AppbarBackground = "#1e1e2e"
        }
    };
}
