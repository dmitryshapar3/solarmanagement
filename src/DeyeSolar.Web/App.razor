<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
          <ErrorBoundary @key="routeData">
           <ChildContent>
            <InstallationGate>
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @{
                        NavigationManager.NavigateTo("/signin", true);
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </InstallationGate>
           </ChildContent>
           <ErrorContent>
            <p role="alert">@T["Action failed."]</p>
            <button @onclick="ReloadApplication">@T["Retry"]</button>
            <a href="/settings/account" target="_top">@T["Account"]</a>
           </ErrorContent>
          </ErrorBoundary>
        </Found>
        <NotFound>
            <PageTitle>@T["Not found"]</PageTitle>
            <header class="public-header"><BrandMark /><a href="/signin" class="ui-button outline" target="_top">@T["Sign in"]</a></header>
            <main class="public-content">
                <UiState Title="@T["Not found"]" Message="@T["Sorry, there's nothing at this address."]"><AuthorizeView><Authorized><UiButton Href="/" Variant="primary" target="_top">@T["Go to Home"]</UiButton></Authorized><NotAuthorized><UiButton Href="/signin" Variant="primary" target="_top">@T["Go to Home"]</UiButton></NotAuthorized></AuthorizeView></UiState>
            </main>
            <footer class="public-footer"><a href="/privacy" target="_top">@T["Privacy policy"]</a><a href="/support" target="_top">@T["Support"]</a></footer>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private void ReloadApplication() => NavigationManager.NavigateTo("/", true);
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

}
